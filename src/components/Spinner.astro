      consEl.className = `mt-2 inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium ${cons.color}`;
      consEl.classList.remove('hidden');

      document.getElementById('card-description').textContent = getAnimalDescription(winner);
      document.getElementById('sc-habitat').textContent = translateVal(winner.habitat, 'habitat');
      document.getElementById('sc-diet').textContent = translateVal(winner.diet, 'diet');
      document.getElementById('sc-lifespan').textContent = translateVal(winner.lifespan, 'lifespan') || winner.lifespan.replace(/\byears?\b/gi, t.years);
      document.getElementById('sc-weight').textContent = winner.weight;
      document.getElementById('sc-speed').textContent = winner.speed;
      document.getElementById('sc-length').textContent = winner.length || '—';
      document.getElementById('sc-region').textContent = translateVal(winner.region, 'region');
      document.getElementById('sc-class-label').textContent = t.taxClass;
      document.getElementById('sc-order-label').textContent = t.taxOrder;
      document.getElementById('sc-family-label').textContent = t.taxFamily;
      document.getElementById('sc-class').textContent = winner.class || '—';
      document.getElementById('sc-order').textContent = winner.order || '—';
      document.getElementById('sc-family').textContent = winner.family || '—';
      document.getElementById('sc-funfact').textContent = getAnimalFunFact(winner);

      setSpinnerSaveState(winner);
