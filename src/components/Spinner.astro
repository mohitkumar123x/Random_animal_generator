        const url = new URL(window.location.href);
        url.searchParams.set('animal', winner.id);
        const shareUrl = url.toString();
        const shareText = `${winner.emoji} ${getAnimalName(winner)} — ${getAnimalDescription(winner).slice(0, 100)}...`;
        const shareTitle = `${winner.emoji} ${getAnimalName(winner)}`;
        document.getElementById('sc-share-popup-title').textContent = t.shareTitle;
        document.getElementById('sc-share-popup-animal-info').innerHTML = `<span class="text-3xl">${winner.emoji}</span><div><p class="text-sm font-bold text-ink dark:text-[#ededed]">${getAnimalName(winner)}</p><p class="text-xs text-muted">${winner.scientificName || ''}</p></div>`;
        let optionsHtml = '';
        const nativeShare = (navigator.share && /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent));
        optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="copy" data-url="${shareUrl}"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-violet-100 text-sm dark:bg-violet-500/20">📋</span><div><p class="font-semibold">${t.copyLink}</p></div></button>`;
        optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="twitter" data-text="${encodeURIComponent(shareText)}" data-url="${encodeURIComponent(shareUrl)}"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-100 text-sm dark:bg-sky-500/20">𝕏</span><div><p class="font-semibold">${t.shareTwitter}</p></div></button>`;
        optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="facebook" data-url="${encodeURIComponent(shareUrl)}"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-sm dark:bg-blue-500/20">f</span><div><p class="font-semibold">${t.shareFacebook}</p></div></button>`;
        optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="whatsapp" data-text="${encodeURIComponent(shareText + ' ' + shareUrl)}"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-green-100 text-sm dark:bg-green-500/20">💬</span><div><p class="font-semibold">${t.shareWhatsApp}</p></div></button>`;
        optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="pinterest" data-url="${encodeURIComponent(shareUrl)}" data-text="${encodeURIComponent(shareText)}"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-red-100 text-sm dark:bg-red-500/20">📌</span><div><p class="font-semibold">${t.sharePinterest}</p></div></button>`;
        optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="email" data-subject="${encodeURIComponent(shareTitle)}" data-body="${encodeURIComponent(shareText + '\n\n' + shareUrl)}"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-sm dark:bg-amber-500/20">✉️</span><div><p class="font-semibold">${t.shareEmail}</p></div></button>`;
        if (nativeShare) {
          optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10 col-span-2" data-action="native" data-title="${encodeURIComponent(shareTitle)}" data-text="${encodeURIComponent(shareText)}" data-url="${encodeURIComponent(shareUrl)}"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-sm dark:bg-gray-500/20">📲</span><div><p class="font-semibold">${t.nativeShare}</p></div></button>`;
        }
        document.getElementById('sc-share-popup-options').innerHTML = optionsHtml;
        document.querySelectorAll('.share-opt').forEach(btn => {
          btn.onclick = () => {
            const action = btn.dataset.action;
            if (action === 'copy') { navigator.clipboard?.writeText(btn.dataset.url); btn.querySelector('p').textContent = '✓ ' + (t.copied || 'Copied!'); setTimeout(() => { btn.querySelector('p').textContent = t.copyLink; }, 2000); return; }
            if (action === 'twitter') window.open(`https://twitter.com/intent/tweet?text=${btn.dataset.text}&url=${btn.dataset.url}`, '_blank', 'width=550,height=450');
            if (action === 'facebook') window.open(`https://www.facebook.com/sharer/sharer.php?u=${btn.dataset.url}`, '_blank', 'width=550,height=450');
            if (action === 'whatsapp') window.open(`https://api.whatsapp.com/send?text=${btn.dataset.text}`, '_blank');
            if (action === 'pinterest') window.open(`https://pinterest.com/pin/create/button/?url=${btn.dataset.url}&description=${btn.dataset.text}`, '_blank', 'width=550,height=450');
            if (action === 'email') window.location.href = `mailto:?subject=${btn.dataset.subject}&body=${btn.dataset.body}`;
            if (action === 'native') navigator.share({ title: decodeURIComponent(btn.dataset.title), text: decodeURIComponent(btn.dataset.text), url: decodeURIComponent(btn.dataset.url) }).catch(() => {});
            overlay.classList.add('hidden');
          };
        });
        overlay.classList.remove('hidden');
      };
      document.getElementById('sc-share-popup-close')?.addEventListener('click', () => { document.getElementById('sc-share-popup-overlay')?.classList.add('hidden'); });
      document.getElementById('sc-share-popup-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) document.getElementById('sc-share-popup-overlay')?.classList.add('hidden'); });

      document.getElementById('sc-btn-copy').onclick = () => {
        const lifespanVal = translateVal(winner.lifespan, 'lifespan') || winner.lifespan.replace(/\byears?\b/gi, t.years);
        const text = `${winner.emoji} ${getAnimalName(winner)}\n${getAnimalDescription(winner)}\n\n${t.funFact}: ${getAnimalFunFact(winner)}\n\n${t.habitat}: ${translateVal(winner.habitat, 'habitat')} | ${t.diet}: ${translateVal(winner.diet, 'diet')} | ${t.lifespan}: ${lifespanVal}`;
        navigator.clipboard?.writeText(text);
        document.getElementById('sc-btn-copy').innerHTML = '<span>✓</span> ' + (t.copied || 'Copied!');
        setTimeout(() => { document.getElementById('sc-btn-copy').innerHTML = '<span>📋</span> ' + t.copy; }, 2000);
      };

      document.getElementById('sc-btn-download').onclick = () => {
        const btn = document.getElementById('sc-btn-download');
        window.__downloadAnimalCard?.(winner, {
          habitat: t.habitat, diet: t.diet, lifespan: t.lifespan, weight: t.weight,
          speed: t.speed, length: t.length, region: t.region, taxonomy: t.taxonomy,
          taxClass: t.taxClass, taxOrder: t.taxOrder, taxFamily: t.taxFamily,
          funFact: t.funFact, download: t.download, saving: t.saving, saved: t.saved, years: t.years,
          conservation: {
            LC:{text:t.consLC},NT:{text:t.consNT},VU:{text:t.consVU},EN:{text:t.consEN},CR:{text:t.consCR},EW:{text:t.consEW},EX:{text:t.consEX},DD:{text:t.consDD},
          },
        }, getAnimalName(winner), translateVal, btn);
      };

      document.getElementById('result-btn-fullscreen')?.addEventListener('click', () => {
        const img = document.getElementById('result-image');
        if (!img || !img.src) return;
        const fsImg = document.getElementById('spinner-fullscreen-img');
        if (fsImg) { fsImg.src = img.src; fsImg.alt = img.alt; }
        document.getElementById('spinner-fullscreen-overlay')?.classList.remove('hidden');
      });
      document.getElementById('card-btn-fullscreen')?.addEventListener('click', () => {
        const img = document.getElementById('card-image');
        if (!img || !img.src) return;
        const fsImg = document.getElementById('spinner-fullscreen-img');
        if (fsImg) { fsImg.src = img.src; fsImg.alt = img.alt; }
        document.getElementById('spinner-fullscreen-overlay')?.classList.remove('hidden');
      });
      document.getElementById('spinner-fullscreen-overlay')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) document.getElementById('spinner-fullscreen-overlay')?.classList.add('hidden');
      });
      document.getElementById('spinner-fullscreen-close')?.addEventListener('click', () => {
        document.getElementById('spinner-fullscreen-overlay')?.classList.add('hidden');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') document.getElementById('spinner-fullscreen-overlay')?.classList.add('hidden');
      });

      card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 5200);
  }

  buildWheel();
  document.getElementById('spin-btn')?.addEventListener('click', spin);
  document.getElementById('spinner-category')?.addEventListener('change', () => {
    currentRotation = 0;
    const wheel = document.getElementById('wheel');
    wheel.style.transition = 'none';
    wheel.style.transform = 'rotate(0deg)';
    document.getElementById('center-emoji').textContent = '🎡';
    document.getElementById('result-emoji').textContent = '❓';
    document.getElementById('result-name').textContent = t.spinToDiscover;
    document.getElementById('result-desc').textContent = '';
    document.getElementById('result-image-wrapper').classList.add('hidden');
    document.getElementById('card-image-wrapper').classList.add('hidden');
    document.getElementById('spinner-card').classList.add('hidden');
    buildWheel();
  });
</script>
