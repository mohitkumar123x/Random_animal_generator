---
import animals from '../data/animals.json';
import animalTranslations from '../i18n/data/animal-translations.json';
import valuesData from '../i18n/data/values.json';
import { getTranslations } from '../utils/i18n';
import { translateValue } from '../utils/valueTranslations';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale as any);
const animalT = (animalTranslations as any)[locale] || {};

const spinT = {
  spinBtn: t.spin_btn,
  spinning: t.spinning,
  spinToDiscover: t.spin_to_discover,
  consLC: t.cons_lc,
  consNT: t.cons_nt,
  consVU: t.cons_vu,
  consEN: t.cons_en,
  consCR: t.cons_cr,
  consEW: t.cons_ew,
  consEX: t.cons_ex,
  consDD: t.cons_dd,
  taxClass: t.tax_class,
  taxOrder: t.tax_order,
  taxFamily: t.tax_family,
  years: t.years,
  save: t.save,
  saved: t.saved,
  copy: t.copy,
  download: t.download,
  share: t.share,
  shareTitle: t.share_title,
  copyLink: t.copy_link,
  shareTwitter: t.share_twitter,
  shareFacebook: t.share_facebook,
  shareWhatsApp: t.share_whatsapp,
  sharePinterest: t.share_pinterest,
  shareEmail: t.share_email,
  nativeShare: t.native_share,
  fullscreen: (t as any).fullscreen || 'Fullscreen',
  photoBy: (t as any).photo_by || 'Photo by {photographer} on Pexels',
  habitat: t.habitat,
  diet: t.diet,
  lifespan: t.lifespan,
  weight: t.weight,
  speed: t.speed,
  length: t.length,
  region: t.region,
  funFact: t.fun_fact,
  taxonomy: t.taxonomy,
  catMammal: t.cat_mammal,
  catBird: t.cat_bird,
  catFish: t.cat_fish,
  catReptile: t.cat_reptile,
  catAmphibian: t.cat_amphibian,
  catInsect: t.cat_insect,
  catMarine: t.cat_marine,
  catFarm: (t as any).cat_farm || 'Farm',
  catFantasy: (t as any).cat_fantasy || 'Fantasy',
  catPrehistoric: (t as any).cat_prehistoric || 'Prehistoric',
  catMythical: (t as any).cat_mythical || 'Mythical',
  catCute: (t as any).cat_cute || 'Cute',
};
---

<main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
  <section class="mb-8 text-center">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-[#ededed]">{t.spinner_title}</h1>
    <p class="mx-auto mt-3 max-w-lg text-sm text-body dark:text-[#a1a1a1]">
      {t.spinner_desc}
    </p>
  </section>

  <div class="rounded-2xl border border-hairline bg-canvas-elevated p-4 sm:p-8 dark:border-[#333] dark:bg-[#1a1a1a]">
    <div class="flex justify-center gap-2 mb-6">
      <select id="spinner-category" class="rounded-lg border border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none dark:border-[#333] dark:bg-[#111] dark:text-[#ededed]">
        <option value="all">{t.all_animals}</option>
        <option value="mammal">{t.cat_mammal}</option>
        <option value="bird">{t.cat_bird}</option>
        <option value="fish">{t.cat_fish}</option>
        <option value="reptile">{t.cat_reptile}</option>
        <option value="amphibian">{t.cat_amphibian}</option>
        <option value="insect">{t.cat_insect}</option>
        <option value="marine">{t.cat_marine}</option>
        <option value="farm">{(t as any).cat_farm || 'Farm'}</option>
        <option value="fantasy">{(t as any).cat_fantasy || 'Fantasy'}</option>
        <option value="prehistoric">{(t as any).cat_prehistoric || 'Prehistoric'}</option>
        <option value="mythical">{(t as any).cat_mythical || 'Mythical'}</option>
        <option value="cute">{(t as any).cat_cute || 'Cute'}</option>
      </select>
    </div>

    <div class="relative mx-auto mb-6" style="width: min(320px, 80vw); height: min(320px, 80vw);">
      <div id="wheel-pointer" class="absolute left-1/2 top-0 z-10 -translate-x-1/2 -translate-y-1">
        <div class="h-0 w-0 border-l-[10px] border-r-[10px] border-t-[18px] border-l-transparent border-r-transparent border-t-link drop-shadow-md"></div>
      </div>
      <div id="wheel-container" class="relative h-full w-full overflow-hidden rounded-full border-4 border-hairline bg-canvas shadow-lg dark:border-[#333] dark:bg-[#111]">
        <div id="wheel" class="absolute inset-0 rounded-full transition-none" style="transform: rotate(0deg);">
        </div>
      </div>
      <div class="pointer-events-none absolute left-1/2 top-1/2 z-10 -translate-x-1/2 -translate-y-1/2 flex h-12 w-12 items-center justify-center rounded-full border-4 border-hairline bg-canvas-elevated shadow-md dark:border-[#444] dark:bg-[#1a1a1a] sm:h-14 sm:w-14">
        <span id="center-emoji" class="text-2xl sm:text-3xl">🎡</span>
      </div>
    </div>

    <div id="result-display" class="mb-6 text-center">
      <div id="result-emoji" class="text-6xl mb-2 emoji-icon sm:text-7xl">❓</div>
      <div id="result-image-wrapper" class="relative mb-2 hidden">
        <div class="result-skeleton image-skeleton mx-auto" style="width:280px;height:180px;"></div>
        <img id="result-image" class="mx-auto rounded-xl object-cover shadow-md hidden" style="width:280px;height:180px;" alt="" />
        <button id="result-btn-fullscreen" class="absolute bottom-2 right-2 flex items-center gap-1.5 rounded-lg bg-black/60 px-2.5 py-1.5 text-[11px] font-medium text-white backdrop-blur-sm transition-all hover:bg-black/80 hover:scale-105" title={spinT.fullscreen}>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
          {spinT.fullscreen}
        </button>
        <p id="result-image-credit" class="absolute bottom-2 left-2 text-[10px] text-white/70 hidden"><a id="result-image-credit-link" href="#" target="_blank" rel="noopener noreferrer" class="hover:text-white/90"></a></p>
      </div>
      <h2 id="result-name" class="text-xl font-bold text-ink sm:text-2xl dark:text-[#ededed]">{t.spin_to_discover}</h2>
      <p id="result-desc" class="text-sm text-muted mt-1"></p>
    </div>

    <div class="flex justify-center">
      <button id="spin-btn" class="inline-flex items-center gap-2 rounded-full bg-ink px-8 py-3 text-sm font-medium text-white transition-all hover:opacity-90 active:scale-95 dark:bg-[#ededed] dark:text-[#0a0a0a]">
        {t.spin_btn}
      </button>
    </div>

    <div id="spinner-card" class="hidden mt-8 overflow-hidden rounded-xl border border-hairline bg-canvas dark:border-[#333] dark:bg-[#111]">
      <div id="card-header" class="bg-gradient-to-br from-link-soft/50 via-violet-soft/30 to-pink-soft/30 p-5 text-center dark:from-[#1a2744] dark:via-[#2a1a3a] dark:to-[#3a1a2a]">
        <div id="card-emoji" class="text-6xl mb-2 emoji-icon sm:text-7xl"></div>
        <div id="card-image-wrapper" class="relative mb-2 hidden">
          <div id="card-image-skeleton" class="image-skeleton mx-auto" style="width:280px;height:180px;"></div>
          <img id="card-image" class="mx-auto rounded-xl object-cover shadow-md hidden" style="width:280px;height:180px;" alt="" />
          <button id="card-btn-fullscreen" class="absolute bottom-2 right-2 flex items-center gap-1.5 rounded-lg bg-black/60 px-2.5 py-1.5 text-[11px] font-medium text-white backdrop-blur-sm transition-all hover:bg-black/80 hover:scale-105" title={spinT.fullscreen}>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
            {spinT.fullscreen}
          </button>
          <p id="card-image-credit" class="absolute bottom-2 left-2 text-[10px] text-white/70 hidden"><a id="card-image-credit-link" href="#" target="_blank" rel="noopener noreferrer" class="hover:text-white/90"></a></p>
        </div>
        <h3 id="card-name" class="text-lg font-bold text-ink dark:text-[#ededed]"></h3>
        <p id="card-scientific" class="text-xs italic text-muted mt-1 hidden"></p>
        <div id="card-conservation" class="mt-2 inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium hidden"></div>
      </div>
      <div class="p-4">
        <p id="card-description" class="text-xs text-body leading-relaxed mb-4 dark:text-[#a1a1a1]"></p>
        <div class="grid grid-cols-2 gap-2 text-xs sm:gap-3">
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas-elevated px-2.5 py-2 dark:border-[#333] dark:bg-[#1a1a1a]">
            <span>🌍</span>
            <div class="min-w-0"><p class="text-[10px] text-faint">{t.habitat}</p><p id="sc-habitat" class="font-medium text-ink dark:text-[#ededed]"></p></div>
          </div>
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas-elevated px-2.5 py-2 dark:border-[#333] dark:bg-[#1a1a1a]">
            <span>🍽️</span>
            <div class="min-w-0"><p class="text-[10px] text-faint">{t.diet}</p><p id="sc-diet" class="font-medium text-ink dark:text-[#ededed]"></p></div>
          </div>
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas-elevated px-2.5 py-2 dark:border-[#333] dark:bg-[#1a1a1a]">
            <span>⏱️</span>
            <div class="min-w-0"><p class="text-[10px] text-faint">{t.lifespan}</p><p id="sc-lifespan" class="font-medium text-ink dark:text-[#ededed]"></p></div>
          </div>
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas-elevated px-2.5 py-2 dark:border-[#333] dark:bg-[#1a1a1a]">
            <span>⚖️</span>
            <div class="min-w-0"><p class="text-[10px] text-faint">{t.weight}</p><p id="sc-weight" class="font-medium text-ink dark:text-[#ededed]"></p></div>
          </div>
        </div>
        <div class="mt-3 grid grid-cols-3 gap-2 text-xs">
          <div class="rounded-lg border border-hairline bg-canvas-elevated p-2 text-center dark:border-[#333] dark:bg-[#1a1a1a]">
            <p class="text-[10px] text-faint mb-0.5">{t.speed}</p>
            <p id="sc-speed" class="font-semibold text-ink dark:text-[#ededed]"></p>
          </div>
          <div class="rounded-lg border border-hairline bg-canvas-elevated p-2 text-center dark:border-[#333] dark:bg-[#1a1a1a]">
            <p class="text-[10px] text-faint mb-0.5">{t.length}</p>
            <p id="sc-length" class="font-semibold text-ink dark:text-[#ededed]"></p>
          </div>
          <div class="rounded-lg border border-hairline bg-canvas-elevated p-2 text-center dark:border-[#333] dark:bg-[#1a1a1a]">
            <p class="text-[10px] text-faint mb-0.5">{t.region}</p>
            <p id="sc-region" class="font-semibold text-ink dark:text-[#ededed]"></p>
          </div>
        </div>
        <div id="sc-taxonomy" class="mt-3 rounded-lg border border-hairline bg-canvas-elevated p-3 dark:border-[#333] dark:bg-[#1a1a1a]">
          <p class="text-[10px] uppercase tracking-wider text-faint mb-1.5">🧬 {t.taxonomy}</p>
          <div class="grid grid-cols-1 gap-1 text-xs sm:grid-cols-3 sm:gap-2">
            <div class="flex items-center gap-1"><span class="text-faint" id="sc-class-label"></span> <span id="sc-class" class="font-medium text-ink dark:text-[#ededed]"></span></div>
            <div class="flex items-center gap-1"><span class="text-faint" id="sc-order-label"></span> <span id="sc-order" class="font-medium text-ink dark:text-[#ededed]"></span></div>
            <div class="flex items-center gap-1"><span class="text-faint" id="sc-family-label"></span> <span id="sc-family" class="font-medium text-ink dark:text-[#ededed]"></span></div>
          </div>
        </div>
        <div class="mt-3 rounded-xl border border-link-soft bg-link-soft/30 p-3 dark:border-[#1e3a5f] dark:bg-[#0f1f33]">
          <p class="text-[10px] uppercase tracking-wider text-link font-medium mb-1 dark:text-link">💡 {t.fun_fact}</p>
          <p id="sc-funfact" class="text-xs text-body leading-relaxed dark:text-[#a1a1a1]"></p>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <button id="sc-btn-save" class="group flex items-center justify-center gap-1.5 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2.5 text-xs font-medium text-rose-600 transition-all hover:bg-rose-100 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-400 dark:hover:bg-rose-500/20">
            <span class="transition-transform group-hover:scale-110">♡</span> {t.save}
          </button>
          <button id="sc-btn-share" class="group flex items-center justify-center gap-1.5 rounded-xl border border-blue-200 bg-blue-50 px-3 py-2.5 text-xs font-medium text-blue-600 transition-all hover:bg-blue-100 dark:border-blue-500/30 dark:bg-blue-500/10 dark:text-blue-400 dark:hover:bg-blue-500/20">
            <span class="transition-transform group-hover:scale-110">🔗</span> {t.share}
          </button>
          <button id="sc-btn-copy" class="group flex items-center justify-center gap-1.5 rounded-xl border border-violet-200 bg-violet-50 px-3 py-2.5 text-xs font-medium text-violet-600 transition-all hover:bg-violet-100 dark:border-violet-500/30 dark:bg-violet-500/10 dark:text-violet-400 dark:hover:bg-violet-500/20">
            <span class="transition-transform group-hover:scale-110">📋</span> {t.copy}
          </button>
          <button id="sc-btn-download" class="group flex items-center justify-center gap-1.5 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-xs font-medium text-emerald-600 transition-all hover:bg-emerald-100 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-400 dark:hover:bg-emerald-500/20">
            <span class="transition-transform group-hover:scale-110">📥</span> {t.download}
          </button>
        </div>
      </div>
    </div>
  </div>
</main>

<div id="sc-share-popup-overlay" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4" style="backdrop-filter:blur(4px);">
  <div class="w-full max-w-sm rounded-2xl border border-hairline bg-canvas-elevated shadow-2xl dark:border-[#333] dark:bg-[#1a1a1a]">
    <div class="flex items-center justify-between border-b border-hairline p-4 dark:border-[#333]">
      <h3 id="sc-share-popup-title" class="text-sm font-bold text-ink dark:text-[#ededed]"></h3>
      <button id="sc-share-popup-close" class="flex h-7 w-7 items-center justify-center rounded-lg text-muted hover:bg-hairline hover:text-ink dark:hover:bg-[#333] dark:hover:text-[#ededed]">✕</button>
    </div>
    <div class="p-4">
      <div id="sc-share-popup-animal-info" class="mb-4 flex items-center gap-3 rounded-xl border border-hairline bg-canvas p-3 dark:border-[#333] dark:bg-[#111]"></div>
      <div id="sc-share-popup-options" class="grid grid-cols-2 gap-2"></div>
    </div>
  </div>
</div>

<div id="spinner-fullscreen-overlay" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4 cursor-zoom-out" style="backdrop-filter:blur(8px);">
  <button id="spinner-fullscreen-close" class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors z-10">
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
  </button>
  <img id="spinner-fullscreen-img" class="max-h-[90vh] max-w-[90vw] rounded-2xl object-contain shadow-2xl" alt="" />
</div>

<style is:global>
  .wheel-segment {
    position: absolute;
    left: 50%;
    top: 0;
    width: 50%;
    height: 50%;
    transform-origin: 0% 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .wheel-segment-inner {
    position: absolute;
    left: -50%;
    bottom: -50%;
    width: 200%;
    height: 200%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center center;
  }
</style>

<script is:inline>
if (!window.__downloadAnimalCard) {
  window.__downloadAnimalCard = function(animal, labels, translatedName, translateFn, btn) {
    btn.innerHTML = '<span>⏳</span> ' + labels.saving;
    const W = 600, H = 1060;
    const canvas = document.createElement('canvas');
    canvas.width = W * 2; canvas.height = H * 2;
    const ctx = canvas.getContext('2d');
    ctx.scale(2, 2);
    ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, W, H);
    const grad = ctx.createLinearGradient(0, 0, W, H);
    grad.addColorStop(0, '#eef2ff'); grad.addColorStop(0.5, '#f3e8ff'); grad.addColorStop(1, '#fce7f3');
    ctx.fillStyle = grad; ctx.beginPath(); ctx.roundRect(0, 0, W, H, 24); ctx.fill();
    let y = 28;
    function wrapT(text, maxW) {
      const words = text.split(' '), lines = []; let line = '';
      for (const w of words) { const test = line ? line + ' ' + w : w; if (ctx.measureText(test).width > maxW) { if (line) lines.push(line); line = w; } else { line = test; } }
      if (line) lines.push(line); return lines;
    }
    const cache = JSON.parse(localStorage.getItem('pexelsImageCache') || '{}');
    const entry = cache[animal.name.toLowerCase().trim()];
    const imgUrl = typeof entry === 'string' ? entry : (entry && entry.url);
    function drawImageOrEmoji(imgEl) {
      if (imgEl) {
        const containerW = W - 56;
        const containerH = 300;
        const imgX = 28, imgY = y;

        ctx.save();
        ctx.beginPath();
        ctx.roundRect(imgX, imgY, containerW, containerH, 16);
        ctx.clip();

        // Ambient matching background frame
        const bgScale = Math.max(containerW / imgEl.width, containerH / imgEl.height);
        const bgW = imgEl.width * bgScale;
        const bgH = imgEl.height * bgScale;
        ctx.drawImage(imgEl, imgX + (containerW - bgW) / 2, imgY + (containerH - bgH) / 2, bgW, bgH);

        ctx.fillStyle = 'rgba(15, 23, 42, 0.78)';
        ctx.fillRect(imgX, imgY, containerW, containerH);

        // Entire uncropped sharp image centered inside
        const scale = Math.min((containerW - 16) / imgEl.width, (containerH - 16) / imgEl.height);
        const drawW = Math.round(imgEl.width * scale);
        const drawH = Math.round(imgEl.height * scale);
        const drawX = Math.round(imgX + (containerW - drawW) / 2);
        const drawY = Math.round(imgY + (containerH - drawH) / 2);

        ctx.save();
        ctx.beginPath();
        ctx.roundRect(drawX, drawY, drawW, drawH, 10);
        ctx.clip();
        ctx.drawImage(imgEl, drawX, drawY, drawW, drawH);
        ctx.restore();

        ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(imgX, imgY, containerW, containerH, 16);
        ctx.stroke();

        ctx.restore();
        y += containerH + 20;
      } else {
        ctx.font = '64px sans-serif'; ctx.textAlign = 'center'; ctx.fillText(animal.emoji, W/2, y+64); y += 84;
      }
      finishCard(animal, labels, translatedName, translateFn, btn, ctx, W, y, wrapT);
    }
    async function resolveAndDraw() {
      let finalUrl = imgUrl;
      if (!finalUrl && typeof fetchAnimalImage === 'function') {
        try {
          const fetched = await fetchAnimalImage(animal.name);
          if (fetched && fetched.url) finalUrl = fetched.url;
        } catch(e) {}
      }
      if (finalUrl) {
        fetch(finalUrl).then(r => r.blob()).then(blob => {
          const objUrl = URL.createObjectURL(blob);
          const el = new Image();
          el.onload = function() { drawImageOrEmoji(el); URL.revokeObjectURL(objUrl); };
          el.onerror = function() { drawImageOrEmoji(null); URL.revokeObjectURL(objUrl); };
          el.src = objUrl;
        }).catch(() => {
          const el = new Image();
          el.crossOrigin = 'anonymous';
          el.onload = function() { drawImageOrEmoji(el); };
          el.onerror = function() { drawImageOrEmoji(null); };
          el.src = finalUrl;
        });
      } else {
        drawImageOrEmoji(null);
      }
    }
    resolveAndDraw();
    function finishCard(a, lb, tn, tf, b, ctx, W, y, wrapT) {
      ctx.textAlign = 'center'; ctx.fillStyle = '#111827'; ctx.font = 'bold 26px system-ui, -apple-system, sans-serif';
      ctx.fillText(tn, W/2, y+28); y += 36;
      if (a.scientificName) { ctx.fillStyle = '#6b7280'; ctx.font = 'italic 13px system-ui, -apple-system, sans-serif'; ctx.fillText(a.scientificName, W/2, y+14); y += 20; }
      const ck = a.conservation || 'LC'; const cb = lb.conservation[ck] || lb.conservation.LC;
      const cm = {LC:'#16a34a',NT:'#65a30d',VU:'#d97706',EN:'#ea580c',CR:'#dc2626',EW:'#7c3aed',EX:'#6b7280',DD:'#9ca3af'};
      const cbg = {LC:'#dcfce7',NT:'#ecfccb',VU:'#fef3c7',EN:'#ffedd5',CR:'#fee2e2',EW:'#ede9fe',EX:'#f3f4f6',DD:'#f3f4f6'};
      ctx.font = 'bold 12px system-ui'; const bw = ctx.measureText(cb.text).width+20;
      ctx.fillStyle = cbg[ck]||'#dcfce7'; ctx.beginPath(); ctx.roundRect((W-bw)/2, y+4, bw, 22, 11); ctx.fill();
      ctx.fillStyle = cm[ck]||'#16a34a'; ctx.textAlign = 'center'; ctx.fillText(cb.text, W/2, y+19); y += 34;
      ctx.textAlign = 'left'; ctx.fillStyle = '#374151'; ctx.font = '13px system-ui';
      wrapT(a.description, W-56).slice(0,4).forEach((l,i) => ctx.fillText(l, 28, y+14+i*18));
      y += Math.min(wrapT(a.description, W-56).length, 4)*18+20;
      const sg = [{icon:'🌍',label:lb.habitat,value:tf(a.habitat,'habitat')},{icon:'🍽️',label:lb.diet,value:tf(a.diet,'diet')},{icon:'⏱️',label:lb.lifespan,value:tf(a.lifespan,'lifespan')||a.lifespan.replace(/\byears?\b/gi, lb.years)},{icon:'⚖️',label:lb.weight,value:a.weight}];
      const cw = (W-56-12)/2;
      sg.forEach((s,i) => { const col=i%2,row=Math.floor(i/2),sx=28+col*(cw+12),sy=y+row*48;
        ctx.fillStyle='#f9fafb'; ctx.beginPath(); ctx.roundRect(sx,sy,cw,42,8); ctx.fill();
        ctx.strokeStyle='#e5e7eb'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(sx,sy,cw,42,8); ctx.stroke();
        ctx.fillStyle='#6b7280'; ctx.font='10px system-ui'; ctx.textAlign='left'; ctx.fillText(s.icon+' '+s.label,sx+10,sy+16);
        ctx.fillStyle='#111827'; ctx.font='bold 12px system-ui'; ctx.fillText(s.value,sx+10,sy+32);
      }); y += 100;
      const es = [{icon:'⚡',label:lb.speed,value:a.speed||'—'},{icon:'📏',label:lb.length,value:a.length||'—'},{icon:'🌐',label:lb.region,value:tf(a.region||'','region')}];
      const ecw = (W-56-16)/3;
      es.forEach((s,i) => { const sx=28+i*(ecw+8),sy=y;
        ctx.fillStyle='#f0fdf4'; ctx.beginPath(); ctx.roundRect(sx,sy,ecw,42,8); ctx.fill();
        ctx.strokeStyle='#bbf7d0'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(sx,sy,ecw,42,8); ctx.stroke();
        ctx.fillStyle='#6b7280'; ctx.font='10px system-ui'; ctx.textAlign='center'; ctx.fillText(s.icon+' '+s.label,sx+ecw/2,sy+16);
        ctx.fillStyle='#111827'; ctx.font='bold 12px system-ui'; ctx.fillText(s.value,sx+ecw/2,sy+32);
      }); y += 56;
      if (a.class||a.order||a.family) {
        ctx.fillStyle='#f9fafb'; ctx.beginPath(); ctx.roundRect(28,y,W-56,64,10); ctx.fill();
        ctx.strokeStyle='#e5e7eb'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(28,y,W-56,64,10); ctx.stroke();
        ctx.fillStyle='#6b7280'; ctx.font='bold 10px system-ui'; ctx.textAlign='left'; ctx.fillText('🧬 '+lb.taxonomy,40,y+18);
        const ti=[{l:lb.taxClass,v:a.class},{l:lb.taxOrder,v:a.order},{l:lb.taxFamily,v:a.family}].filter(x=>x.v);
        const tcw=(W-80)/Math.max(ti.length,1);
        ti.forEach((item,i) => { ctx.fillStyle='#6b7280'; ctx.font='11px system-ui'; ctx.textAlign='left'; ctx.fillText(item.l,40+i*tcw,y+36);
          ctx.fillStyle='#111827'; ctx.font='bold 12px system-ui'; ctx.fillText(item.v||'—',40+i*tcw,y+52); }); y+=76;
      }
      ctx.fillStyle='#eff6ff'; ctx.beginPath(); ctx.roundRect(28,y,W-56,56,10); ctx.fill();
      ctx.strokeStyle='#bfdbfe'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(28,y,W-56,56,10); ctx.stroke();
      ctx.fillStyle='#2563eb'; ctx.font='bold 10px system-ui'; ctx.textAlign='left'; ctx.fillText('💡 '+lb.funFact,40,y+18);
      ctx.fillStyle='#374151'; ctx.font='12px system-ui';
      wrapT(a.funFact,W-80).slice(0,2).forEach((l,i) => ctx.fillText(l,40,y+34+i*16)); y+=72;
      ctx.strokeStyle='#e5e7eb'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(28,y); ctx.lineTo(W-28,y); ctx.stroke(); y+=14;
      ctx.textAlign='center'; ctx.fillStyle='#9ca3af'; ctx.font='11px system-ui'; ctx.fillText('bestrandomanimalgenerator.com',W/2,y+10);
      canvas.toBlob(function(blob) { const url=URL.createObjectURL(blob); const link=document.createElement('a');
        link.href=url; link.download=tn.toLowerCase().replace(/\s+/g,'-')+'.png'; link.click(); URL.revokeObjectURL(url);
        b.innerHTML='<span>✓</span> '+lb.saved; setTimeout(function(){b.innerHTML='<span>📥</span> '+lb.download;},2000);
