      document.getElementById('sc-share-popup-overlay')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) document.getElementById('sc-share-popup-overlay')?.classList.add('hidden'); });

      document.getElementById('sc-btn-copy').onclick = () => {
        const text = `${winner.emoji} ${getAnimalName(winner)}\n${getAnimalDescription(winner)}\n\nFun Fact: ${getAnimalFunFact(winner)}\n\nHabitat: ${translateVal(winner.habitat, 'habitat')} | Diet: ${translateVal(winner.diet, 'diet')} | Lifespan: ${winner.lifespan}`;
        navigator.clipboard?.writeText(text);
        document.getElementById('sc-btn-copy').innerHTML = '<span>✓</span> ' + t.copy;
        setTimeout(() => { document.getElementById('sc-btn-copy').innerHTML = '<span>📋</span> ' + t.copy; }, 2000);
      };

      document.getElementById('sc-btn-download').onclick = () => {
        const btn = document.getElementById('sc-btn-download');
        btn.innerHTML = '<span>⏳</span> ...';
        const svgData = `<svg xmlns="http://www.w3.org/2000/svg" width="600" height="800"><foreignObject width="100%" height="100%"><div xmlns="http://www.w3.org/1999/xhtml" style="font-family:system-ui,-apple-system,sans-serif;background:#fff;padding:32px;width:536px;"><div style="text-align:center;padding:24px 0;border-radius:16px;background:linear-gradient(135deg,#d3e5ff50,#7928ca30,#ff008030);"><div style="font-size:72px;margin-bottom:8px;">${winner.emoji}</div><h2 style="margin:0;font-size:24px;font-weight:700;">${getAnimalName(winner)}</h2><div style="margin-top:8px;display:inline-block;padding:2px 10px;border-radius:999px;font-size:12px;background:#22c55e20;color:#22c55e;">${cons.text}</div></div><p style="font-size:14px;color:#4d4d4d;line-height:1.6;margin:16px 0;">${getAnimalDescription(winner)}</p><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:13px;margin-bottom:12px;"><div style="padding:8px;border:1px solid #ebebeb;border-radius:8px;"><strong>Habitat:</strong> ${translateVal(winner.habitat, 'habitat')}</div><div style="padding:8px;border:1px solid #ebebeb;border-radius:8px;"><strong>Diet:</strong> ${translateVal(winner.diet, 'diet')}</div><div style="padding:8px;border:1px solid #ebebeb;border-radius:8px;"><strong>Lifespan:</strong> ${winner.lifespan}</div><div style="padding:8px;border:1px solid #ebebeb;border-radius:8px;"><strong>Weight:</strong> ${winner.weight}</div></div><div style="padding:10px;border:1px solid #d3e5ff;border-radius:8px;background:#d3e5ff30;font-size:13px;"><strong>Fun Fact:</strong> ${getAnimalFunFact(winner)}</div><p style="font-size:11px;color:#8f8f8f;text-align:center;margin-top:16px;">Random Animal Generator</p></div></foreignObject></svg>`;
        const blob = new Blob([svgData], { type: 'image/svg+xml' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${getAnimalName(winner).toLowerCase().replace(/\s+/g, '-')}.svg`;
        a.click();
        URL.revokeObjectURL(url);
        btn.innerHTML = '<span>✓</span> ' + t.download;
        setTimeout(() => { btn.innerHTML = '<span>📥</span> ' + t.download; }, 2000);
      };

      card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 5200);
  }

  buildWheel();
  document.getElementById('spin-btn')?.addEventListener('click', spin);
  document.getElementById('spinner-category')?.addEventListener('change', () => {
    currentRotation = 0;
    const wheel = document.getElementById('wheel');
    wheel.style.transition = 'none';
    wheel.style.transform = 'rotate(0deg)';
    document.getElementById('center-emoji').textContent = '🎡';
    document.getElementById('result-emoji').textContent = '❓';
    document.getElementById('result-name').textContent = t.spinToDiscover;
    document.getElementById('result-desc').textContent = '';
    document.getElementById('spinner-card').classList.add('hidden');
    buildWheel();
  });
</script>
