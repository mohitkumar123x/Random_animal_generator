        const favs = getFavorites();
        const exists = favs.find(f => f.id === winner.id);
        if (!exists) {
          favs.unshift(winner);
          localStorage.setItem('favorites', JSON.stringify(favs.slice(0, 50)));
        } else {
          localStorage.setItem('favorites', JSON.stringify(favs.filter(f => f.id !== winner.id)));
        }
