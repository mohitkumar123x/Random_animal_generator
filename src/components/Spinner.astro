<script define:vars={{ animals: JSON.stringify(animals), spinT: JSON.stringify(spinT), animalT: JSON.stringify(animalT), locale: locale, values: JSON.stringify(valuesData) }}>
  const allAnimals = JSON.parse(animals);
  const t = JSON.parse(spinT);
  const animalTranslations = JSON.parse(animalT);
  const currentLocale = locale;
  let spinning = false;
  let currentRotation = 0;

  let audioCtx = null;
  let spinSoundTimer = null;
  function getAudioCtx() {
    try {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return null;
      if (!audioCtx) audioCtx = new AC();
      if (audioCtx.state === 'suspended') audioCtx.resume().catch(() => {});
      return audioCtx;
    } catch (e) { return null; }
  }
  function playTick(vol) {
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'square';
      osc.frequency.setValueAtTime(1400, now);
      osc.frequency.exponentialRampToValueAtTime(700, now + 0.03);
      gain.gain.setValueAtTime(Math.max(0.0001, vol), now);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.05);
      osc.connect(gain).connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.06);
    } catch (e) {}
  }
  function playSpinStart() {
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(220, now);
      osc.frequency.exponentialRampToValueAtTime(900, now + 0.25);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.08, now + 0.06);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.3);
      osc.connect(gain).connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.32);
    } catch (e) {}
  }
  function playSpinWin() {
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const now = ctx.currentTime;
      [880, 1318.5].forEach((freq, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, now + i * 0.12);
        const start = now + i * 0.12;
        gain.gain.setValueAtTime(0.0001, start);
        gain.gain.exponentialRampToValueAtTime(0.15, start + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.45);
        osc.connect(gain).connect(ctx.destination);
        osc.start(start);
        osc.stop(start + 0.47);
      });
    } catch (e) {}
  }
  function stopSpinSound() {
    if (spinSoundTimer) { clearTimeout(spinSoundTimer); spinSoundTimer = null; }
  }
  function startSpinSound(duration) {
    const start = performance.now();
    function schedule() {
      const elapsed = performance.now() - start;
      if (elapsed >= duration || !spinning) { spinSoundTimer = null; return; }
      const p = elapsed / duration;
      playTick(0.12 * (1 - p * 0.75));
      const delay = 45 + 520 * Math.pow(p, 2.6);
      spinSoundTimer = setTimeout(schedule, delay);
    }
    schedule();
  }

  const valueMaps = JSON.parse(values);
  function translateVal(value, field) {
    if (currentLocale === 'en' || !value) return value;
    const map = valueMaps[field];
    return (map && map[currentLocale] && map[currentLocale][value]) || value;
  }

  function getAnimalName(animal) { return (animalTranslations[animal.id] && animalTranslations[animal.id].name) || animal.name; }
  function getAnimalDescription(animal) { return (animalTranslations[animal.id] && animalTranslations[animal.id].description) || animal.description; }
  function getAnimalFunFact(animal) { return (animalTranslations[animal.id] && animalTranslations[animal.id].funFact) || animal.funFact; }

  function getFavorites() {
    try { return JSON.parse(localStorage.getItem('favorites') || '[]'); } catch (e) { return []; }
  }
  function setSpinnerSaveState(animal) {
    const btn = document.getElementById('sc-btn-save');
    if (!btn) return;
    const saved = getFavorites().some(f => f.id === animal.id);
    btn.innerHTML = saved
      ? `<span class="transition-transform group-hover:scale-110">♥</span> ${t.saved || 'Saved!'}`
      : `<span class="transition-transform group-hover:scale-110">♡</span> ${t.save || 'Save'}`;
  }

  const PEXELS_API_KEY = 'xEfnJ9xU5Fem8MeEPh1zE3lURDVneBkLnPGnrNAjnbMCBAY0LGtdgLFE';
  const pexelsCache = JSON.parse(localStorage.getItem('pexelsImageCache') || '{}');
  Object.keys(pexelsCache).forEach(k => { if (typeof pexelsCache[k] === 'string') delete pexelsCache[k]; });
  async function fetchAnimalImage(animalName) {
    const cacheKey = animalName.toLowerCase().trim();
    if (pexelsCache[cacheKey]) return pexelsCache[cacheKey];
    try {
      const res = await fetch(`https://api.pexels.com/v1/search?query=${encodeURIComponent(animalName)}&per_page=1&orientation=landscape`, {
        headers: { 'Authorization': PEXELS_API_KEY }
      });
      if (!res.ok) return null;
      const data = await res.json();
      if (data.photos && data.photos.length > 0) {
        const photo = data.photos[0];
        const result = {
          url: photo.src.large2x || photo.src.large,
          photographer: photo.photographer || '',
          photoUrl: photo.url || '',
        };
        pexelsCache[cacheKey] = result;
        localStorage.setItem('pexelsImageCache', JSON.stringify(pexelsCache));
        return result;
      }
    } catch (e) { console.error('Pexels fetch error:', e); }
    return null;
  }

  const SEGMENT_COLORS = [
    '#0070f3', '#7928ca', '#ff0080', '#50e3c2', '#f5a623', '#ee0000',
    '#22c55e', '#a855f7', '#06b6d4', '#f97316', '#ec4899', '#14b8a6',
  ];

  function getPool() {
    const cat = document.getElementById('spinner-category').value;
    return cat === 'all' ? allAnimals : allAnimals.filter(a => a.category === cat);
  }

  function buildWheel() {
    const pool = getPool();
    const wheel = document.getElementById('wheel');
    const count = Math.min(pool.length, 16);
    const sliceAngle = 360 / count;
    const radius = 160;

    wheel.innerHTML = '';
    wheel.style.background = 'conic-gradient(' +
      pool.slice(0, count).map((_, i) => {
        const color = SEGMENT_COLORS[i % SEGMENT_COLORS.length];
        const start = i * sliceAngle;
        const end = (i + 1) * sliceAngle;
        return `${color} ${start}deg ${end}deg`;
      }).join(', ') +
    ')';

    pool.slice(0, count).forEach((animal, i) => {
      const angle = i * sliceAngle + sliceAngle / 2;
      const rad = (angle - 90) * Math.PI / 180;
      const r = radius * 0.62;
      const x = radius + r * Math.cos(rad);
      const y = radius + r * Math.sin(rad);

      const emoji = document.createElement('div');
      emoji.className = 'absolute flex flex-col items-center';
      emoji.style.left = `${x}px`;
      emoji.style.top = `${y}px`;
      emoji.style.transform = `translate(-50%, -50%) rotate(${angle}deg)`;
      emoji.innerHTML = `
        <span class="text-lg sm:text-2xl leading-none">${animal.emoji}</span>
      `;
      wheel.appendChild(emoji);
    });
  }

  function spin() {
    if (spinning) return;
    spinning = true;

    const btn = document.getElementById('spin-btn');
    btn.disabled = true;
    btn.innerHTML = t.spinning;

    playSpinStart();
    startSpinSound(5000);

    const pool = getPool();
    const count = Math.min(pool.length, 16);
    const sliceAngle = 360 / count;

    const winIndex = Math.floor(Math.random() * count);
    const winner = pool[winIndex];

    const currentMod = ((currentRotation % 360) + 360) % 360;
    const winAngle = winIndex * sliceAngle + sliceAngle / 2;
    const offset = (currentMod + winAngle) % 360;
    const targetAngle = currentRotation - 360 * 8 - offset;
    currentRotation = targetAngle;

    const wheel = document.getElementById('wheel');
    wheel.style.transition = 'transform 5s cubic-bezier(0.17, 0.67, 0.12, 0.99)';
    wheel.style.transform = `rotate(${targetAngle}deg)`;

    const centerEmoji = document.getElementById('center-emoji');
    let tick = 0;
    const emojis = pool.slice(0, count).map(a => a.emoji);
    const tickInterval = setInterval(() => {
      centerEmoji.textContent = emojis[tick % emojis.length];
      tick++;
    }, 80);

    setTimeout(() => {
      clearInterval(tickInterval);
      stopSpinSound();
      playSpinWin();
      spinning = false;
      btn.disabled = false;
      btn.innerHTML = t.spinBtn;
      centerEmoji.textContent = winner.emoji;

      document.getElementById('result-emoji').textContent = winner.emoji;
      document.getElementById('result-name').textContent = getAnimalName(winner);
      const catLabels = {
        mammal: t.catMammal, bird: t.catBird, fish: t.catFish, reptile: t.catReptile,
        amphibian: t.catAmphibian, insect: t.catInsect, marine: t.catMarine,
        farm: t.catFarm, fantasy: t.catFantasy, prehistoric: t.catPrehistoric,
        mythical: t.catMythical, cute: t.catCute
      };
      const catName = catLabels[winner.category] || winner.category;
      document.getElementById('result-desc').textContent = `${catName} · ${translateVal(winner.region, 'region')}`;

      const resultImgWrapper = document.getElementById('result-image-wrapper');
      const resultImgEl = document.getElementById('result-image');
      const resultSkel = resultImgWrapper?.querySelector('.result-skeleton');
      resultImgWrapper.classList.remove('hidden');
      resultImgEl.classList.add('hidden');
      resultImgEl.src = '';
      if (resultSkel) resultSkel.classList.remove('hidden');
      fetchAnimalImage(winner.name).then(data => {
        if (data) {
          resultImgEl.onload = () => { if (resultSkel) resultSkel.classList.add('hidden'); resultImgEl.classList.remove('hidden'); };
          resultImgEl.onerror = () => { if (resultSkel) resultSkel.classList.add('hidden'); };
          resultImgEl.src = data.url;
          resultImgEl.alt = getAnimalName(winner);
        } else {
          if (resultSkel) resultSkel.classList.add('hidden');
          resultImgWrapper.classList.add('hidden');
        }
      });

      const consLabels = {
        LC: { text: t.consLC, color: 'bg-conservation-lc/15 text-conservation-lc border border-conservation-lc/30' },
        NT: { text: t.consNT, color: 'bg-conservation-nt/15 text-conservation-nt border border-conservation-nt/30' },
        VU: { text: t.consVU, color: 'bg-conservation-vu/15 text-conservation-vu border border-conservation-vu/30' },
        EN: { text: t.consEN, color: 'bg-conservation-en/15 text-conservation-en border border-conservation-en/30' },
        CR: { text: t.consCR, color: 'bg-conservation-cr/15 text-conservation-cr border border-conservation-cr/30' },
        EW: { text: t.consEW, color: 'bg-conservation-ew/15 text-conservation-ew border border-conservation-ew/30' },
        EX: { text: t.consEX, color: 'bg-conservation-ex/15 text-conservation-ex border border-conservation-ex/30' },
        DD: { text: t.consDD, color: 'bg-muted/15 text-muted border border-muted/30' },
      };

      const card = document.getElementById('spinner-card');
      card.classList.remove('hidden');
      document.getElementById('card-emoji').textContent = winner.emoji;
      const cardImgWrapper = document.getElementById('card-image-wrapper');
      const cardImgEl = document.getElementById('card-image');
      const cardImgSkel = document.getElementById('card-image-skeleton');
      cardImgWrapper.classList.remove('hidden');
      cardImgEl.classList.add('hidden');
      cardImgEl.src = '';
      if (cardImgSkel) cardImgSkel.classList.remove('hidden');
      fetchAnimalImage(winner.name).then(data => {
        if (data) {
          cardImgEl.onload = () => { if (cardImgSkel) cardImgSkel.classList.add('hidden'); cardImgEl.classList.remove('hidden'); };
          cardImgEl.onerror = () => { if (cardImgSkel) cardImgSkel.classList.add('hidden'); };
          cardImgEl.src = data.url;
          cardImgEl.alt = getAnimalName(winner);
          const creditEl = document.getElementById('card-image-credit');
          const creditLink = document.getElementById('card-image-credit-link');
          if (creditLink && data.photographer && data.photoUrl) {
            const photoByTpl = t.photoBy || 'Photo by {photographer} on Pexels';
            creditLink.textContent = photoByTpl.replace('{photographer}', data.photographer);
            creditLink.href = data.photoUrl;
