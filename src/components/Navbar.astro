---
import { getTranslations } from '../utils/i18n';

interface Props {
  locale?: string;
  pagePath?: string;
}

const { locale = 'en', pagePath = '/' } = Astro.props;
const t = getTranslations(locale as any);

const navLinks = [
  { href: '/', label: t.nav_home || 'Home', emoji: '🏠' },
  { href: '/spinner', label: t.spinner_wheel || 'Spinner', emoji: '🎰' },
  { href: '/quiz', label: t.animal_quiz || 'Quiz', emoji: '🧠' },
  { href: '/compare', label: t.compare_animals || 'Compare', emoji: '⚖️' },
  { href: '/blog', label: t.blog || 'Blog', emoji: '📝' },
];

const moreLinks = [
  { href: '/about-us', label: t.about_us || 'About Us', emoji: 'ℹ️' },
  { href: '/contact-us', label: t.contact_us || 'Contact Us', emoji: '✉️' },
  { href: '/privacy-policy', label: t.privacy_policy || 'Privacy Policy', emoji: '🔒' },
  { href: '/terms-and-conditions', label: t.terms || 'Terms & Conditions', emoji: '📄' },
];

const languages = [
  { code: 'en', flag: 'us', name: 'English' },
  { code: 'es', flag: 'es', name: 'Español' },
  { code: 'ja', flag: 'jp', name: '日本語' },
  { code: 'fr', flag: 'fr', name: 'Français' },
  { code: 'de', flag: 'de', name: 'Deutsch' },
  { code: 'pt', flag: 'br', name: 'Português' },
  { code: 'ko', flag: 'kr', name: '한국어' },
  { code: 'it', flag: 'it', name: 'Italiano' },
  { code: 'zh-CN', flag: 'cn', name: '简体中文' },
  { code: 'zh-TW', flag: 'tw', name: '繁體中文' },
  { code: 'ar', flag: 'sa', name: 'العربية' },
];

function getLocalePath(code: string) {
  if (code === 'en') return pagePath || '/';
  return `/${code}${pagePath || '/'}`;
}

const currentLang = languages.find(l => l.code === locale) || languages[0];
---

<nav id="main-nav" class="sticky top-0 z-50 border-b border-hairline bg-canvas/90 backdrop-blur-xl dark:border-[#222] dark:bg-[#0a0a0a]/90">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">

    <!-- Logo -->
    <a href={getLocalePath('en')} class="flex items-center gap-2.5 text-ink dark:text-[#ededed] shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 600 600" class="shrink-0">
        <foreignObject width="100%" height="100%" x="0" y="0">
          <div xmlns="http://www.w3.org/1999/xhtml" style="background:#000;border-radius:157px;width:100%;height:100%;display:flex;justify-content:center;align-items:center">
            <svg xmlns="http://www.w3.org/2000/svg" width="359" height="359" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.43" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6a4 4 0 0 0-4 4 7 7 0 0 0-7 7c0-5 4-5 4-10.5a4.5 4.5 0 1 0-9 0 2.5 2.5 0 0 0 5 0C7 10 3 11 3 17c0 2.8 2.2 5 5 5h10"/>
              <path d="M16 20c0-1.7 1.3-3 3-3h1a2 2 0 0 0 2-2v-2a4 4 0 0 0-4-4V4"/>
              <path d="M15.2 22a3 3 0 0 0-2.2-5"/>
              <path d="M18 13h.01"/>
            </svg>
          </div>
        </foreignObject>
      </svg>
      <span class="text-sm font-semibold tracking-tight hidden sm:inline">Random Animal Generator</span>
      <span class="text-sm font-semibold tracking-tight sm:hidden">🐾 Animals</span>
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden md:flex items-center gap-0.5">
      {navLinks.map(link => (
        <a
          href={locale === 'en' ? link.href : `/${locale}${link.href}`}
          class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed]"
        >
          <span>{link.emoji}</span>
          <span>{link.label}</span>
        </a>
      ))}

      <!-- More Dropdown -->
      <div class="relative" id="more-menu-wrapper">
        <button
          id="more-menu-btn"
          class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed]"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>More</span>
          <svg id="more-chevron" class="h-3 w-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          id="more-menu-dropdown"
          class="hidden absolute right-0 mt-2 w-48 origin-top-right rounded-xl border border-hairline bg-canvas-elevated py-1.5 shadow-xl dark:border-[#2a2a2a] dark:bg-[#161616]"
        >
          {moreLinks.map(link => (
            <a
              href={locale === 'en' ? link.href : `/${locale}${link.href}`}
              class="flex items-center gap-2.5 px-3 py-2 text-xs text-body transition-colors hover:bg-hairline-soft hover:text-ink dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed]"
            >
              <span>{link.emoji}</span>
              <span>{link.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-2">
      <!-- Language Dropdown -->
      <div class="relative" id="lang-menu-wrapper">
        <button
          id="lang-menu-btn"
          class="flex h-8 items-center gap-1.5 rounded-lg border border-hairline bg-canvas-elevated px-2 text-xs font-medium text-body transition-all hover:bg-hairline-soft dark:border-[#333] dark:bg-[#1a1a1a] dark:text-[#a1a1a1] dark:hover:bg-[#222]"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <img src={`https://flagcdn.com/24x18/${currentLang.flag}.png`} alt={currentLang.name} width="18" height="13" class="shrink-0 rounded-[2px] object-cover" loading="lazy" />
          <svg id="lang-chevron" class="h-3 w-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          id="lang-menu-dropdown"
          class="hidden absolute right-0 mt-2 w-44 max-h-80 overflow-y-auto origin-top-right rounded-xl border border-hairline bg-canvas-elevated py-1.5 shadow-xl dark:border-[#2a2a2a] dark:bg-[#161616]"
        >
          {languages.map(lang => (
            <a
              href={getLocalePath(lang.code)}
              class={`flex items-center gap-2.5 px-3 py-2 text-xs transition-colors hover:bg-hairline-soft dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] ${lang.code === locale ? 'font-bold text-ink bg-hairline-soft dark:text-[#ededed] dark:bg-[#1f1f1f]' : 'text-body dark:text-[#a1a1a1]'}`}
            >
              <img src={`https://flagcdn.com/24x18/${lang.flag}.png`} alt={lang.name} width="18" height="13" class="shrink-0 rounded-[2px] object-cover" loading="lazy" />
              <span>{lang.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Space hint (desktop only) -->
      <div class="hidden lg:flex items-center gap-1 text-xs text-muted">
        <kbd class="rounded border border-hairline bg-canvas-elevated px-1.5 py-0.5 font-mono text-faint dark:border-[#333] dark:bg-[#1a1a1a]">{t.nav_space || 'Space'}</kbd>
        <span>{t.generate || 'Generate'}</span>
      </div>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="flex h-8 w-8 items-center justify-center rounded-lg border border-hairline bg-canvas-elevated text-body transition-all hover:bg-hairline-soft hover:scale-105 dark:border-[#333] dark:bg-[#1a1a1a] dark:text-[#a1a1a1] dark:hover:bg-[#222]"
        aria-label="Toggle theme"
      >
        <svg id="sun-icon" class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="moon-icon" class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Hamburger -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex h-8 w-8 items-center justify-center rounded-lg border border-hairline bg-canvas-elevated text-body transition-all hover:bg-hairline-soft dark:border-[#333] dark:bg-[#1a1a1a] dark:text-[#a1a1a1] dark:hover:bg-[#222]"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <span id="hamburger-icon" class="block">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </span>
        <span id="close-icon" class="hidden">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-hairline bg-canvas dark:border-[#222] dark:bg-[#0a0a0a]"
  >
    <div class="mx-auto max-w-6xl px-4 py-3 space-y-0.5">
      <!-- Main links -->
      <p class="px-3 pt-1 pb-1.5 text-[10px] font-semibold uppercase tracking-wider text-muted">{t.explore || 'Explore'}</p>
      {navLinks.map(link => (
        <a
          href={locale === 'en' ? link.href : `/${locale}${link.href}`}
          class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink dark:text-[#a1a1a1] dark:hover:bg-[#1a1a1a] dark:hover:text-[#ededed]"
        >
          <span class="text-base">{link.emoji}</span>
          <span>{link.label}</span>
        </a>
      ))}
      <!-- Divider -->
      <div class="my-2 border-t border-hairline dark:border-[#222]"></div>
      <p class="px-3 pt-1 pb-1.5 text-[10px] font-semibold uppercase tracking-wider text-muted">{t.company || 'Company'}</p>
      {moreLinks.map(link => (
        <a
          href={locale === 'en' ? link.href : `/${locale}${link.href}`}
          class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink dark:text-[#a1a1a1] dark:hover:bg-[#1a1a1a] dark:hover:text-[#ededed]"
        >
          <span class="text-base">{link.emoji}</span>
          <span>{link.label}</span>
        </a>
      ))}
      <!-- Language Section -->
      <div class="my-2 border-t border-hairline dark:border-[#222]"></div>
      <p class="px-3 pt-1 pb-1.5 text-[10px] font-semibold uppercase tracking-wider text-muted">{t.nav_language || 'Language'}</p>
      <div class="grid grid-cols-2 gap-1 px-3 pb-2">
        {languages.map(lang => (
          <a
            href={getLocalePath(lang.code)}
            class={`flex items-center gap-2 rounded-lg px-2.5 py-2 text-xs font-medium transition-colors ${lang.code === locale ? 'bg-hairline-soft text-ink dark:bg-[#1f1f1f] dark:text-[#ededed]' : 'text-body hover:bg-hairline-soft dark:text-[#a1a1a1] dark:hover:bg-[#1a1a1a]'}`}
          >
            <img src={`https://flagcdn.com/24x18/${lang.flag}.png`} alt={lang.name} width="18" height="13" class="shrink-0 rounded-[2px] object-cover" loading="lazy" />
            <span>{lang.name}</span>
          </a>
        ))}
      </div>
      <div class="h-3"></div>
    </div>
  </div>
</nav>

<script is:inline>
  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Desktop more dropdown
  const moreBtn = document.getElementById('more-menu-btn');
  const moreDropdown = document.getElementById('more-menu-dropdown');
  const moreWrapper = document.getElementById('more-menu-wrapper');
  const moreChevron = document.getElementById('more-chevron');
  let menuOpen = false;

  moreBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    menuOpen = !menuOpen;
    moreDropdown.classList.toggle('hidden', !menuOpen);
    moreChevron.style.transform = menuOpen ? 'rotate(180deg)' : '';
    moreBtn.setAttribute('aria-expanded', menuOpen.toString());
    // Close lang dropdown
    langDropdown?.classList.add('hidden');
    if (langChevron) langChevron.style.transform = '';
  });

  document.addEventListener('click', (e) => {
    if (!moreWrapper?.contains(e.target)) {
      moreDropdown?.classList.add('hidden');
      if (moreChevron) moreChevron.style.transform = '';
      menuOpen = false;
    }
  });

  // Language dropdown
  const langBtn = document.getElementById('lang-menu-btn');
  const langDropdown = document.getElementById('lang-menu-dropdown');
  const langWrapper = document.getElementById('lang-menu-wrapper');
  const langChevron = document.getElementById('lang-chevron');
  let langOpen = false;

  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langOpen = !langOpen;
    langDropdown.classList.toggle('hidden', !langOpen);
    langChevron.style.transform = langOpen ? 'rotate(180deg)' : '';
    langBtn.setAttribute('aria-expanded', langOpen.toString());
    // Close more dropdown
    moreDropdown?.classList.add('hidden');
    if (moreChevron) moreChevron.style.transform = '';
    menuOpen = false;
  });

  document.addEventListener('click', (e) => {
    if (!langWrapper?.contains(e.target)) {
      langDropdown?.classList.add('hidden');
      if (langChevron) langChevron.style.transform = '';
      langOpen = false;
    }
  });

  // Mobile menu
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  let mobileOpen = false;

  mobileBtn?.addEventListener('click', () => {
    mobileOpen = !mobileOpen;
    mobileMenu.classList.toggle('hidden', !mobileOpen);
    hamburgerIcon.classList.toggle('hidden', mobileOpen);
    closeIcon.classList.toggle('hidden', !mobileOpen);
    mobileBtn.setAttribute('aria-expanded', mobileOpen.toString());
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
      mobileOpen = false;
    });
  });
</script>
