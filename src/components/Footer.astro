---
import { getTranslations, type Locale } from '../utils/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale);
---
<footer class="mt-16 border-t border-hairline bg-canvas dark:border-[#222] dark:bg-[#0a0a0a]">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-2.5 text-ink dark:text-[#ededed]">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 600 600" class="shrink-0">
            <foreignObject width="100%" height="100%" x="0" y="0">
              <div xmlns="http://www.w3.org/1999/xhtml" style="background:#000;border-radius:157px;width:100%;height:100%;display:flex;justify-content:center;align-items:center">
                <svg xmlns="http://www.w3.org/2000/svg" width="359" height="359" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.43" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 6a4 4 0 0 0-4 4 7 7 0 0 0-7 7c0-5 4-5 4-10.5a4.5 4.5 0 1 0-9 0 2.5 2.5 0 0 0 5 0C7 10 3 11 3 17c0 2.8 2.2 5 5 5h10"/>
                  <path d="M16 20c0-1.7 1.3-3 3-3h1a2 2 0 0 0 2-2v-2a4 4 0 0 0-4-4V4"/>
                  <path d="M15.2 22a3 3 0 0 0-2.2-5"/>
                  <path d="M18 13h.01"/>
                </svg>
              </div>
            </foreignObject>
          </svg>
          <span class="text-sm font-semibold tracking-tight">Random Animal Generator</span>
        </a>
        <p class="mt-3 text-xs leading-relaxed text-body dark:text-[#a1a1a1]">
          {t.footer_desc}
        </p>
      </div>

      <div>
        <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">{t.explore}</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-xs text-body transition-colors hover:text-ink dark:text-[#a1a1a1] dark:hover:text-[#ededed]">{t.random_generator}</a></li>
          <li><a href="/spinner" class="text-xs text-body transition-colors hover:text-ink dark:text-[#a1a1a1] dark:hover:text-[#ededed]">{t.spinner_wheel}</a></li>
          <li><a href="/quiz" class="text-xs text-body transition-colors hover:text-ink dark:text-[#a1a1a1] dark:hover:text-[#ededed]">{t.animal_quiz}</a></li>
          <li><a href="/compare" class="text-xs text-body transition-colors hover:text-ink dark:text-[#a1a1a1] dark:hover:text-[#ededed]">{t.compare_animals}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">{t.company}</h3>
        <ul class="space-y-2">
          <li><a href="/about-us" class="text-xs text-body transition-colors hover:text-ink dark:text-[#a1a1a1] dark:hover:text-[#ededed]">{t.about_us}</a></li>
          <li><a href="/blog" class="text-xs text-body transition-colors hover:text-ink dark:text-[#a1a1a1] dark:hover:text-[#ededed]">{t.blog}</a></li>
          <li><a href="/contact-us" class="text-xs text-body transition-colors hover:text-ink dark:text-[#a1a1a1] dark:hover:text-[#ededed]">{t.contact_us}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">{t.legal}</h3>
        <ul class="space-y-2">
          <li><a href="/privacy-policy" class="text-xs text-body transition-colors hover:text-ink dark:text-[#a1a1a1] dark:hover:text-[#ededed]">{t.privacy_policy}</a></li>
          <li><a href="/terms-and-conditions" class="text-xs text-body transition-colors hover:text-ink dark:text-[#a1a1a1] dark:hover:text-[#ededed]">{t.terms}</a></li>
          <li><a href="/disclaimer" class="text-xs text-body transition-colors hover:text-ink dark:text-[#a1a1a1] dark:hover:text-[#ededed]">{t.disclaimer}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-hairline pt-6 dark:border-[#222]">
      <div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
        <p class="text-xs text-muted">
          {t.copyright}
        </p>
        <div class="flex items-center gap-4">
          <a href="/privacy-policy" class="text-xs text-muted transition-colors hover:text-ink dark:hover:text-[#ededed]">{t.privacy_policy}</a>
          <a href="/terms-and-conditions" class="text-xs text-muted transition-colors hover:text-ink dark:hover:text-[#ededed]">{t.terms}</a>
          <a href="/disclaimer" class="text-xs text-muted transition-colors hover:text-ink dark:hover:text-[#ededed]">{t.disclaimer}</a>
          <a href="/contact-us" class="text-xs text-muted transition-colors hover:text-ink dark:hover:text-[#ededed]">{t.contact_us}</a>
        </div>
      </div>
    </div>
  </div>
</footer>