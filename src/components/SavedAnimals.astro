---
import { getTranslations } from '../utils/i18n';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale as any);

const labels = {
  title: t.saved_animals || 'Saved Animals',
  empty: t.saved_empty || 'No saved animals yet. Tap Save on any animal card to keep it here.',
  clear: t.saved_clear || 'Clear all',
  remove: t.saved_remove || 'Remove',
  view: (t.view || 'View').replace(/[→✕]/g, '').trim() || 'View',
  close: (t.close || 'Close').replace(/[→✕]/g, '').trim() || 'Close',
};
---

<button
  id="saved-open-btn"
  class="flex items-center gap-1.5 rounded-lg border border-hairline bg-canvas-elevated px-3 py-1.5 text-xs font-medium text-body transition-colors hover:bg-hairline-soft dark:border-[#333] dark:bg-[#1a1a1a] dark:text-[#a1a1a1] dark:hover:bg-[#222]"
  aria-haspopup="dialog"
>
  <span>♥</span> {labels.title}
  <span
    id="saved-count"
    class="hidden min-w-[1.1rem] rounded-full bg-rose-500 px-1.5 py-px text-[10px] font-bold leading-4 text-white"
  >0</span>
</button>

<div
  id="saved-overlay"
  class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
  style="backdrop-filter:blur(4px);"
  role="dialog"
  aria-modal="true"
  aria-label={labels.title}
>
  <div class="flex max-h-[80vh] w-full max-w-md flex-col rounded-2xl border border-hairline bg-canvas-elevated shadow-2xl dark:border-[#333] dark:bg-[#1a1a1a]">
    <div class="flex items-center justify-between border-b border-hairline p-4 dark:border-[#333]">
      <h3 class="text-sm font-bold text-ink dark:text-[#ededed]">
        ♥ {labels.title} <span id="saved-total" class="font-normal text-muted">(0)</span>
      </h3>
      <div class="flex items-center gap-3">
        <button id="saved-clear" class="text-xs text-muted transition-colors hover:text-rose-500 dark:hover:text-rose-400">
          {labels.clear}
        </button>
        <button
          id="saved-close"
          class="flex h-7 w-7 items-center justify-center rounded-lg text-muted transition-colors hover:bg-hairline hover:text-ink dark:hover:bg-[#333] dark:hover:text-[#ededed]"
          aria-label={labels.close}
        >✕</button>
      </div>
    </div>
    <div id="saved-list" class="space-y-2 overflow-y-auto p-4"></div>
    <p id="saved-empty" class="hidden p-6 text-center text-xs leading-relaxed text-muted">{labels.empty}</p>
  </div>
</div>

<script define:vars={{ labels: JSON.stringify(labels) }}>
  const T = JSON.parse(labels);

  function readFavorites() {
    try { return JSON.parse(localStorage.getItem('favorites') || '[]'); } catch (e) { return []; }
  }
  function writeFavorites(list) {
    localStorage.setItem('favorites', JSON.stringify(list.slice(0, 50)));
    window.dispatchEvent(new CustomEvent('favorites-changed'));
  }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  function animalName(a) {
    const tr = window.__animalT && window.__animalT[a.id];
    return (tr && tr.name) || a.name;
  }

  const overlay = document.getElementById('saved-overlay');
  const listEl = document.getElementById('saved-list');
  const emptyEl = document.getElementById('saved-empty');
  const countEl = document.getElementById('saved-count');
  const totalEl = document.getElementById('saved-total');
  const openBtn = document.getElementById('saved-open-btn');

  function updateCount() {
    const n = readFavorites().length;
    if (countEl) {
      countEl.textContent = String(n);
      countEl.classList.toggle('hidden', n === 0);
    }
    if (totalEl) totalEl.textContent = `(${n})`;
  }

  function translateVal(val, field) {
    const loc = window.__cardLocale || 'en';
    if (loc === 'en' || !val) return val;
    const map = window.__valueMaps && window.__valueMaps[field];
    return (map && map[loc] && map[loc][val]) || val;
  }

  function render() {
    const favs = readFavorites();
    updateCount();
    if (!listEl) return;
    if (!favs.length) {
      listEl.innerHTML = '';
      emptyEl?.classList.remove('hidden');
      return;
    }
    emptyEl?.classList.add('hidden');
    listEl.innerHTML = favs.map(a => `
      <div class="saved-row flex items-center gap-3 rounded-xl border border-hairline bg-canvas p-3 dark:border-[#333] dark:bg-[#111]" data-id="${esc(a.id)}">
        <span class="text-2xl">${esc(a.emoji)}</span>
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-semibold text-ink dark:text-[#ededed]">${esc(animalName(a))}</p>
          <p class="truncate text-[11px] text-muted">${esc(translateVal(a.habitat, 'habitat'))}</p>
        </div>
        <button class="saved-view shrink-0 rounded-lg border border-hairline bg-canvas-elevated px-2.5 py-1.5 text-[11px] font-medium text-ink transition-colors hover:bg-hairline-soft dark:border-[#333] dark:bg-[#1a1a1a] dark:text-[#ededed] dark:hover:bg-[#222]">${esc(T.view)}</button>
        <button class="saved-remove shrink-0 rounded-lg border border-hairline bg-canvas-elevated px-2.5 py-1.5 text-[11px] font-medium text-muted transition-colors hover:border-rose-300 hover:text-rose-500 dark:border-[#333] dark:bg-[#1a1a1a] dark:hover:border-rose-500/40 dark:hover:text-rose-400">${esc(T.remove)}</button>
      </div>
    `).join('');
  }

  function open() {
    render();
    overlay?.classList.remove('hidden');
  }
  function close() {
    overlay?.classList.add('hidden');
  }

  openBtn?.addEventListener('click', open);
  document.getElementById('saved-close')?.addEventListener('click', close);
  overlay?.addEventListener('click', e => { if (e.target === e.currentTarget) close(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

  document.getElementById('saved-clear')?.addEventListener('click', () => {
    if (!readFavorites().length) return;
    if (window.confirm(T.clear + '?')) writeFavorites([]);
  });

  listEl?.addEventListener('click', e => {
    const row = e.target.closest('.saved-row');
    if (!row) return;
    const id = row.dataset.id;
    const favs = readFavorites();
    if (e.target.closest('.saved-remove')) {
      writeFavorites(favs.filter(f => f.id !== id));
      render();
      return;
    }
    if (e.target.closest('.saved-view')) {
      const animal = favs.find(f => f.id === id);
      if (!animal) return;
      close();
      if (window.displayAnimal) {
        window.displayAnimal(animal);
        document.getElementById('animal-card-container')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        window.location.href = `/?animal=${encodeURIComponent(id)}`;
      }
    }
  });

  window.addEventListener('favorites-changed', () => {
    updateCount();
    if (overlay && !overlay.classList.contains('hidden')) render();
  });

  updateCount();
</script>
