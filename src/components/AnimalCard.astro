window.displayAnimal = function(animal) {
  const t = getCardT();
  const consLabels = getConservationLabels();

  document.getElementById('placeholder-text').innerHTML = t.placeholder;
  document.getElementById('animal-placeholder')?.classList.add('hidden');
  const card = document.getElementById('animal-card');
  if (!card) return;
  card.classList.remove('hidden');

  document.getElementById('card-emoji').textContent = animal.emoji;
  const imgWrapper = document.getElementById('card-image-wrapper');
  const imgEl = document.getElementById('card-image');
  const imgSkeleton = document.getElementById('card-image-skeleton');
  imgWrapper.classList.remove('hidden');
  imgEl.classList.add('hidden');
  imgEl.src = '';
  imgSkeleton.classList.remove('hidden');
  const creditEl = document.getElementById('card-image-credit');
  const creditLink = document.getElementById('card-image-credit-link');
  if (creditEl) creditEl.classList.add('hidden');
  fetchAnimalImage(animal.name).then(data => {
    if (data) {
      imgEl.onload = () => { imgSkeleton.classList.add('hidden'); imgEl.classList.remove('hidden'); };
      imgEl.onerror = () => { imgSkeleton.classList.add('hidden'); };
      imgEl.src = data.url;
      imgEl.alt = animal.name;
      if (creditLink && data.photographer && data.photoUrl) {
        const photoByTpl = t.photoBy || 'Photo by {photographer} on Pexels';
        creditLink.textContent = photoByTpl.replace('{photographer}', data.photographer);
        creditLink.href = data.photoUrl;
        creditEl.classList.remove('hidden');
      }
    } else {
      imgSkeleton.classList.add('hidden');
      imgWrapper.classList.add('hidden');
    }
  });
  document.getElementById('card-name').textContent = getAnimalName(animal);
  const sciEl = document.getElementById('card-scientific');
  sciEl.textContent = animal.scientificName || '';
  sciEl.classList.toggle('hidden', !animal.scientificName);

  const cons = consLabels[animal.conservation] || consLabels.LC;
  const consEl = document.getElementById('card-conservation');
  consEl.textContent = cons.text;
  consEl.className = `mt-2 inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium ${cons.color}`;

  document.getElementById('card-description').textContent = getAnimalDescription(animal);
  document.getElementById('card-habitat').textContent = translateVal(animal.habitat, 'habitat');
  document.getElementById('card-diet').textContent = translateVal(animal.diet, 'diet');
  document.getElementById('card-lifespan').textContent = translateVal(animal.lifespan, 'lifespan') || animal.lifespan.replace(/\byears?\b/gi, t.years);
  document.getElementById('card-weight').textContent = animal.weight;
  document.getElementById('card-speed').textContent = animal.speed;
  document.getElementById('card-length').textContent = animal.length;
  document.getElementById('card-region').textContent = translateVal(animal.region, 'region');
  document.getElementById('card-funfact').textContent = getAnimalFunFact(animal);
  document.getElementById('card-class').textContent = translateVal(animal.class, 'class') || animal.class || '—';
  document.getElementById('card-order').textContent = animal.order || '—';
  document.getElementById('card-family').textContent = animal.family || '—';

  document.getElementById('label-habitat').textContent = t.habitat;
  document.getElementById('label-diet').textContent = t.diet;
  document.getElementById('label-lifespan').textContent = t.lifespan;
  document.getElementById('label-weight').textContent = t.weight;
  document.getElementById('label-speed').textContent = t.speed;
  document.getElementById('label-length').textContent = t.length;
  document.getElementById('label-region').textContent = t.region;
  document.getElementById('label-taxonomy').textContent = '🧬 ' + t.taxonomy;
  document.getElementById('label-class').textContent = t.taxClass;
  document.getElementById('label-order').textContent = t.taxOrder;
  document.getElementById('label-family').textContent = t.taxFamily;
  document.getElementById('label-funfact').textContent = '💡 ' + t.funFact;

  const fsText = document.getElementById('btn-fullscreen-text');
  if (fsText) fsText.textContent = t.fullscreen || 'Fullscreen';
  const fsBtn = document.getElementById('btn-fullscreen');
  if (fsBtn) fsBtn.title = t.fullscreen || 'Fullscreen';

  setFavoriteBtnState(animal);
  document.getElementById('btn-share-text').textContent = t.share;
  document.getElementById('btn-copy-text').textContent = t.copy;
  document.getElementById('btn-download-text').textContent = t.download;

  document.getElementById('btn-favorite').onclick = () => {
    const favs = getFavorites();
    const exists = favs.find(f => f.id === animal.id);
    if (!exists) {
      favs.unshift(animal);
      localStorage.setItem('favorites', JSON.stringify(favs.slice(0, 50)));
    } else {
      localStorage.setItem('favorites', JSON.stringify(favs.filter(f => f.id !== animal.id)));
    }
    setFavoriteBtnState(animal);
    notifyFavoritesChanged();
  };

  document.getElementById('btn-share').onclick = () => window.openSharePopup(animal);

  document.getElementById('btn-copy').onclick = () => {
    const lifespanVal = translateVal(animal.lifespan, 'lifespan') || animal.lifespan.replace(/\byears?\b/gi, t.years);
    const text = `${animal.emoji} ${getAnimalName(animal)}\n${getAnimalDescription(animal)}\n\n${t.funFact}: ${getAnimalFunFact(animal)}\n\n${t.habitat}: ${translateVal(animal.habitat, 'habitat')} | ${t.diet}: ${translateVal(animal.diet, 'diet')} | ${t.lifespan}: ${lifespanVal}`;
    navigator.clipboard?.writeText(text);
    document.getElementById('btn-copy').innerHTML = `<span>✓</span> <span id="btn-copy-text">${t.copied}</span>`;
    setTimeout(() => { document.getElementById('btn-copy').innerHTML = `<span>📋</span> <span id="btn-copy-text">${t.copy}</span>`; }, 2000);
  };

  document.getElementById('btn-download').onclick = async () => {
    const btn = document.getElementById('btn-download');
    btn.innerHTML = `<span>⏳</span> <span id="btn-download-text">${t.saving}</span>`;
    try {
      const W = 600, H = 1060;
      const canvas = document.createElement('canvas');
      canvas.width = W * 2; canvas.height = H * 2;
      const ctx = canvas.getContext('2d');
      ctx.scale(2, 2);

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, W, H);

      const grad = ctx.createLinearGradient(0, 0, W, H);
      grad.addColorStop(0, '#eef2ff');
      grad.addColorStop(0.5, '#f3e8ff');
      grad.addColorStop(1, '#fce7f3');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.roundRect(0, 0, W, H, 24);
      ctx.fill();

      let y = 28;

      const img = await new Promise(async (resolve) => {
        try {
          const cache = JSON.parse(localStorage.getItem('pexelsImageCache') || '{}');
          let entry = cache[animal.name.toLowerCase().trim()];
          let imgUrl = typeof entry === 'string' ? entry : (entry && entry.url);
          if (!imgUrl && typeof fetchAnimalImage === 'function') {
            const fetched = await fetchAnimalImage(animal.name);
            if (fetched && fetched.url) imgUrl = fetched.url;
          }
          if (!imgUrl) return resolve(null);

          try {
            const r = await fetch(imgUrl);
            if (r.ok) {
              const blob = await r.blob();
              const objUrl = URL.createObjectURL(blob);
              const el = new Image();
              el.onload = () => { URL.revokeObjectURL(objUrl); resolve(el); };
              el.onerror = () => { URL.revokeObjectURL(objUrl); resolve(null); };
              el.src = objUrl;
              return;
            }
          } catch (e) {}

          const el = new Image();
          el.crossOrigin = 'anonymous';
          el.onload = () => resolve(el);
          el.onerror = () => resolve(null);
          el.src = imgUrl;
        } catch (e) {
          resolve(null);
        }
      });

      if (img) {
        const containerW = W - 56;
        const containerH = 300;
        const imgX = 28, imgY = y;

        ctx.save();
        ctx.beginPath();
        ctx.roundRect(imgX, imgY, containerW, containerH, 16);
        ctx.clip();

        // Ambient matching background frame
        const bgScale = Math.max(containerW / img.width, containerH / img.height);
        const bgW = img.width * bgScale;
        const bgH = img.height * bgScale;
        ctx.drawImage(img, imgX + (containerW - bgW) / 2, imgY + (containerH - bgH) / 2, bgW, bgH);

        ctx.fillStyle = 'rgba(15, 23, 42, 0.78)';
        ctx.fillRect(imgX, imgY, containerW, containerH);

        // Entire uncropped sharp image centered inside
        const scale = Math.min((containerW - 16) / img.width, (containerH - 16) / img.height);
        const drawW = Math.round(img.width * scale);
        const drawH = Math.round(img.height * scale);
        const drawX = Math.round(imgX + (containerW - drawW) / 2);
        const drawY = Math.round(imgY + (containerH - drawH) / 2);

        ctx.save();
        ctx.beginPath();
        ctx.roundRect(drawX, drawY, drawW, drawH, 10);
        ctx.clip();
        ctx.drawImage(img, drawX, drawY, drawW, drawH);
        ctx.restore();

        ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(imgX, imgY, containerW, containerH, 16);
        ctx.stroke();

        ctx.restore();
        y += containerH + 20;
      } else {
        ctx.font = '64px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(animal.emoji, W / 2, y + 64);
        y += 84;
      }

      ctx.textAlign = 'center';
      ctx.fillStyle = '#111827';
      ctx.font = 'bold 26px system-ui, -apple-system, sans-serif';
      ctx.fillText(getAnimalName(animal), W / 2, y + 28);
      y += 36;

      if (animal.scientificName) {
        ctx.fillStyle = '#6b7280';
        ctx.font = 'italic 13px system-ui, -apple-system, sans-serif';
        ctx.fillText(animal.scientificName, W / 2, y + 14);
        y += 20;
      }

      const consColorMap = { LC:'#16a34a', NT:'#65a30d', VU:'#d97706', EN:'#ea580c', CR:'#dc2626', EW:'#7c3aed', EX:'#6b7280', DD:'#9ca3af' };
      const consBgMap = { LC:'#dcfce7', NT:'#ecfccb', VU:'#fef3c7', EN:'#ffedd5', CR:'#fee2e2', EW:'#ede9fe', EX:'#f3f4f6', DD:'#f3f4f6' };
      const badgeColor = consColorMap[animal.conservation] || '#16a34a';
      const badgeBg = consBgMap[animal.conservation] || '#dcfce7';
      ctx.font = 'bold 12px system-ui, -apple-system, sans-serif';
      const badgeText = cons.text;
      const bw = ctx.measureText(badgeText).width + 20;
      const bx = (W - bw) / 2, by = y + 4;
      ctx.fillStyle = badgeBg;
      ctx.beginPath();
      ctx.roundRect(bx, by, bw, 22, 11);
      ctx.fill();
      ctx.fillStyle = badgeColor;
      ctx.textAlign = 'center';
      ctx.fillText(badgeText, W / 2, by + 15);
      y += 34;

      ctx.textAlign = 'left';
      ctx.fillStyle = '#374151';
      ctx.font = '13px system-ui, -apple-system, sans-serif';
      const desc = getAnimalDescription(animal);
      const lines = wrapText(ctx, desc, W - 56);
      lines.slice(0, 4).forEach((line, i) => {
        ctx.fillText(line, 28, y + 14 + i * 18);
      });
      y += Math.min(lines.length, 4) * 18 + 20;

      const statGrid = [
        { icon: '🌍', label: t.habitat, value: translateVal(animal.habitat, 'habitat') },
        { icon: '🍽️', label: t.diet, value: translateVal(animal.diet, 'diet') },
        { icon: '⏱️', label: t.lifespan, value: translateVal(animal.lifespan, 'lifespan') || animal.lifespan.replace(/\byears?\b/gi, t.years) },
        { icon: '⚖️', label: t.weight, value: animal.weight },
      ];
      const colW = (W - 56 - 12) / 2;
      statGrid.forEach((s, i) => {
        const col = i % 2, row = Math.floor(i / 2);
        const sx = 28 + col * (colW + 12), sy = y + row * 48;
        ctx.fillStyle = '#f9fafb';
        ctx.beginPath();
        ctx.roundRect(sx, sy, colW, 42, 8);
        ctx.fill();
        ctx.strokeStyle = '#e5e7eb';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(sx, sy, colW, 42, 8);
        ctx.stroke();
        ctx.fillStyle = '#6b7280';
        ctx.font = '10px system-ui, -apple-system, sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText(s.icon + ' ' + s.label, sx + 10, sy + 16);
        ctx.fillStyle = '#111827';
        ctx.font = 'bold 12px system-ui, -apple-system, sans-serif';
        ctx.fillText(s.value, sx + 10, sy + 32);
      });
      y += 100;

      const extraStats = [
        { icon: '⚡', label: t.speed, value: animal.speed },
        { icon: '📏', label: t.length, value: animal.length },
        { icon: '🌐', label: t.region, value: translateVal(animal.region, 'region') },
      ];
      const extraColW = (W - 56 - 16) / 3;
      extraStats.forEach((s, i) => {
        const sx = 28 + i * (extraColW + 8), sy = y;
        ctx.fillStyle = '#f0fdf4';
        ctx.beginPath();
        ctx.roundRect(sx, sy, extraColW, 42, 8);
        ctx.fill();
        ctx.strokeStyle = '#bbf7d0';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(sx, sy, extraColW, 42, 8);
        ctx.stroke();
        ctx.fillStyle = '#6b7280';
        ctx.font = '10px system-ui, -apple-system, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(s.icon + ' ' + s.label, sx + extraColW / 2, sy + 16);
        ctx.fillStyle = '#111827';
        ctx.font = 'bold 12px system-ui, -apple-system, sans-serif';
        ctx.fillText(s.value, sx + extraColW / 2, sy + 32);
      });
      y += 56;

      if (animal.class || animal.order || animal.family) {
        ctx.fillStyle = '#f9fafb';
        ctx.beginPath();
        ctx.roundRect(28, y, W - 56, 64, 10);
        ctx.fill();
        ctx.strokeStyle = '#e5e7eb';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(28, y, W - 56, 64, 10);
        ctx.stroke();
        ctx.fillStyle = '#6b7280';
        ctx.font = 'bold 10px system-ui, -apple-system, sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText('🧬 ' + t.taxonomy, 40, y + 18);
        const taxItems = [
          { label: t.taxClass, value: translateVal(animal.class, 'class') || animal.class },
          { label: t.taxOrder, value: animal.order },
          { label: t.taxFamily, value: animal.family },
        ].filter(x => x.value);
        const taxColW = (W - 80) / Math.max(taxItems.length, 1);
        taxItems.forEach((item, i) => {
          ctx.fillStyle = '#6b7280';
          ctx.font = '11px system-ui, -apple-system, sans-serif';
          ctx.textAlign = 'left';
          ctx.fillText(item.label, 40 + i * taxColW, y + 36);
          ctx.fillStyle = '#111827';
          ctx.font = 'bold 12px system-ui, -apple-system, sans-serif';
          ctx.fillText(item.value || '—', 40 + i * taxColW, y + 52);
        });
        y += 76;
      }

      const funFact = getAnimalFunFact(animal);
      ctx.fillStyle = '#eff6ff';
      ctx.beginPath();
      ctx.roundRect(28, y, W - 56, 56, 10);
      ctx.fill();
      ctx.strokeStyle = '#bfdbfe';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.roundRect(28, y, W - 56, 56, 10);
      ctx.stroke();
      ctx.fillStyle = '#2563eb';
      ctx.font = 'bold 10px system-ui, -apple-system, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('💡 ' + t.funFact, 40, y + 18);
      ctx.fillStyle = '#374151';
      ctx.font = '12px system-ui, -apple-system, sans-serif';
      const factLines = wrapText(ctx, funFact, W - 80);
      factLines.slice(0, 2).forEach((line, i) => {
        ctx.fillText(line, 40, y + 34 + i * 16);
      });
      y += 72;

      ctx.strokeStyle = '#e5e7eb';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(28, y);
      ctx.lineTo(W - 28, y);
      ctx.stroke();
      y += 14;

      ctx.textAlign = 'center';
      ctx.fillStyle = '#9ca3af';
      ctx.font = '11px system-ui, -apple-system, sans-serif';
      ctx.fillText('bestrandomanimalgenerator.com', W / 2, y + 10);

      canvas.toBlob((blob) => {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${getAnimalName(animal).toLowerCase().replace(/\s+/g, '-')}.png`;
        a.click();
        URL.revokeObjectURL(url);
        btn.innerHTML = `<span>✓</span> <span id="btn-download-text">${t.saved}</span>`;
        setTimeout(() => { btn.innerHTML = `<span>📥</span> <span id="btn-download-text">${t.download}</span>`; }, 2000);
      }, 'image/png');
    } catch (e) {
      console.error('Download error:', e);
      btn.innerHTML = `<span>📥</span> <span id="btn-download-text">${t.download}</span>`;
    }
  };

  function wrapText(ctx, text, maxW) {
    const words = text.split(' ');
    const lines = [];
    let line = '';
    for (const word of words) {
      const test = line ? line + ' ' + word : word;
      if (ctx.measureText(test).width > maxW && line) {
        lines.push(line);
        line = word;
      } else {
        line = test;
      }
    }
    if (line) lines.push(line);
    return lines;
  }

  card.classList.add('animate-fade-in');
};
</script>
