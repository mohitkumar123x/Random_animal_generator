  optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="copy"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-violet-100 text-sm dark:bg-violet-500/20">📋</span><div><p class="font-semibold">${t.copyLink}</p></div></button>`;
  optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="twitter"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-100 text-sm dark:bg-sky-500/20">𝕏</span><div><p class="font-semibold">${t.shareTwitter}</p></div></button>`;
  optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="facebook"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-sm dark:bg-blue-500/20">f</span><div><p class="font-semibold">${t.shareFacebook}</p></div></button>`;
  optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="whatsapp"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-green-100 text-sm dark:bg-green-500/20">💬</span><div><p class="font-semibold">${t.shareWhatsApp}</p></div></button>`;
  optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="pinterest"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-red-100 text-sm dark:bg-red-500/20">📌</span><div><p class="font-semibold">${t.sharePinterest}</p></div></button>`;
  optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10" data-action="email"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-sm dark:bg-amber-500/20">✉️</span><div><p class="font-semibold">${t.shareEmail}</p></div></button>`;
  if (nativeShare) {
    optionsHtml += `<button class="share-opt flex items-center gap-2.5 rounded-xl border border-hairline bg-canvas p-3 text-left text-xs font-medium text-ink transition-all hover:bg-blue-50 dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:hover:bg-blue-500/10 col-span-2" data-action="native"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-sm dark:bg-gray-500/20">📲</span><div><p class="font-semibold">${t.nativeShare}</p></div></button>`;
  }
  document.getElementById('share-popup-options').innerHTML = optionsHtml;
  document.querySelectorAll('.share-opt').forEach(btn => {
    btn.onclick = () => {
      const action = btn.dataset.action;
      if (action === 'copy') { navigator.clipboard?.writeText(shareUrl); btn.querySelector('p').textContent = '✓ ' + t.copyLink; setTimeout(() => { btn.querySelector('p').textContent = t.copyLink; }, 2000); return; }
      if (action === 'twitter') window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`, '_blank', 'width=550,height=450');
      if (action === 'facebook') window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`, '_blank', 'width=550,height=450');
      if (action === 'whatsapp') window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + ' ' + shareUrl)}`, '_blank');
      if (action === 'pinterest') window.open(`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(shareUrl)}&description=${encodeURIComponent(shareText)}`, '_blank', 'width=550,height=450');
      if (action === 'email') window.location.href = `mailto:?subject=${encodeURIComponent(shareTitle)}&body=${encodeURIComponent(shareText + '\n\n' + shareUrl)}`;
      if (action === 'native') navigator.share({ title: shareTitle, text: shareText, url: shareUrl }).catch(() => {});
      closeSharePopup();
    };
  });
  overlay.classList.remove('hidden');
};

