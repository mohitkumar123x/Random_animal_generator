---
---

<div id="animal-card-container" class="relative">
  <div id="animal-placeholder" class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-hairline bg-hairline-soft/50 py-20 dark:border-[#333] dark:bg-[#111]">
    <span class="text-6xl mb-4 animate-pulse-gentle">🐾</span>
    <p class="text-sm text-muted">Press <kbd class="rounded border border-hairline bg-canvas-elevated px-1.5 py-0.5 font-mono text-faint dark:border-[#333] dark:bg-[#1a1a1a]">Space</kbd> or tap the button to generate</p>
  </div>

  <div id="animal-card" class="hidden">
    <div class="rounded-2xl border border-hairline bg-canvas-elevated overflow-hidden dark:border-[#333] dark:bg-[#1a1a1a]">
      <div class="relative bg-gradient-to-br from-link-soft/50 via-violet-soft/30 to-pink-soft/30 p-6 text-center sm:p-8 dark:from-[#1a2744] dark:via-[#2a1a3a] dark:to-[#3a1a2a]">
        <div id="card-emoji" class="text-7xl mb-3 emoji-icon sm:text-8xl"></div>
        <h2 id="card-name" class="text-xl font-bold tracking-tight text-ink sm:text-2xl dark:text-[#ededed]"></h2>
        <p id="card-scientific" class="text-xs italic text-muted mt-1 sm:text-sm"></p>
        <div id="card-conservation" class="mt-2 inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium"></div>
      </div>

      <div class="p-4 sm:p-5">
        <p id="card-description" class="text-xs text-body leading-relaxed mb-4 sm:text-sm dark:text-[#a1a1a1]"></p>

        <div class="grid grid-cols-2 gap-2 mb-4 sm:gap-3">
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas p-2.5 sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <span class="text-base">🌍</span>
            <div class="min-w-0">
              <p class="text-[10px] uppercase tracking-wider text-faint">Habitat</p>
              <p id="card-habitat" class="text-xs font-medium text-ink truncate dark:text-[#ededed]"></p>
            </div>
          </div>
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas p-2.5 sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <span class="text-base">🍽️</span>
            <div class="min-w-0">
              <p class="text-[10px] uppercase tracking-wider text-faint">Diet</p>
              <p id="card-diet" class="text-xs font-medium text-ink truncate dark:text-[#ededed]"></p>
            </div>
          </div>
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas p-2.5 sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <span class="text-base">⏱️</span>
            <div class="min-w-0">
              <p class="text-[10px] uppercase tracking-wider text-faint">Lifespan</p>
              <p id="card-lifespan" class="text-xs font-medium text-ink truncate dark:text-[#ededed]"></p>
            </div>
          </div>
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas p-2.5 sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <span class="text-base">⚖️</span>
            <div class="min-w-0">
              <p class="text-[10px] uppercase tracking-wider text-faint">Weight</p>
              <p id="card-weight" class="text-xs font-medium text-ink truncate dark:text-[#ededed]"></p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-2 mb-4 sm:gap-3">
          <div class="rounded-lg border border-hairline bg-canvas p-2 text-center sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <p class="text-[10px] uppercase tracking-wider text-faint mb-1">Speed</p>
            <p id="card-speed" class="text-xs font-semibold text-ink sm:text-sm dark:text-[#ededed]"></p>
          </div>
          <div class="rounded-lg border border-hairline bg-canvas p-2 text-center sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <p class="text-[10px] uppercase tracking-wider text-faint mb-1">Length</p>
            <p id="card-length" class="text-xs font-semibold text-ink sm:text-sm dark:text-[#ededed]"></p>
          </div>
          <div class="rounded-lg border border-hairline bg-canvas p-2 text-center sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <p class="text-[10px] uppercase tracking-wider text-faint mb-1">Region</p>
            <p id="card-region" class="text-xs font-semibold text-ink sm:text-sm dark:text-[#ededed]"></p>
          </div>
        </div>

        <div id="card-taxonomy" class="mb-4 rounded-lg border border-hairline bg-canvas p-3 dark:border-[#333] dark:bg-[#111]">
          <p class="text-[10px] uppercase tracking-wider text-faint mb-2">🧬 Taxonomy</p>
          <div class="grid grid-cols-1 gap-1.5 text-xs sm:grid-cols-3 sm:gap-2">
            <div class="flex items-center gap-1"><span class="text-faint">Class:</span> <span id="card-class" class="font-medium text-ink dark:text-[#ededed]"></span></div>
            <div class="flex items-center gap-1"><span class="text-faint">Order:</span> <span id="card-order" class="font-medium text-ink dark:text-[#ededed]"></span></div>
            <div class="flex items-center gap-1"><span class="text-faint">Family:</span> <span id="card-family" class="font-medium text-ink dark:text-[#ededed]"></span></div>
          </div>
        </div>

        <div class="rounded-xl border border-link-soft bg-link-soft/30 p-3 dark:border-[#1e3a5f] dark:bg-[#0f1f33]">
          <p class="text-[10px] uppercase tracking-wider text-link font-medium mb-1 dark:text-link">💡 Fun Fact</p>
          <p id="card-funfact" class="text-xs text-body leading-relaxed dark:text-[#a1a1a1]"></p>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <button id="btn-favorite" class="group flex items-center justify-center gap-1.5 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2.5 text-xs font-medium text-rose-600 transition-all hover:bg-rose-100 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-400 dark:hover:bg-rose-500/20">
            <span class="transition-transform group-hover:scale-110">♡</span> Save
          </button>
          <button id="btn-share" class="group flex items-center justify-center gap-1.5 rounded-xl border border-blue-200 bg-blue-50 px-3 py-2.5 text-xs font-medium text-blue-600 transition-all hover:bg-blue-100 dark:border-blue-500/30 dark:bg-blue-500/10 dark:text-blue-400 dark:hover:bg-blue-500/20">
            <span class="transition-transform group-hover:scale-110">🔗</span> Share
          </button>
          <button id="btn-copy" class="group flex items-center justify-center gap-1.5 rounded-xl border border-violet-200 bg-violet-50 px-3 py-2.5 text-xs font-medium text-violet-600 transition-all hover:bg-violet-100 dark:border-violet-500/30 dark:bg-violet-500/10 dark:text-violet-400 dark:hover:bg-violet-500/20">
            <span class="transition-transform group-hover:scale-110">📋</span> Copy
          </button>
          <button id="btn-download" class="group flex items-center justify-center gap-1.5 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-xs font-medium text-emerald-600 transition-all hover:bg-emerald-100 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-400 dark:hover:bg-emerald-500/20">
            <span class="transition-transform group-hover:scale-110">📥</span> Download
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
const conservationLabels = {
  LC: { text: 'Least Concern', color: 'bg-conservation-lc/15 text-conservation-lc border border-conservation-lc/30' },
  NT: { text: 'Near Threatened', color: 'bg-conservation-nt/15 text-conservation-nt border border-conservation-nt/30' },
  VU: { text: 'Vulnerable', color: 'bg-conservation-vu/15 text-conservation-vu border border-conservation-vu/30' },
  EN: { text: 'Endangered', color: 'bg-conservation-en/15 text-conservation-en border border-conservation-en/30' },
  CR: { text: 'Critically Endangered', color: 'bg-conservation-cr/15 text-conservation-cr border border-conservation-cr/30' },
  EW: { text: 'Extinct in Wild', color: 'bg-conservation-ew/15 text-conservation-ew border border-conservation-ew/30' },
  EX: { text: 'Extinct', color: 'bg-conservation-ex/15 text-conservation-ex border border-conservation-ex/30' },
  DD: { text: 'Data Deficient', color: 'bg-muted/15 text-muted border border-muted/30' },
};

window.displayAnimal = function(animal) {
  document.getElementById('animal-placeholder')?.classList.add('hidden');
  const card = document.getElementById('animal-card');
  if (!card) return;
  card.classList.remove('hidden');

  document.getElementById('card-emoji').textContent = animal.emoji;
  document.getElementById('card-name').textContent = animal.name;
  const sciEl = document.getElementById('card-scientific');
  sciEl.textContent = animal.scientificName || '';
  sciEl.classList.toggle('hidden', !animal.scientificName);

  const cons = conservationLabels[animal.conservation] || conservationLabels.LC;
  const consEl = document.getElementById('card-conservation');
  consEl.textContent = cons.text;
  consEl.className = `mt-2 inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium ${cons.color}`;

  document.getElementById('card-description').textContent = animal.description;
  document.getElementById('card-habitat').textContent = animal.habitat;
  document.getElementById('card-diet').textContent = animal.diet;
  document.getElementById('card-lifespan').textContent = animal.lifespan;
  document.getElementById('card-weight').textContent = animal.weight;
  document.getElementById('card-speed').textContent = animal.speed;
  document.getElementById('card-length').textContent = animal.length;
  document.getElementById('card-region').textContent = animal.region;
  document.getElementById('card-funfact').textContent = animal.funFact;
  document.getElementById('card-class').textContent = animal.class || '—';
  document.getElementById('card-order').textContent = animal.order || '—';
  document.getElementById('card-family').textContent = animal.family || '—';

  document.getElementById('btn-favorite').onclick = () => {
    const favs = JSON.parse(localStorage.getItem('favorites') || '[]');
    const exists = favs.find(f => f.id === animal.id);
    if (!exists) {
      favs.unshift(animal);
      localStorage.setItem('favorites', JSON.stringify(favs.slice(0, 50)));
      document.getElementById('btn-favorite').innerHTML = '<span>♥</span> Saved';
    } else {
      localStorage.setItem('favorites', JSON.stringify(favs.filter(f => f.id !== animal.id)));
      document.getElementById('btn-favorite').innerHTML = '<span>♡</span> Save';
    }
  };

  document.getElementById('btn-share').onclick = () => {
    const url = new URL(window.location.href);
    url.searchParams.set('animal', animal.id);
    navigator.clipboard?.writeText(url.toString());
    document.getElementById('btn-share').innerHTML = '<span>✓</span> Copied!';
    setTimeout(() => {
      document.getElementById('btn-share').innerHTML = '<span>🔗</span> Share';
    }, 2000);
  };

  document.getElementById('btn-copy').onclick = () => {
    const text = `${animal.emoji} ${animal.name}\n${animal.description}\n\nFun Fact: ${animal.funFact}\n\nHabitat: ${animal.habitat} | Diet: ${animal.diet} | Lifespan: ${animal.lifespan}`;
    navigator.clipboard?.writeText(text);
    document.getElementById('btn-copy').innerHTML = '<span>✓</span> Copied!';
    setTimeout(() => {
      document.getElementById('btn-copy').innerHTML = '<span>📋</span> Copy';
    }, 2000);
  };

  document.getElementById('btn-download').onclick = () => {
    const cardEl = document.getElementById('animal-card')?.querySelector('.rounded-2xl');
    if (!cardEl) return;
    const btn = document.getElementById('btn-download');
    btn.innerHTML = '<span>⏳</span> Saving...';
    const svgData = `<svg xmlns="http://www.w3.org/2000/svg" width="600" height="800">
      <foreignObject width="100%" height="100%">
        <div xmlns="http://www.w3.org/1999/xhtml" style="font-family:system-ui,-apple-system,sans-serif;background:#fff;padding:32px;width:536px;">
          <div style="text-align:center;padding:24px 0;border-radius:16px;background:linear-gradient(135deg,#d3e5ff50,#7928ca30,#ff008030);">
            <div style="font-size:72px;margin-bottom:8px;">${animal.emoji}</div>
            <h2 style="margin:0;font-size:24px;font-weight:700;">${animal.name}</h2>
            <div style="margin-top:8px;display:inline-block;padding:2px 10px;border-radius:999px;font-size:12px;background:#22c55e20;color:#22c55e;">${conservationLabels[animal.conservation]?.text || animal.conservation}</div>
          </div>
          <p style="font-size:14px;color:#4d4d4d;line-height:1.6;margin:16px 0;">${animal.description}</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:13px;margin-bottom:12px;">
            <div style="padding:8px;border:1px solid #ebebeb;border-radius:8px;"><strong>Habitat:</strong> ${animal.habitat}</div>
            <div style="padding:8px;border:1px solid #ebebeb;border-radius:8px;"><strong>Diet:</strong> ${animal.diet}</div>
            <div style="padding:8px;border:1px solid #ebebeb;border-radius:8px;"><strong>Lifespan:</strong> ${animal.lifespan}</div>
            <div style="padding:8px;border:1px solid #ebebeb;border-radius:8px;"><strong>Weight:</strong> ${animal.weight}</div>
          </div>
          <div style="padding:10px;border:1px solid #d3e5ff;border-radius:8px;background:#d3e5ff30;font-size:13px;">
            <strong>Fun Fact:</strong> ${animal.funFact}
          </div>
          <p style="font-size:11px;color:#8f8f8f;text-align:center;margin-top:16px;">Random Animal Generator</p>
        </div>
      </foreignObject>
    </svg>`;
    const blob = new Blob([svgData], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${animal.name.toLowerCase().replace(/\s+/g, '-')}.svg`;
    a.click();
    URL.revokeObjectURL(url);
    btn.innerHTML = '<span>✓</span> Saved!';
    setTimeout(() => {
      btn.innerHTML = '<span>📥</span> Download';
    }, 2000);
  };

  card.classList.add('animate-fade-in');
};
</script>
