---
import { getTranslations } from '../utils/i18n';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale as any);
---

<div id="animal-card-container" class="relative">
  <div id="animal-placeholder" class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-hairline bg-hairline-soft/50 py-20 dark:border-[#333] dark:bg-[#111]">
    <span class="text-6xl mb-4 animate-pulse-gentle">🐾</span>
    <p id="placeholder-text" class="text-sm text-muted" set:html={t.placeholder || 'Press <kbd class="rounded border border-hairline bg-canvas-elevated px-1.5 py-0.5 font-mono text-faint dark:border-[#333] dark:bg-[#1a1a1a]">Space</kbd> or tap the button to generate'}></p>
  </div>

  <div id="animal-card" class="hidden">
    <div class="rounded-2xl border border-hairline bg-canvas-elevated overflow-hidden dark:border-[#333] dark:bg-[#1a1a1a]">
      <div class="relative bg-gradient-to-br from-link-soft/50 via-violet-soft/30 to-pink-soft/30 p-6 text-center sm:p-8 dark:from-[#1a2744] dark:via-[#2a1a3a] dark:to-[#3a1a2a]">
        <div id="card-emoji" class="text-7xl mb-3 emoji-icon sm:text-8xl"></div>
        <div id="card-image-wrapper" class="relative mb-3 hidden">
          <div id="card-image-skeleton" class="image-skeleton mx-auto" style="width:280px;height:180px;"></div>
          <img id="card-image" class="mx-auto rounded-xl object-cover shadow-md hidden" style="width:280px;height:180px;" alt="" />
          <button id="btn-fullscreen" class="absolute bottom-2 right-2 flex items-center gap-1.5 rounded-lg bg-black/60 px-2.5 py-1.5 text-[11px] font-medium text-white backdrop-blur-sm transition-all hover:bg-black/80 hover:scale-105" title={t.fullscreen || "Fullscreen"}>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
            <span id="btn-fullscreen-text">{t.fullscreen || 'Fullscreen'}</span>
          </button>
          <p id="card-image-credit" class="absolute bottom-2 left-2 text-[10px] text-white/70 hidden"><a id="card-image-credit-link" href="#" target="_blank" rel="noopener noreferrer" class="hover:text-white/90"></a></p>
        </div>
        <h2 id="card-name" class="text-xl font-bold tracking-tight text-ink sm:text-2xl dark:text-[#ededed]"></h2>
        <p id="card-scientific" class="text-xs italic text-muted mt-1 sm:text-sm"></p>
        <div id="card-conservation" class="mt-2 inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium"></div>
      </div>

      <div class="p-4 sm:p-5">
        <p id="card-description" class="text-xs text-body leading-relaxed mb-4 sm:text-sm dark:text-[#a1a1a1]"></p>

        <div class="grid grid-cols-2 gap-2 mb-4 sm:gap-3">
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas p-2.5 sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <span class="text-base">🌍</span>
            <div class="min-w-0">
              <p id="label-habitat" class="text-[10px] uppercase tracking-wider text-faint">{t.habitat}</p>
              <p id="card-habitat" class="text-xs font-medium text-ink dark:text-[#ededed]"></p>
            </div>
          </div>
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas p-2.5 sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <span class="text-base">🍽️</span>
            <div class="min-w-0">
              <p id="label-diet" class="text-[10px] uppercase tracking-wider text-faint">{t.diet}</p>
              <p id="card-diet" class="text-xs font-medium text-ink dark:text-[#ededed]"></p>
            </div>
          </div>
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas p-2.5 sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <span class="text-base">⏱️</span>
            <div class="min-w-0">
              <p id="label-lifespan" class="text-[10px] uppercase tracking-wider text-faint">{t.lifespan}</p>
              <p id="card-lifespan" class="text-xs font-medium text-ink dark:text-[#ededed]"></p>
            </div>
          </div>
          <div class="flex items-center gap-2 rounded-lg border border-hairline bg-canvas p-2.5 sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <span class="text-base">⚖️</span>
            <div class="min-w-0">
              <p id="label-weight" class="text-[10px] uppercase tracking-wider text-faint">{t.weight}</p>
              <p id="card-weight" class="text-xs font-medium text-ink dark:text-[#ededed]"></p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-2 mb-4 sm:gap-3">
          <div class="rounded-lg border border-hairline bg-canvas p-2 text-center sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <p id="label-speed" class="text-[10px] uppercase tracking-wider text-faint mb-1">{t.speed}</p>
            <p id="card-speed" class="text-xs font-semibold text-ink sm:text-sm dark:text-[#ededed]"></p>
          </div>
          <div class="rounded-lg border border-hairline bg-canvas p-2 text-center sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <p id="label-length" class="text-[10px] uppercase tracking-wider text-faint mb-1">{t.length}</p>
            <p id="card-length" class="text-xs font-semibold text-ink sm:text-sm dark:text-[#ededed]"></p>
          </div>
          <div class="rounded-lg border border-hairline bg-canvas p-2 text-center sm:p-3 dark:border-[#333] dark:bg-[#111]">
            <p id="label-region" class="text-[10px] uppercase tracking-wider text-faint mb-1">{t.region}</p>
            <p id="card-region" class="text-xs font-semibold text-ink sm:text-sm dark:text-[#ededed]"></p>
          </div>
        </div>

        <div id="card-taxonomy" class="mb-4 rounded-lg border border-hairline bg-canvas p-3 dark:border-[#333] dark:bg-[#111]">
          <p id="label-taxonomy" class="text-[10px] uppercase tracking-wider text-faint mb-2">🧬 {t.taxonomy}</p>
          <div class="grid grid-cols-1 gap-1.5 text-xs sm:grid-cols-3 sm:gap-2">
            <div class="flex items-center gap-1"><span id="label-class" class="text-faint">{t.tax_class}</span> <span id="card-class" class="font-medium text-ink dark:text-[#ededed]"></span></div>
            <div class="flex items-center gap-1"><span id="label-order" class="text-faint">{t.tax_order}</span> <span id="card-order" class="font-medium text-ink dark:text-[#ededed]"></span></div>
            <div class="flex items-center gap-1"><span id="label-family" class="text-faint">{t.tax_family}</span> <span id="card-family" class="font-medium text-ink dark:text-[#ededed]"></span></div>
          </div>
        </div>

        <div class="rounded-xl border border-link-soft bg-link-soft/30 p-3 dark:border-[#1e3a5f] dark:bg-[#0f1f33]">
          <p id="label-funfact" class="text-[10px] uppercase tracking-wider text-link font-medium mb-1 dark:text-link">💡 {t.fun_fact}</p>
          <p id="card-funfact" class="text-xs text-body leading-relaxed dark:text-[#a1a1a1]"></p>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <button id="btn-favorite" class="group flex items-center justify-center gap-1.5 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2.5 text-xs font-medium text-rose-600 transition-all hover:bg-rose-100 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-400 dark:hover:bg-rose-500/20">
            <span class="transition-transform group-hover:scale-110">♡</span> <span id="btn-favorite-text">{t.save}</span>
          </button>
          <button id="btn-share" class="group flex items-center justify-center gap-1.5 rounded-xl border border-blue-200 bg-blue-50 px-3 py-2.5 text-xs font-medium text-blue-600 transition-all hover:bg-blue-100 dark:border-blue-500/30 dark:bg-blue-500/10 dark:text-blue-400 dark:hover:bg-blue-500/20">
            <span class="transition-transform group-hover:scale-110">🔗</span> <span id="btn-share-text">{t.share}</span>
          </button>
          <button id="btn-copy" class="group flex items-center justify-center gap-1.5 rounded-xl border border-violet-200 bg-violet-50 px-3 py-2.5 text-xs font-medium text-violet-600 transition-all hover:bg-violet-100 dark:border-violet-500/30 dark:bg-violet-500/10 dark:text-violet-400 dark:hover:bg-violet-500/20">
            <span class="transition-transform group-hover:scale-110">📋</span> <span id="btn-copy-text">{t.copy}</span>
          </button>
          <button id="btn-download" class="group flex items-center justify-center gap-1.5 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-xs font-medium text-emerald-600 transition-all hover:bg-emerald-100 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-400 dark:hover:bg-emerald-500/20">
            <span class="transition-transform group-hover:scale-110">📥</span> <span id="btn-download-text">{t.download}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="share-popup-overlay" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4" style="backdrop-filter:blur(4px);">
  <div class="w-full max-w-sm rounded-2xl border border-hairline bg-canvas-elevated shadow-2xl dark:border-[#333] dark:bg-[#1a1a1a]">
    <div class="flex items-center justify-between border-b border-hairline p-4 dark:border-[#333]">
      <h3 id="share-popup-title" class="text-sm font-bold text-ink dark:text-[#ededed]"></h3>
      <button id="share-popup-close" class="flex h-7 w-7 items-center justify-center rounded-lg text-muted hover:bg-hairline hover:text-ink dark:hover:bg-[#333] dark:hover:text-[#ededed]">✕</button>
    </div>
    <div class="p-4">
      <div id="share-popup-animal-info" class="mb-4 flex items-center gap-3 rounded-xl border border-hairline bg-canvas p-3 dark:border-[#333] dark:bg-[#111]"></div>
      <div id="share-popup-options" class="grid grid-cols-2 gap-2"></div>
    </div>
  </div>
</div>

<div id="fullscreen-overlay" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4 cursor-zoom-out" style="backdrop-filter:blur(8px);">
  <button id="fullscreen-close" class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors z-10">
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
  </button>
  <img id="fullscreen-img" class="max-h-[90vh] max-w-[90vw] rounded-2xl object-contain shadow-2xl" alt="" />
</div>

<script is:inline>
if (!window.__downloadAnimalCard) {
  window.__downloadAnimalCard = function(animal, labels, translatedName, translateFn, btn) {
    btn.innerHTML = '<span>⏳</span> ' + labels.saving;
    const W = 600, H = 1060;
    const canvas = document.createElement('canvas');
    canvas.width = W * 2; canvas.height = H * 2;
    const ctx = canvas.getContext('2d');
    ctx.scale(2, 2);
    ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, W, H);
    const grad = ctx.createLinearGradient(0, 0, W, H);
    grad.addColorStop(0, '#eef2ff'); grad.addColorStop(0.5, '#f3e8ff'); grad.addColorStop(1, '#fce7f3');
    ctx.fillStyle = grad; ctx.beginPath(); ctx.roundRect(0, 0, W, H, 24); ctx.fill();
    let y = 28;
    function wrapT(text, maxW) {
      const words = text.split(' '), lines = []; let line = '';
      for (const w of words) { const test = line ? line + ' ' + w : w; if (ctx.measureText(test).width > maxW) { if (line) lines.push(line); line = w; } else { line = test; } }
      if (line) lines.push(line); return lines;
    }
    const cache = JSON.parse(localStorage.getItem('pexelsImageCache') || '{}');
    const entry = cache[animal.name.toLowerCase().trim()];
    const imgUrl = typeof entry === 'string' ? entry : (entry && entry.url);
    function drawImageOrEmoji(imgEl) {
      if (imgEl) {
        const containerW = W - 56;
        const containerH = 300;
        const imgX = 28, imgY = y;

        ctx.save();
        ctx.beginPath();
        ctx.roundRect(imgX, imgY, containerW, containerH, 16);
        ctx.clip();

        // Ambient matching background frame
        const bgScale = Math.max(containerW / imgEl.width, containerH / imgEl.height);
        const bgW = imgEl.width * bgScale;
        const bgH = imgEl.height * bgScale;
        ctx.drawImage(imgEl, imgX + (containerW - bgW) / 2, imgY + (containerH - bgH) / 2, bgW, bgH);

        ctx.fillStyle = 'rgba(15, 23, 42, 0.78)';
        ctx.fillRect(imgX, imgY, containerW, containerH);

        // Entire uncropped sharp image centered inside
        const scale = Math.min((containerW - 16) / imgEl.width, (containerH - 16) / imgEl.height);
        const drawW = Math.round(imgEl.width * scale);
        const drawH = Math.round(imgEl.height * scale);
        const drawX = Math.round(imgX + (containerW - drawW) / 2);
        const drawY = Math.round(imgY + (containerH - drawH) / 2);

        ctx.save();
        ctx.beginPath();
        ctx.roundRect(drawX, drawY, drawW, drawH, 10);
        ctx.clip();
        ctx.drawImage(imgEl, drawX, drawY, drawW, drawH);
        ctx.restore();

        ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect(imgX, imgY, containerW, containerH, 16);
        ctx.stroke();

        ctx.restore();
        y += containerH + 20;
      } else {
        ctx.font = '64px sans-serif'; ctx.textAlign = 'center'; ctx.fillText(animal.emoji, W/2, y+64); y += 84;
      }
      finishCard(animal, labels, translatedName, translateFn, btn, ctx, W, y, wrapT);
    }
    async function resolveAndDraw() {
      let finalUrl = imgUrl;
      if (!finalUrl && typeof fetchAnimalImage === 'function') {
        try {
          const fetched = await fetchAnimalImage(animal.name);
          if (fetched && fetched.url) finalUrl = fetched.url;
        } catch(e) {}
      }
      if (finalUrl) {
        fetch(finalUrl).then(r => r.blob()).then(blob => {
          const objUrl = URL.createObjectURL(blob);
          const el = new Image();
          el.onload = function() { drawImageOrEmoji(el); URL.revokeObjectURL(objUrl); };
          el.onerror = function() { drawImageOrEmoji(null); URL.revokeObjectURL(objUrl); };
          el.src = objUrl;
        }).catch(() => {
          const el = new Image();
          el.crossOrigin = 'anonymous';
          el.onload = function() { drawImageOrEmoji(el); };
          el.onerror = function() { drawImageOrEmoji(null); };
          el.src = finalUrl;
        });
      } else {
        drawImageOrEmoji(null);
      }
    }
    resolveAndDraw();
    function finishCard(a, lb, tn, tf, b, ctx, W, y, wrapT) {
      ctx.textAlign = 'center'; ctx.fillStyle = '#111827'; ctx.font = 'bold 26px system-ui, -apple-system, sans-serif';
      ctx.fillText(tn, W/2, y+28); y += 36;
      if (a.scientificName) { ctx.fillStyle = '#6b7280'; ctx.font = 'italic 13px system-ui, -apple-system, sans-serif'; ctx.fillText(a.scientificName, W/2, y+14); y += 20; }
      const ck = a.conservation || 'LC'; const cb = lb.conservation[ck] || lb.conservation.LC;
      const cm = {LC:'#16a34a',NT:'#65a30d',VU:'#d97706',EN:'#ea580c',CR:'#dc2626',EW:'#7c3aed',EX:'#6b7280',DD:'#9ca3af'};
      const cbg = {LC:'#dcfce7',NT:'#ecfccb',VU:'#fef3c7',EN:'#ffedd5',CR:'#fee2e2',EW:'#ede9fe',EX:'#f3f4f6',DD:'#f3f4f6'};
      ctx.font = 'bold 12px system-ui'; const bw = ctx.measureText(cb.text).width+20;
      ctx.fillStyle = cbg[ck]||'#dcfce7'; ctx.beginPath(); ctx.roundRect((W-bw)/2, y+4, bw, 22, 11); ctx.fill();
      ctx.fillStyle = cm[ck]||'#16a34a'; ctx.textAlign = 'center'; ctx.fillText(cb.text, W/2, y+19); y += 34;
      ctx.textAlign = 'left'; ctx.fillStyle = '#374151'; ctx.font = '13px system-ui';
      wrapT(a.description, W-56).slice(0,4).forEach((l,i) => ctx.fillText(l, 28, y+14+i*18));
      y += Math.min(wrapT(a.description, W-56).length, 4)*18+20;
      const sg = [{icon:'🌍',label:lb.habitat,value:tf(a.habitat,'habitat')},{icon:'🍽️',label:lb.diet,value:tf(a.diet,'diet')},{icon:'⏱️',label:lb.lifespan,value:tf(a.lifespan,'lifespan')||a.lifespan.replace(/\byears?\b/gi, lb.years)},{icon:'⚖️',label:lb.weight,value:a.weight}];
      const cw = (W-56-12)/2;
      sg.forEach((s,i) => { const col=i%2,row=Math.floor(i/2),sx=28+col*(cw+12),sy=y+row*48;
        ctx.fillStyle='#f9fafb'; ctx.beginPath(); ctx.roundRect(sx,sy,cw,42,8); ctx.fill();
        ctx.strokeStyle='#e5e7eb'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(sx,sy,cw,42,8); ctx.stroke();
        ctx.fillStyle='#6b7280'; ctx.font='10px system-ui'; ctx.textAlign='left'; ctx.fillText(s.icon+' '+s.label,sx+10,sy+16);
        ctx.fillStyle='#111827'; ctx.font='bold 12px system-ui'; ctx.fillText(s.value,sx+10,sy+32);
      }); y += 100;
      const es = [{icon:'⚡',label:lb.speed,value:a.speed||'—'},{icon:'📏',label:lb.length,value:a.length||'—'},{icon:'🌐',label:lb.region,value:tf(a.region||'','region')}];
      const ecw = (W-56-16)/3;
      es.forEach((s,i) => { const sx=28+i*(ecw+8),sy=y;
        ctx.fillStyle='#f0fdf4'; ctx.beginPath(); ctx.roundRect(sx,sy,ecw,42,8); ctx.fill();
        ctx.strokeStyle='#bbf7d0'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(sx,sy,ecw,42,8); ctx.stroke();
        ctx.fillStyle='#6b7280'; ctx.font='10px system-ui'; ctx.textAlign='center'; ctx.fillText(s.icon+' '+s.label,sx+ecw/2,sy+16);
        ctx.fillStyle='#111827'; ctx.font='bold 12px system-ui'; ctx.fillText(s.value,sx+ecw/2,sy+32);
      }); y += 56;
      if (a.class||a.order||a.family) {
        ctx.fillStyle='#f9fafb'; ctx.beginPath(); ctx.roundRect(28,y,W-56,64,10); ctx.fill();
        ctx.strokeStyle='#e5e7eb'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(28,y,W-56,64,10); ctx.stroke();
        ctx.fillStyle='#6b7280'; ctx.font='bold 10px system-ui'; ctx.textAlign='left'; ctx.fillText('🧬 '+lb.taxonomy,40,y+18);
        const ti=[{l:lb.taxClass,v:tf(a.class,'class')||a.class},{l:lb.taxOrder,v:a.order},{l:lb.taxFamily,v:a.family}].filter(x=>x.v);
        const tcw=(W-80)/Math.max(ti.length,1);
        ti.forEach((item,i) => { ctx.fillStyle='#6b7280'; ctx.font='11px system-ui'; ctx.textAlign='left'; ctx.fillText(item.l,40+i*tcw,y+36);
          ctx.fillStyle='#111827'; ctx.font='bold 12px system-ui'; ctx.fillText(item.v||'—',40+i*tcw,y+52); }); y+=76;
      }
      ctx.fillStyle='#eff6ff'; ctx.beginPath(); ctx.roundRect(28,y,W-56,56,10); ctx.fill();
      ctx.strokeStyle='#bfdbfe'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(28,y,W-56,56,10); ctx.stroke();
      ctx.fillStyle='#2563eb'; ctx.font='bold 10px system-ui'; ctx.textAlign='left'; ctx.fillText('💡 '+lb.funFact,40,y+18);
      ctx.fillStyle='#374151'; ctx.font='12px system-ui';
      wrapT(a.funFact,W-80).slice(0,2).forEach((l,i) => ctx.fillText(l,40,y+34+i*16)); y+=72;
      ctx.strokeStyle='#e5e7eb'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(28,y); ctx.lineTo(W-28,y); ctx.stroke(); y+=14;
      ctx.textAlign='center'; ctx.fillStyle='#9ca3af'; ctx.font='11px system-ui'; ctx.fillText('bestrandomanimalgenerator.com',W/2,y+10);
      canvas.toBlob(function(blob) { const url=URL.createObjectURL(blob); const link=document.createElement('a');
        link.href=url; link.download=tn.toLowerCase().replace(/\s+/g,'-')+'.png'; link.click(); URL.revokeObjectURL(url);
        b.innerHTML='<span>✓</span> '+lb.saved; setTimeout(function(){b.innerHTML='<span>📥</span> '+lb.download;},2000);
      }, 'image/png');
    }
  };
}
</script>
<script is:inline>
function getCardT() {
  const t = window.__cardT || {};
  return {
    habitat: t.habitat || 'Habitat',
    diet: t.diet || 'Diet',
    lifespan: t.lifespan || 'Lifespan',
    weight: t.weight || 'Weight',
    speed: t.speed || 'Speed',
    length: t.length || 'Length',
    region: t.region || 'Region',
    taxonomy: t.taxonomy || 'Taxonomy',
    taxClass: t.taxClass || 'Class:',
    taxOrder: t.taxOrder || 'Order:',
    taxFamily: t.taxFamily || 'Family:',
    funFact: t.funFact || 'Fun Fact',
    save: t.save || 'Save',
    share: t.share || 'Share',
    copy: t.copy || 'Copy',
    download: t.download || 'Download',
    years: t.years || 'years',
    copied: t.copied || 'Copied!',
    saving: t.saving || 'Saving...',
    saved: t.saved || 'Saved!',
    shareTitle: t.shareTitle || 'Share this animal',
    copyLink: t.copyLink || 'Copy Link',
    shareTwitter: t.shareTwitter || 'Twitter',
    shareFacebook: t.shareFacebook || 'Facebook',
    shareWhatsApp: t.shareWhatsApp || 'WhatsApp',
    sharePinterest: t.sharePinterest || 'Pinterest',
    shareEmail: t.shareEmail || 'Email',
    nativeShare: t.nativeShare || 'More...',
    consLC: t.consLC || 'Least Concern',
    consNT: t.consNT || 'Near Threatened',
    consVU: t.consVU || 'Vulnerable',
    consEN: t.consEN || 'Endangered',
    consCR: t.consCR || 'Critically Endangered',
    consEW: t.consEW || 'Extinct in Wild',
    consEX: t.consEX || 'Extinct',
    consDD: t.consDD || 'Data Deficient',
    placeholder: t.placeholder || 'Press <kbd class="rounded border border-hairline bg-canvas-elevated px-1.5 py-0.5 font-mono text-faint dark:border-[#333] dark:bg-[#1a1a1a]">Space</kbd> or tap the button to generate',
    fullscreen: t.fullscreen || 'Fullscreen',
    photoBy: t.photoBy || 'Photo by {photographer} on Pexels'
  };
}

function getConservationLabels() {
  const t = getCardT();
  return {
    LC: { text: t.consLC, color: 'bg-conservation-lc/15 text-conservation-lc border border-conservation-lc/30' },
    NT: { text: t.consNT, color: 'bg-conservation-nt/15 text-conservation-nt border border-conservation-nt/30' },
    VU: { text: t.consVU, color: 'bg-conservation-vu/15 text-conservation-vu border border-conservation-vu/30' },
    EN: { text: t.consEN, color: 'bg-conservation-en/15 text-conservation-en border border-conservation-en/30' },
    CR: { text: t.consCR, color: 'bg-conservation-cr/15 text-conservation-cr border border-conservation-cr/30' },
    EW: { text: t.consEW, color: 'bg-conservation-ew/15 text-conservation-ew border border-conservation-ew/30' },
    EX: { text: t.consEX, color: 'bg-conservation-ex/15 text-conservation-ex border border-conservation-ex/30' },
    DD: { text: t.consDD, color: 'bg-muted/15 text-muted border border-muted/30' },
  };
}

function getFavorites() {
  try { return JSON.parse(localStorage.getItem('favorites') || '[]'); } catch (e) { return []; }
}
function isFavorite(id) {
  return getFavorites().some(f => f.id === id);
}
function setFavoriteBtnState(animal) {
  const t = getCardT();
  const btn = document.getElementById('btn-favorite');
  if (!btn) return;
  const saved = isFavorite(animal.id);
  btn.innerHTML = saved
    ? `<span>♥</span> <span id="btn-favorite-text">${t.saved || 'Saved!'}</span>`
    : `<span>♡</span> <span id="btn-favorite-text">${t.save || 'Save'}</span>`;
}
function notifyFavoritesChanged() {
  window.dispatchEvent(new CustomEvent('favorites-changed'));
}

function getAnimalName(animal) {
  const t = window.__animalT;
  return (t && t[animal.id] && t[animal.id].name) || animal.name;
}
function getAnimalDescription(animal) {
  const t = window.__animalT;
  return (t && t[animal.id] && t[animal.id].description) || animal.description;
}
function getAnimalFunFact(animal) {
  const t = window.__animalT;
  return (t && t[animal.id] && t[animal.id].funFact) || animal.funFact;
}
function translateVal(value, field) {
  const locale = window.__cardLocale || 'en';
  if (locale === 'en' || !value) return value;
  const map = window.__valueMaps && window.__valueMaps[field];
  return (map && map[locale] && map[locale][value]) || (map && map[value]) || value;
}

const PEXELS_API_KEY = 'xEfnJ9xU5Fem8MeEPh1zE3lURDVneBkLnPGnrNAjnbMCBAY0LGtdgLFE';
const pexelsCache = JSON.parse(localStorage.getItem('pexelsImageCache') || '{}');
Object.keys(pexelsCache).forEach(k => { if (typeof pexelsCache[k] === 'string') delete pexelsCache[k]; });

async function fetchAnimalImage(animalName) {
  const cacheKey = animalName.toLowerCase().trim();
  if (pexelsCache[cacheKey]) return pexelsCache[cacheKey];
  try {
    const res = await fetch(`https://api.pexels.com/v1/search?query=${encodeURIComponent(animalName)}&per_page=1&orientation=landscape`, {
      headers: { 'Authorization': PEXELS_API_KEY }
    });
    if (!res.ok) return null;
    const data = await res.json();
    if (data.photos && data.photos.length > 0) {
      const photo = data.photos[0];
      const result = {
        url: photo.src.large2x || photo.src.large,
        photographer: photo.photographer || '',
        photoUrl: photo.url || '',
      };
      pexelsCache[cacheKey] = result;
      localStorage.setItem('pexelsImageCache', JSON.stringify(pexelsCache));
      return result;
    }
  } catch (e) { console.error('Pexels fetch error:', e); }
  return null;
}

