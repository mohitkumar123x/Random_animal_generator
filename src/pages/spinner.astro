---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SpinnerContent from '../components/Spinner.astro';
import { getTranslations } from '../utils/i18n';
import animals from '../data/animals.json';

const locale = 'en';
const t = getTranslations(locale);

const SITE_URL = 'https://bestrandomanimalgenerator.com';
const canonical = `${SITE_URL}/spinner`;

// Dataset stats — computed from animals.json so page numbers always match the data.
const totalRecords = animals.length;
const pct = (n: number) => Math.round((n / totalRecords) * 1000) / 10;

const categoryMeta: [string, string][] = [
  ['mammal', 'Mammals'], ['bird', 'Birds'], ['insect', 'Insects'], ['fish', 'Fish'],
  ['marine', 'Marine'], ['reptile', 'Reptiles'], ['amphibian', 'Amphibians'],
  ['prehistoric', 'Prehistoric'], ['fantasy', 'Fantasy'], ['mythical', 'Mythical'],
  ['farm', 'Farm'], ['cute', 'Cute'],
];
const categoryCounts = categoryMeta.map(([cat, label]) => ({
  cat, label, count: animals.filter(a => a.category === cat).length,
}));
const maxCatCount = Math.max(...categoryCounts.map(c => c.count));
const aquaticCount = animals.filter(a => a.category === 'marine' || a.category === 'fish').length;

const fictionalCats = new Set(['mythical', 'fantasy']);
const prehistoricCats = new Set(['prehistoric']);
const fictionalCount = animals.filter(a => fictionalCats.has(a.category)).length;
const prehistoricCount = animals.filter(a => prehistoricCats.has(a.category)).length;
const livingRecords = animals.filter(a => !fictionalCats.has(a.category) && !prehistoricCats.has(a.category));
const livingCount = livingRecords.length;

const statusMeta: [string, string][] = [
  ['LC', 'Least Concern'], ['NT', 'Near Threatened'], ['VU', 'Vulnerable'], ['EN', 'Endangered'],
  ['CR', 'Critically Endangered'], ['EW', 'Extinct in the Wild'], ['EX', 'Extinct'], ['DD', 'Data Deficient'],
];
const statusCounts = statusMeta.map(([code, label]) => ({
  code, label, count: livingRecords.filter(a => a.conservation === code).length,
}));
const maxStatusCount = Math.max(...statusCounts.map(s => s.count));
const threatenedCount = livingRecords.filter(a => ['VU', 'EN', 'CR', 'EW', 'EX'].includes(a.conservation)).length;

const dietNames = ['Carnivore', 'Herbivore', 'Omnivore', 'Insectivore', 'Detritivore', 'Filter feeder'];
const dietCounts = dietNames.map(name => ({
  name, count: animals.filter(a => a.diet === name).length,
}));
const maxDietCount = Math.max(...dietCounts.map(d => d.count));
---

<Layout
  title="Random Animal Spinner Wheel | Best Random Animal Generator"
  description="Spin the random animal generator wheel online and land on a random animal with pictures, fun facts and conservation status. Free animal picker wheel."
  canonical={canonical}
  imageAlt="Random Animal Generator Wheel – colorful spinner wheel that lands on a random animal with a picture, fun fact and conservation status"
  locale={locale}
  pagePath="/spinner"
>
  <Navbar locale={locale} pagePath="/spinner" />
  <SpinnerContent locale={locale} />

  <div class="mx-auto max-w-3xl px-4 pb-14 sm:px-6" id="wheel-guide">
    <section class="space-y-11 text-body" aria-label="About the random animal generator wheel">
      <article>
        <p class="text-sm leading-relaxed dark:text-[#a1a1a1]">
          This page is a free <strong class="font-semibold text-ink dark:text-[#ededed]">random animal generator wheel</strong> — a spinner wheel where every slice stands for an animal. Press Spin, watch the wheel slow down, and the pointer lands on one animal at random. Every slice here is a real animal record with a picture, a profile and a fun fact. Use it as a random animal picker wheel for games, a random animal generator wheel with pictures for lessons, or a quick animal name generator when you need ideas on the spot. Everything runs in your browser, so you can spin the wheel online on a laptop, phone or tablet with no signup and no download.
        </p>
      </article>

      <article>
        <h2 class="mb-4 text-xl font-bold text-ink dark:text-[#ededed]">What Is a Random Animal Generator Wheel?</h2>
        <p class="mb-3 text-sm leading-relaxed dark:text-[#a1a1a1]">
          A random animal generator wheel is a wheel-of-fortune picker in which each slice represents an animal instead of a prize. You press Spin, the wheel turns for a few seconds, and the fixed pointer at the top decides which slice wins. Because a whole group watches the same rotation, the result feels transparent — nobody can claim the pick was biased when everyone saw it land. That visible randomness is the main advantage a random animal generator wheel spinner has over quietly shuffling a list in the background.
        </p>
        <p class="mb-3 text-sm leading-relaxed dark:text-[#a1a1a1]">
          Ours is an online random animal generator wheel tool: nothing to install, print or sign up for. Each spin ends in a full result card with the animal's common name, scientific name, emoji, photograph when one is available, habitat, diet, lifespan, speed, size, region, taxonomy and a short fun fact. Teachers use it to assign species for research, families use it to settle whose turn it is, and artists and writers use it as a prompt generator. The same collection also powers the <a href="/" class="text-link hover:underline">random animal generator on the homepage</a>, the <a href="/quiz" class="text-link hover:underline">animal quiz</a>, and the <a href="/compare" class="text-link hover:underline">animal compare tool</a>.
        </p>
      </article>

      <article>
        <h2 class="mb-4 text-xl font-bold text-ink dark:text-[#ededed]">How the Random Animal Generator Wheel Works, Step by Step</h2>
        <p class="mb-3 text-sm leading-relaxed dark:text-[#a1a1a1]">
          The wheel is deliberately simple, which is what makes it reliable. Below is the exact path from button press to result card, followed by a flowchart you can follow the first time you use the tool.
        </p>

        <figure class="my-5" id="wheel-flow">
          <figcaption class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">What happens when you press Spin</figcaption>
          <div class="mx-auto flex max-w-md flex-col items-stretch gap-0" role="list" aria-label="How the random animal generator wheel works, step by step">
            <div class="wflow-step" role="listitem">
              <span class="wflow-num" aria-hidden="true">1</span>
              <span class="flex-1">Pick a category (optional)<span class="block text-xs font-normal text-muted">12 categories, or leave it on All Animals</span></span>
            </div>
            <div class="wflow-arrow" aria-hidden="true">
              <svg class="mx-auto h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
            </div>
            <div class="wflow-step" role="listitem">
              <span class="wflow-num" aria-hidden="true">2</span>
              <span class="flex-1">Press the Spin button<span class="block text-xs font-normal text-muted">The button locks so nobody can double-spin</span></span>
            </div>
            <div class="wflow-arrow" aria-hidden="true">
              <svg class="mx-auto h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
            </div>
            <div class="wflow-step" role="listitem">
              <span class="wflow-num" aria-hidden="true">3</span>
              <span class="flex-1">The tool chooses a winning slice<span class="block text-xs font-normal text-muted">A random slice index from Math.random() in your browser</span></span>
            </div>
            <div class="wflow-arrow" aria-hidden="true">
              <svg class="mx-auto h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
            </div>
            <div class="wflow-step" role="listitem">
              <span class="wflow-num" aria-hidden="true">4</span>
              <span class="flex-1">The wheel rotates eight full turns<span class="block text-xs font-normal text-muted">2,880° plus the offset that lands the winner under the pointer</span></span>
            </div>
            <div class="wflow-arrow" aria-hidden="true">
              <svg class="mx-auto h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
            </div>
            <div class="wflow-step" role="listitem">
              <span class="wflow-num" aria-hidden="true">5</span>
              <span class="flex-1">The spin settles after five seconds<span class="block text-xs font-normal text-muted">Ticks slow down and the centre emoji cycles through the slices</span></span>
            </div>
            <div class="wflow-arrow" aria-hidden="true">
              <svg class="mx-auto h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
            </div>
            <div class="wflow-step" role="listitem">
              <span class="wflow-num" aria-hidden="true">6</span>
              <span class="flex-1">The result card appears<span class="block text-xs font-normal text-muted">Name, picture, profile and fun fact, with Save, Share and Download</span></span>
            </div>
          </div>
        </figure>

        <p class="text-sm leading-relaxed dark:text-[#a1a1a1]">
          The selection runs entirely on your device: the page builds the list of eligible animals, filters it by your category, and picks one index with JavaScript's <code class="rounded border border-hairline bg-canvas px-1.5 py-0.5 font-mono text-xs text-faint dark:border-[#333] dark:bg-[#111]">Math.random()</code>. No account, no server round-trip, no form. Photographs load separately when the card needs one, so the spin stays instant. Google's guidance describes interactive tools like this as <a href="https://developers.google.com/search/docs/fundamentals/creating-helpful-content" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">main content</a> of a page — the wheel is the point of this page, and the guide below helps you get more out of it.
        </p>
      </article>

      <article>
        <h2 class="mb-4 text-xl font-bold text-ink dark:text-[#ededed]">Inside a 5-Second Spin</h2>
        <p class="mb-3 text-sm leading-relaxed dark:text-[#a1a1a1]">
          The wheel has four visible parts: a fixed pointer at the top (12 o'clock), the coloured disc divided into equal slices, an emoji label on every slice, and a hub in the centre that cycles through the animals while the disc moves. The disc is drawn with a CSS conic gradient of twelve alternating colours, so slices stay sharp at any screen size.
        </p>

        <figure class="my-5">
          <figcaption class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">Anatomy of the random animal generator wheel</figcaption>
          <div class="overflow-x-auto rounded-xl border border-hairline bg-canvas p-3 dark:border-[#333] dark:bg-[#111]">
            <svg viewBox="0 0 420 232" class="mx-auto h-auto w-full max-w-lg" role="img" aria-label="Diagram of the wheel: a fixed pointer at the top, equal coloured slices with animal emoji, and a centre hub showing the current emoji">
              <g transform="translate(20,26)">
                <circle cx="100" cy="100" r="94" fill="#fafafa" stroke="#ebebeb" stroke-width="2" />
                <g stroke="#ffffff" stroke-width="1.5">
                  <path d="M100,100 L100.0,12.0 A88,88 0 0 1 162.2,37.8 Z" fill="#0070f3" />
                  <path d="M100,100 L162.2,37.8 A88,88 0 0 1 188.0,100.0 Z" fill="#7928ca" />
                  <path d="M100,100 L188.0,100.0 A88,88 0 0 1 162.2,162.2 Z" fill="#ff0080" />
                  <path d="M100,100 L162.2,162.2 A88,88 0 0 1 100.0,188.0 Z" fill="#50e3c2" />
                  <path d="M100,100 L100.0,188.0 A88,88 0 0 1 37.8,162.2 Z" fill="#f5a623" />
                  <path d="M100,100 L37.8,162.2 A88,88 0 0 1 12.0,100.0 Z" fill="#ee0000" />
                  <path d="M100,100 L12.0,100.0 A88,88 0 0 1 37.8,37.8 Z" fill="#22c55e" />
                  <path d="M100,100 L37.8,37.8 A88,88 0 0 1 100.0,12.0 Z" fill="#a855f7" />
                </g>
                <circle cx="100" cy="100" r="26" fill="#ffffff" stroke="#ebebeb" stroke-width="2" />
                <text x="100" y="108" text-anchor="middle" font-size="20">🎡</text>
                <g font-size="12" fill="#ffffff">
                  <text x="131" y="38">🐘</text>
                  <text x="152" y="78">🐧</text>
                  <text x="145" y="136">🦈</text>
                  <text x="108" y="160">🦋</text>
                  <text x="62" y="150">🐸</text>
                  <text x="44" y="112">🦁</text>
                  <text x="56" y="66">🐢</text>
                  <text x="92" y="42">🦊</text>
                </g>
              </g>
              <polygon points="108,6 132,6 120,26" fill="#171717" />
              <g stroke="#8f8f8f" stroke-width="1" fill="none">
                <path d="M134,16 L232,34" />
                <path d="M196,74 L232,74" />
                <path d="M186,180 L232,158" />
                <path d="M140,140 L232,200" />
              </g>
              <g font-size="11" fill="#4d4d4d">
                <text x="236" y="37">Fixed pointer at 12 o'clock</text>
                <text x="236" y="77">Equal slices (up to 16)</text>
                <text x="236" y="161">Animal emoji per slice</text>
                <text x="236" y="203">Centre hub emoji</text>
              </g>
            </svg>
          </div>
          <p class="mt-2 text-xs text-muted">Eight slices shown for clarity; the tool uses up to 16 depending on your category.</p>
        </figure>

        <p class="mb-3 text-sm leading-relaxed dark:text-[#a1a1a1]">
          The rotation runs on a CSS transition of five seconds with the timing function <code class="rounded border border-hairline bg-canvas px-1.5 py-0.5 font-mono text-xs text-faint dark:border-[#333] dark:bg-[#111]">cubic-bezier(0.17, 0.67, 0.12, 0.99)</code>, an ease-out curve in the family described by the <a href="https://developer.mozilla.org/en-US/docs/Web/CSS/easing-function" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">MDN easing function reference</a>. It starts fast and spends the last seconds crawling, which is what a real wheel does once friction takes over. The timeline of a single spin:
        </p>

        <div class="my-4 overflow-x-auto rounded-xl border border-hairline dark:border-[#333]">
          <table class="w-full min-w-[540px] text-left text-xs">
            <thead class="bg-canvas dark:bg-[#111]">
              <tr>
                <th class="px-3 py-2.5 font-semibold uppercase tracking-wider text-faint">Time</th>
                <th class="px-3 py-2.5 font-semibold uppercase tracking-wider text-faint">What you see and hear</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline dark:divide-[#333]">
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">0.0 s</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">Spin button locks, a whoosh, the first tick</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">0.0–0.8 s</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">Fast phase — most of the 2,880° happens, ticks about every 45 ms</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">0.8–3.0 s</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">Deceleration; tick spacing stretches from ~60 ms to 130 ms</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">3.0–5.0 s</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">Final settle; ticks past 300 ms, fading in volume</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">5.0 s</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">Wheel stops on the winning slice; a two-note chime plays</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">5.2 s</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">Result card and profile appear, page scrolls to them</td></tr>
            </tbody>
          </table>
        </div>

        <p class="text-sm leading-relaxed dark:text-[#a1a1a1]">
          The centre emoji cycles every 80 milliseconds during the spin, so the middle of the wheel feels as busy as the rim. Sound is generated on the fly with the Web Audio API — there is no audio file to download — and it stops with the wheel.
        </p>
      </article>

      <article>
        <h2 class="mb-4 text-xl font-bold text-ink dark:text-[#ededed]">Odds on Every Slice: How Fair Is the Spin?</h2>
        <p class="mb-3 text-sm leading-relaxed dark:text-[#a1a1a1]">
          Slices are equal by construction: the wheel covers 360 degrees, so with <em>n</em> slices each occupies 360 ÷ <em>n</em> degrees and has a 1 ÷ <em>n</em> chance of winning. The wheel shows up to 16 slices at a time — wide enough to read, small enough that the odds still feel like a lottery.
        </p>

        <div class="my-4 overflow-x-auto rounded-xl border border-hairline dark:border-[#333]">
          <table class="w-full min-w-[440px] text-left text-xs">
            <thead class="bg-canvas dark:bg-[#111]">
              <tr>
                <th class="px-3 py-2.5 font-semibold uppercase tracking-wider text-faint">Slices on the wheel</th>
                <th class="px-3 py-2.5 font-semibold uppercase tracking-wider text-faint">Degrees per slice</th>
                <th class="px-3 py-2.5 font-semibold uppercase tracking-wider text-faint">Chance for any one animal</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline dark:divide-[#333]">
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">2</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">180°</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">50%</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">4</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">90°</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">25%</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">8</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">45°</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">12.5%</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">12</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">30°</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">8.3%</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">16</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">22.5°</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">6.25%</td></tr>
            </tbody>
          </table>
        </div>

        <p class="text-sm leading-relaxed dark:text-[#a1a1a1]">
          Three points about fairness are worth stating plainly. Every spin is independent — landing on the same animal twice in a row does not make the next spin "due" to change. No slice is weighted, and the random index is generated with the same function for every position, as documented in the <a href="https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Math/random" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">MDN reference for Math.random()</a>. That function produces pseudo-random numbers and is not suitable for security or gambling — for a classroom pick, a party game or a drawing prompt it is exactly right.
        </p>
      </article>

      <article>
        <h2 class="mb-4 text-xl font-bold text-ink dark:text-[#ededed]">What Is on the Wheel? The Database Behind the Spin</h2>
        <p class="mb-3 text-sm leading-relaxed dark:text-[#a1a1a1]">
          The wheel draws from the same {totalRecords}-record collection used across this site, covering 12 categories from mammals to prehistoric and mythical entries. Every record carries a name, emoji, habitat, diet, lifespan, weight, speed, length, region, taxonomy, a scientific name and a fun fact. Choosing a category rebuilds the pool before your next spin — the way you turn the general wheel into a specialist one for sea animals, cute animals, farm animals or predators.
        </p>

        <figure class="my-5">
          <figcaption class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">Records per category (of {totalRecords} total)</figcaption>
          <div class="space-y-2.5">
            {categoryCounts.map(c => (
              <div class="flex items-center gap-3">
                <span class="w-24 shrink-0 text-xs font-medium text-body dark:text-[#a1a1a1]">{c.label}</span>
                <div class="h-4 flex-1 overflow-hidden rounded-full bg-hairline dark:bg-[#333]">
                  <div class:list={['h-full rounded-full', c.cat === 'fantasy' || c.cat === 'mythical' ? 'bg-violet' : c.cat === 'prehistoric' ? 'bg-warning' : 'bg-link']} style={`width: ${Math.max(2, Math.round((c.count / maxCatCount) * 100))}%`}></div>
                </div>
                <span class="w-16 shrink-0 text-right text-xs tabular-nums text-muted">{c.count} · {pct(c.count)}%</span>
              </div>
            ))}
          </div>
          <p class="mt-2 text-xs text-muted">Bar length is relative to the largest group; each record has exactly one category, so counts add up to {totalRecords}.</p>
        </figure>

        <div class="my-4 overflow-x-auto rounded-xl border border-hairline dark:border-[#333]">
          <table class="w-full min-w-[560px] text-left text-xs">
            <thead class="bg-canvas dark:bg-[#111]">
              <tr>
                <th class="px-3 py-2.5 font-semibold uppercase tracking-wider text-faint">Category</th>
                <th class="px-3 py-2.5 font-semibold uppercase tracking-wider text-faint">Records</th>
                <th class="px-3 py-2.5 font-semibold uppercase tracking-wider text-faint">Share</th>
                <th class="px-3 py-2.5 font-semibold uppercase tracking-wider text-faint">Examples you can land on</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline dark:divide-[#333]">
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">Mammals</td><td class="px-3 py-2.5 tabular-nums text-body dark:text-[#a1a1a1]">253</td><td class="px-3 py-2.5 tabular-nums text-body dark:text-[#a1a1a1]">22.7%</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">African Elephant, Snow Leopard, Red Panda</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">Birds</td><td class="px-3 py-2.5 tabular-nums text-body dark:text-[#a1a1a1]">182</td><td class="px-3 py-2.5 tabular-nums text-body dark:text-[#a1a1a1]">16.3%</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">Emperor Penguin, Bald Eagle, Kakapo</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">Insects</td><td class="px-3 py-2.5 tabular-nums text-body dark:text-[#a1a1a1]">160</td><td class="px-3 py-2.5 tabular-nums text-body dark:text-[#a1a1a1]">14.3%</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">Monarch Butterfly, Atlas Beetle</td></tr>
              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">Fish</td><td class="px-3 py-2.5 tabular-nums text-body dark:text-[#a1a1a1]">130</td><td class="px-3 py-2.5 tabular-nums text-body dark:text-[#a1a1a1]">11.7%</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">Clownfish, Whale Shark, Manta Ray</td></tr>
