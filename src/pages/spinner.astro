              <tr><td class="px-3 py-2.5 font-medium text-ink dark:text-[#ededed]">CR</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">Critically Endangered</td><td class="px-3 py-2.5 tabular-nums text-body dark:text-[#a1a1a1]">36</td><td class="px-3 py-2.5 text-body dark:text-[#a1a1a1]">Extremely likely to go extinct</td></tr>
