---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import animals from '../data/animals.json';
import animalTranslations from '../i18n/data/animal-translations.json';
import valuesData from '../i18n/data/values.json';
import { getTranslations, type Locale } from '../utils/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale);
const animalT = animalTranslations[locale] || {};

const SITE_URL = 'https://bestrandomanimalgenerator.com';
const canonical = locale === 'en' ? `${SITE_URL}/compare` : `${SITE_URL}/${locale}/compare`;
---

<Layout title={`${t.compare_title} | Random Animal Generator`} description={t.compare_desc} canonical={canonical} locale={locale} pagePath="/compare">
  <Navbar locale={locale} pagePath="/compare" />
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
    <section class="mb-8 text-center">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-[#ededed]">{t.compare_title}</h1>
      <p class="mx-auto mt-3 max-w-lg text-sm text-body dark:text-[#a1a1a1]">
        {t.compare_desc}
      </p>
    </section>

    <div class="mb-6 flex flex-col sm:flex-row flex-wrap items-center justify-center gap-4">
      <div class="relative w-full sm:w-auto">
        <input id="search-a" type="text" placeholder={t.compare_search_a} class="w-full sm:w-56 rounded-lg border border-hairline bg-canvas-elevated px-3 py-2 text-sm text-ink outline-none transition-colors focus:border-link dark:border-[#333] dark:bg-[#1a1a1a] dark:text-[#ededed] dark:focus:border-link" />
        <div id="dropdown-a" class="absolute z-10 mt-1 hidden w-full sm:w-56 max-h-60 overflow-y-auto rounded-lg border border-hairline bg-canvas-elevated shadow-lg dark:border-[#333] dark:bg-[#1a1a1a]"></div>
      </div>
      <span class="text-lg text-muted">{t.compare_vs}</span>
      <div class="relative w-full sm:w-auto">
        <input id="search-b" type="text" placeholder={t.compare_search_b} class="w-full sm:w-56 rounded-lg border border-hairline bg-canvas-elevated px-3 py-2 text-sm text-ink outline-none transition-colors focus:border-link dark:border-[#333] dark:bg-[#1a1a1a] dark:text-[#ededed] dark:focus:border-link" />
        <div id="dropdown-b" class="absolute z-10 mt-1 hidden w-full sm:w-56 max-h-60 overflow-y-auto rounded-lg border border-hairline bg-canvas-elevated shadow-lg dark:border-[#333] dark:bg-[#1a1a1a]"></div>
      </div>
      <button id="random-pick" class="rounded-lg border border-hairline bg-canvas-elevated px-3 py-2 text-xs font-medium text-body transition-colors hover:bg-hairline-soft dark:border-[#333] dark:bg-[#1a1a1a] dark:text-[#a1a1a1] dark:hover:bg-[#222]">{t.compare_random}</button>
    </div>

    <div id="compare-result" class="hidden">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div id="card-a" class="rounded-2xl border border-hairline bg-canvas-elevated overflow-hidden dark:border-[#333] dark:bg-[#1a1a1a]"></div>
        <div id="card-b" class="rounded-2xl border border-hairline bg-canvas-elevated overflow-hidden dark:border-[#333] dark:bg-[#1a1a1a]"></div>
      </div>
      <div id="comparison-stats" class="mt-6 rounded-2xl border border-hairline bg-canvas-elevated p-6 dark:border-[#333] dark:bg-[#1a1a1a]"></div>
    </div>

    <div id="compare-placeholder" class="rounded-2xl border border-dashed border-hairline bg-hairline-soft/50 py-16 text-center dark:border-[#333] dark:bg-[#111]">
      <p class="text-4xl mb-3">âï¸</p>
      <p class="text-sm text-muted">{t.compare_placeholder}</p>
    </div>
  </main>

  <Footer locale={locale} />
</Layout>

<div id="compare-fullscreen-overlay" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4 cursor-zoom-out" style="backdrop-filter:blur(8px);">
  <button id="compare-fullscreen-close" class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors z-10">
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
  </button>
  <img id="compare-fullscreen-img" class="max-h-[90vh] max-w-[90vw] rounded-2xl object-contain shadow-2xl" alt="" />
</div><script define:vars={{ animals: JSON.stringify(animals), locale, animalT: JSON.stringify(animalT), values: JSON.stringify(valuesData), compareT: JSON.stringify({ summary: t.compare_summary, same: t.compare_same, different: t.compare_different, habitat: t.habitat, diet: t.diet, lifespan: t.lifespan, weight: t.weight, speed: t.speed, length: t.length, region: t.region, taxonomy: t.taxonomy, taxClass: t.tax_class, taxOrder: t.tax_order, taxFamily: t.tax_family, funFact: t.fun_fact, conservation: t.conservation, category: t.category, years: t.years, mph: t.mph, lbs: t.lbs, ft: t.ft, consLC: t.cons_lc, consNT: t.cons_nt, consVU: t.cons_vu, consEN: t.cons_en, consCR: t.cons_cr, consEW: t.cons_ew, consEX: t.cons_ex, consDD: t.cons_dd, catMammal: t.cat_mammal, catBird: t.cat_bird, catFish: t.cat_fish, catReptile: t.cat_reptile, catAmphibian: t.cat_amphibian, catInsect: t.cat_insect, catMarine: t.cat_marine, catFarm: (t as any).cat_farm || 'Farm', catFantasy: (t as any).cat_fantasy || 'Fantasy', catPrehistoric: (t as any).cat_prehistoric || 'Prehistoric', catMythical: (t as any).cat_mythical || 'Mythical', catCute: (t as any).cat_cute || 'Cute', fullscreen: (t as any).fullscreen || 'Fullscreen', photoBy: (t as any).photo_by || 'Photo by {photographer} on Pexels' }) }}>
  const allAnimals = JSON.parse(animals);
  const animalTrans = JSON.parse(animalT);
  const cT = JSON.parse(compareT);
  let animalA = null, animalB = null;

  function getAnimalName(animal) { return (animalTrans[animal.id] && animalTrans[animal.id].name) || animal.name; }
  function getAnimalDescription(animal) { return (animalTrans[animal.id] && animalTrans[animal.id].description) || animal.description; }
  function getAnimalFunFact(animal) { return (animalTrans[animal.id] && animalTrans[animal.id].funFact) || animal.funFact; }

  const valueMaps = JSON.parse(values);
  function translateVal(value, field) { const map = valueMaps[field]; return (map && map[locale] && map[locale][value]) || value; }


  const consLabels = {
    LC: { text: cT.consLC, color: 'bg-conservation-lc/15 text-conservation-lc border border-conservation-lc/30' },
    NT: { text: cT.consNT, color: 'bg-conservation-nt/15 text-conservation-nt border border-conservation-nt/30' },
    VU: { text: cT.consVU, color: 'bg-conservation-vu/15 text-conservation-vu border border-conservation-vu/30' },
    EN: { text: cT.consEN, color: 'bg-conservation-en/15 text-conservation-en border border-conservation-en/30' },
    CR: { text: cT.consCR, color: 'bg-conservation-cr/15 text-conservation-cr border border-conservation-cr/30' },
    EW: { text: cT.consEW, color: 'bg-conservation-ew/15 text-conservation-ew border border-conservation-ew/30' },
    EX: { text: cT.consEX, color: 'bg-conservation-ex/15 text-conservation-ex border border-conservation-ex/30' },
    DD: { text: cT.consDD, color: 'bg-muted/15 text-muted border border-muted/30' },
  };
  const catLabels = {
    mammal: cT.catMammal, bird: cT.catBird, fish: cT.catFish, reptile: cT.catReptile,
    amphibian: cT.catAmphibian, insect: cT.catInsect, marine: cT.catMarine,
  };

  const PEXELS_API_KEY = 'xEfnJ9xU5Fem8MeEPh1zE3lURDVneBkLnPGnrNAjnbMCBAY0LGtdgLFE';
  const pexelsCache = JSON.parse(localStorage.getItem('pexelsImageCache') || '{}');
  Object.keys(pexelsCache).forEach(k => { if (typeof pexelsCache[k] === 'string') delete pexelsCache[k]; });
  async function fetchAnimalImage(animalName) {
    const cacheKey = animalName.toLowerCase().trim();
    if (pexelsCache[cacheKey]) return pexelsCache[cacheKey];
    try {
      const res = await fetch(`https://api.pexels.com/v1/search?query=${encodeURIComponent(animalName)}&per_page=1&orientation=landscape`, {
        headers: { 'Authorization': PEXELS_API_KEY }
      });
      if (!res.ok) return null;
      const data = await res.json();
      if (!data.photos || !data.photos.length) return null;
      const photo = data.photos[0];
      const result = { url: photo.src.large2x || photo.src.large, photographer: photo.photographer, photoUrl: photo.url };
      pexelsCache[cacheKey] = result;
      localStorage.setItem('pexelsImageCache', JSON.stringify(pexelsCache));
      return result;
    } catch { return null; }
  }

  function renderCard(animal, containerId) {
    const el = document.getElementById(containerId);
    if (!animal) { el.innerHTML = ''; return; }
    const cons = consLabels[animal.conservation] || consLabels.LC;
    const name = getAnimalName(animal);
    const desc = getAnimalDescription(animal);
    const funFact = getAnimalFunFact(animal);
    el.innerHTML = `
      <div class="bg-gradient-to-br from-link-soft/50 via-violet-soft/30 to-pink-soft/30 p-4 text-center sm:p-5 dark:from-[#1a2744] dark:via-[#2a1a3a] dark:to-[#3a1a2a]">
        <div class="compare-image-wrapper mb-3" style="position:relative;">
          <div class="compare-image-skeleton image-skeleton mx-auto" style="width:100%;max-width:320px;height:180px;border-radius:12px;"></div>
          <img class="compare-image-el mx-auto rounded-xl object-cover shadow-md hidden" style="width:100%;max-width:320px;height:180px;" alt="${name}" />
          <button class="compare-image-fullscreen absolute bottom-2 right-2 flex items-center gap-1 rounded-lg bg-black/60 px-2 py-1 text-[10px] font-medium text-white backdrop-blur-sm transition-all hover:bg-black/80 hover:scale-105" title="View full image">
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
          </button>
          <p class="compare-image-credit absolute bottom-2 left-2 text-[10px] text-white/70 hidden"><a class="compare-image-credit-link" href="#" target="_blank" rel="noopener noreferrer" class="hover:text-white/90"></a></p>
        </div>
        <div class="text-5xl mb-2 emoji-icon sm:text-6xl">${animal.emoji}</div>
        <h3 class="text-base font-bold text-ink dark:text-[#ededed]">${name}</h3>
        ${animal.scientificName ? `<p class="text-xs italic text-muted mt-0.5">${animal.scientificName}</p>` : ''}
        <span class="mt-1.5 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-medium ${cons.color}">${cons.text}</span>
      </div>
      <div class="p-3 sm:p-4">
        ${desc ? `<p class="text-xs text-body leading-relaxed mb-3 dark:text-[#a1a1a1]">${desc}</p>` : ''}
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div class="flex items-center gap-1.5 rounded-lg border border-hairline bg-canvas px-2.5 py-2 dark:border-[#333] dark:bg-[#111]">
            <span>ð</span><div class="min-w-0"><p class="text-[10px] text-faint">${cT.habitat}</p><p class="font-medium text-ink dark:text-[#ededed]">${translateVal(animal.habitat, 'habitat')}</p></div>
          </div>
          <div class="flex items-center gap-1.5 rounded-lg border border-hairline bg-canvas px-2.5 py-2 dark:border-[#333] dark:bg-[#111]">
            <span>ð½ï¸</span><div class="min-w-0"><p class="text-[10px] text-faint">${cT.diet}</p><p class="font-medium text-ink dark:text-[#ededed]">${translateVal(animal.diet, 'diet')}</p></div>
          </div>
          <div class="flex items-center gap-1.5 rounded-lg border border-hairline bg-canvas px-2.5 py-2 dark:border-[#333] dark:bg-[#111]">
            <span>â±ï¸</span><div class="min-w-0"><p class="text-[10px] text-faint">${cT.lifespan}</p><p class="font-medium text-ink dark:text-[#ededed]">${animal.lifespan}</p></div>
          </div>
          <div class="flex items-center gap-1.5 rounded-lg border border-hairline bg-canvas px-2.5 py-2 dark:border-[#333] dark:bg-[#111]">
            <span>âï¸</span><div class="min-w-0"><p class="text-[10px] text-faint">${cT.weight}</p><p class="font-medium text-ink dark:text-[#ededed]">${animal.weight}</p></div>
          </div>
        </div>
        <div class="mt-2 grid grid-cols-3 gap-2 text-xs">
          <div class="rounded-lg border border-hairline bg-canvas p-2 text-center dark:border-[#333] dark:bg-[#111]">
            <p class="text-[10px] text-faint mb-0.5">${cT.speed}</p>
            <p class="font-semibold text-ink dark:text-[#ededed]">${animal.speed}</p>
          </div>
          <div class="rounded-lg border border-hairline bg-canvas p-2 text-center dark:border-[#333] dark:bg-[#111]">
            <p class="text-[10px] text-faint mb-0.5">${cT.length}</p>
            <p class="font-semibold text-ink dark:text-[#ededed]">${animal.length || 'â'}</p>
          </div>
          <div class="rounded-lg border border-hairline bg-canvas p-2 text-center dark:border-[#333] dark:bg-[#111]">
            <p class="text-[10px] text-faint mb-0.5">${cT.region}</p>
            <p class="font-semibold text-ink dark:text-[#ededed]">${translateVal(animal.region, 'region')}</p>
          </div>
        </div>
        <div class="mt-2 rounded-lg border border-hairline bg-canvas p-2.5 dark:border-[#333] dark:bg-[#111]">
          <p class="text-[10px] uppercase tracking-wider text-faint mb-1">ð§¬ ${cT.taxonomy}</p>
          <div class="grid grid-cols-1 gap-1 text-[11px] sm:grid-cols-3 sm:gap-1.5">
            <div class="flex items-center gap-1"><span class="text-faint">${cT.taxClass}</span> <span class="font-medium text-ink dark:text-[#ededed]">${animal.class || 'â'}</span></div>
            <div class="flex items-center gap-1"><span class="text-faint">${cT.taxOrder}</span> <span class="font-medium text-ink dark:text-[#ededed]">${animal.order || 'â'}</span></div>
            <div class="flex items-center gap-1"><span class="text-faint">${cT.taxFamily}</span> <span class="font-medium text-ink dark:text-[#ededed]">${animal.family || 'â'}</span></div>
          </div>
        </div>
        <div class="mt-2 rounded-xl border border-link-soft bg-link-soft/30 p-2.5 dark:border-[#1e3a5f] dark:bg-[#0f1f33]">
          <p class="text-[10px] uppercase tracking-wider text-link font-medium mb-0.5 dark:text-link">ð¡ ${cT.funFact}</p>
          <p class="text-xs text-body leading-relaxed dark:text-[#a1a1a1]">${funFact}</p>
        </div>
      </div>
    `;

    const imgWrap = el.querySelector('.compare-image-wrapper');
    const imgEl = el.querySelector('.compare-image-el');
    const imgSkel = el.querySelector('.compare-image-skeleton');
    if (imgWrap) imgWrap.classList.remove('hidden');
    fetchAnimalImage(animal.name).then(data => {
      if (data && imgEl && imgSkel) {
        imgEl.onload = () => { imgSkel.classList.add('hidden'); imgEl.classList.remove('hidden'); };
        imgEl.onerror = () => { imgSkel.classList.add('hidden'); };
        imgEl.src = data.url;
        const creditLink = el.querySelector('.compare-image-credit-link');
        const creditEl = el.querySelector('.compare-image-credit');
        if (creditLink && data.photographer && data.photoUrl) {
          creditLink.textContent = `Photo by ${data.photographer} on Pexels`;
          creditLink.href = data.photoUrl;
          creditEl?.classList.remove('hidden');
        }
      } else if (imgSkel) {
        imgSkel.classList.add('hidden');
      }
    });
    el.querySelector('.compare-image-fullscreen')?.addEventListener('click', () => {
      if (!imgEl || !imgEl.src) return;
      const fsImg = document.getElementById('compare-fullscreen-img');
      if (fsImg) { fsImg.src = imgEl.src; fsImg.alt = imgEl.alt; }
      document.getElementById('compare-fullscreen-overlay')?.classList.remove('hidden');
    });
  }

  function renderComparison() {
    if (!animalA || !animalB) return;
    document.getElementById('compare-placeholder').classList.add('hidden');
    document.getElementById('compare-result').classList.remove('hidden');
    renderCard(animalA, 'card-a');
    renderCard(animalB, 'card-b');

    const rows = [
      { label: cT.diet, icon: 'ð½ï¸', a: translateVal(animalA.diet, 'diet'), b: translateVal(animalB.diet, 'diet') },
      { label: cT.habitat, icon: 'ð', a: translateVal(animalA.habitat, 'habitat'), b: translateVal(animalB.habitat, 'habitat') },
      { label: cT.region, icon: 'ðºï¸', a: translateVal(animalA.region, 'region'), b: translateVal(animalB.region, 'region') },
      { label: cT.lifespan, icon: 'â±ï¸', a: animalA.lifespan, b: animalB.lifespan },
      { label: cT.weight, icon: 'âï¸', a: animalA.weight, b: animalB.weight },
      { label: cT.speed, icon: 'ð¨', a: animalA.speed, b: animalB.speed },
      { label: cT.conservation || 'Conservation', icon: 'ð¡ï¸', a: (consLabels[animalA.conservation] || animalA.conservation).text || consLabels[animalA.conservation] || animalA.conservation, b: (consLabels[animalB.conservation] || animalB.conservation).text || consLabels[animalB.conservation] || animalB.conservation },
      { label: cT.category || 'Category', icon: 'ð', a: catLabels[animalA.category] || animalA.category, b: catLabels[animalB.category] || animalB.category },
    ];

    const nameA = getAnimalName(animalA);
    const nameB = getAnimalName(animalB);
    const stats = document.getElementById('comparison-stats');
    stats.innerHTML = `
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-base font-bold text-ink dark:text-[#ededed]">${cT.summary}</h3>
        <div class="flex items-center gap-4 text-xs text-muted">
          <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-conservation-lc"></span>${cT.same}</span>
          <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-error"></span>${cT.different}</span>
        </div>
      </div>
      <div class="space-y-2">
        ${rows.map(r => {
          const same = r.a === r.b;
          return `
          <div class="rounded-xl border border-hairline bg-canvas-elevated overflow-hidden dark:border-[#333] dark:bg-[#1a1a1a]">
            <div class="flex items-center gap-2 bg-hairline-soft/50 px-3 py-2 dark:bg-[#111]">
              <span class="text-sm">${r.icon}</span>
              <span class="text-xs font-semibold text-ink dark:text-[#ededed]">${r.label}</span>
              ${same ? `<span class="ml-auto rounded-full bg-conservation-lc/15 px-2 py-0.5 text-[10px] font-medium text-conservation-lc border border-conservation-lc/30">${cT.same}</span>` : ''}
            </div>
            <div class="grid grid-cols-2 divide-x divide-hairline dark:divide-[#333]">
              <div class="px-3 py-2.5 text-center">
                <p class="text-[10px] uppercase tracking-wider text-muted mb-1">${nameA}</p>
                <p class="text-sm font-medium text-ink dark:text-[#ededed]">${r.a}</p>
              </div>
              <div class="px-3 py-2.5 text-center">
                <p class="text-[10px] uppercase tracking-wider text-muted mb-1">${nameB}</p>
                <p class="text-sm font-medium text-ink dark:text-[#ededed]">${r.b}</p>
              </div>
            </div>
          </div>`;
        }).join('')}
      </div>
    `;
  }

  function showDropdown(inputId, dropdownId) {
    const input = document.getElementById(inputId);
    const dropdown = document.getElementById(dropdownId);
    input.addEventListener('input', () => {
      const val = input.value.toLowerCase().trim();
      if (val.length < 1) { dropdown.classList.add('hidden'); return; }
      const matches = allAnimals.filter(a => getAnimalName(a).toLowerCase().includes(val) || a.name.toLowerCase().includes(val)).slice(0, 10);
      if (matches.length === 0) { dropdown.classList.add('hidden'); return; }
      dropdown.classList.remove('hidden');
      dropdown.innerHTML = matches.map(a => `
        <button class="w-full text-left px-3 py-2 text-sm text-body hover:bg-hairline-soft dark:text-[#a1a1a1] dark:hover:bg-[#222]" data-id="${a.id}">
          <span class="mr-2">${a.emoji}</span>${getAnimalName(a)}
        </button>
      `).join('');
      dropdown.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('click', () => {
          const animal = allAnimals.find(a => a.id === btn.dataset.id);
          if (inputId === 'search-a') animalA = animal;
          else animalB = animal;
          input.value = `${animal.emoji} ${getAnimalName(animal)}`;
          dropdown.classList.add('hidden');
          renderComparison();
        });
      });
    });
    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !dropdown.contains(e.target)) dropdown.classList.add('hidden');
    });
  }

  showDropdown('search-a', 'dropdown-a');
  showDropdown('search-b', 'dropdown-b');

  document.getElementById('random-pick')?.addEventListener('click', () => {
    const a = allAnimals[Math.floor(Math.random() * allAnimals.length)];
    let b = a;
    while (b === a) b = allAnimals[Math.floor(Math.random() * allAnimals.length)];
    animalA = a; animalB = b;
    document.getElementById('search-a').value = `${a.emoji} ${getAnimalName(a)}`;
    document.getElementById('search-b').value = `${b.emoji} ${getAnimalName(b)}`;
    renderComparison();
  });

  document.getElementById('compare-fullscreen-overlay')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) document.getElementById('compare-fullscreen-overlay')?.classList.add('hidden');
  });
  document.getElementById('compare-fullscreen-close')?.addEventListener('click', () => {
    document.getElementById('compare-fullscreen-overlay')?.classList.add('hidden');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.getElementById('compare-fullscreen-overlay')?.classList.add('hidden');
  });
</script>
