---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us | Random Animal Generator" description="Get in touch with the Random Animal Generator team. We'd love to hear your feedback, questions, and suggestions." pagePath="/contact-us">
  <Navbar pagePath="/contact-us" />

  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-[#ededed]">Contact Us</h1>
      <p class="mx-auto mt-3 max-w-lg text-sm text-body sm:text-base dark:text-[#a1a1a1]">
        Have a question, suggestion, or just want to say hello? We'd love to hear from you.
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2">
      <div class="space-y-6">
        <section class="rounded-2xl border border-hairline bg-canvas-elevated p-6 dark:border-[#333] dark:bg-[#1a1a1a]">
          <h2 class="mb-3 text-lg font-semibold text-ink dark:text-[#ededed]">Send Us a Message</h2>
          <form class="space-y-4">
            <div>
              <label for="name" class="mb-1 block text-xs font-medium text-body dark:text-[#a1a1a1]">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                class="w-full rounded-lg border border-hairline bg-canvas-elevated px-3 py-2 text-sm text-ink outline-none transition-colors focus:border-link dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:focus:border-link"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="mb-1 block text-xs font-medium text-body dark:text-[#a1a1a1]">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                class="w-full rounded-lg border border-hairline bg-canvas-elevated px-3 py-2 text-sm text-ink outline-none transition-colors focus:border-link dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:focus:border-link"
                placeholder="your@email.com"
              />
            </div>
            <div>
              <label for="subject" class="mb-1 block text-xs font-medium text-body dark:text-[#a1a1a1]">Subject</label>
              <input
                type="text"
                id="subject"
                name="subject"
                class="w-full rounded-lg border border-hairline bg-canvas-elevated px-3 py-2 text-sm text-ink outline-none transition-colors focus:border-link dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:focus:border-link"
                placeholder="How can we help?"
              />
            </div>
            <div>
              <label for="message" class="mb-1 block text-xs font-medium text-body dark:text-[#a1a1a1]">Message</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                class="w-full rounded-lg border border-hairline bg-canvas-elevated px-3 py-2 text-sm text-ink outline-none transition-colors focus:border-link dark:border-[#333] dark:bg-[#111] dark:text-[#ededed] dark:focus:border-link"
                placeholder="Your message..."
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-white transition-all hover:opacity-90 active:scale-95 dark:bg-[#ededed] dark:text-[#0a0a0a]"
            >
              Send Message
            </button>
          </form>
        </section>
      </div>

      <div class="space-y-6">
        <section class="rounded-2xl border border-hairline bg-canvas-elevated p-6 dark:border-[#333] dark:bg-[#1a1a1a]">
          <h2 class="mb-3 text-lg font-semibold text-ink dark:text-[#ededed]">Other Ways to Reach Us</h2>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <span class="mt-0.5 text-lg">&#128231;</span>
              <div>
                <p class="text-sm font-medium text-ink dark:text-[#ededed]">Email</p>
                <p class="text-xs text-body dark:text-[#a1a1a1]">hello@randomanimalgenerator.com</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="mt-0.5 text-lg">&#127760;</span>
              <div>
                <p class="text-sm font-medium text-ink dark:text-[#ededed]">Social Media</p>
                <p class="text-xs text-body dark:text-[#a1a1a1]">Follow us for daily animal facts and updates.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="rounded-2xl border border-hairline bg-canvas-elevated p-6 dark:border-[#333] dark:bg-[#1a1a1a]">
          <h2 class="mb-3 text-lg font-semibold text-ink dark:text-[#ededed]">Frequently Asked</h2>
          <div class="space-y-3">
            <div>
              <p class="text-sm font-medium text-ink dark:text-[#ededed]">Can I use the animal data for my project?</p>
              <p class="text-xs text-body dark:text-[#a1a1a1]">Yes! Our tool is free for everyone. Feel free to use it for education, games, or creative projects.</p>
            </div>
            <div>
              <p class="text-sm font-medium text-ink dark:text-[#ededed]">How do I report a bug?</p>
              <p class="text-xs text-body dark:text-[#a1a1a1]">Send us a message using the form and we'll look into it right away.</p>
            </div>
            <div>
              <p class="text-sm font-medium text-ink dark:text-[#ededed]">Can I suggest a new animal?</p>
              <p class="text-xs text-body dark:text-[#a1a1a1]">Absolutely! We're always looking to expand our database. Let us know which animal you'd like to see.</p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
