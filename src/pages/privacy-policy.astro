---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getTranslations, type Locale, brandNames, defaultImageAlts } from '../utils/i18n';
import privacyData from '../i18n/data/privacy-content.json';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale);
const c = (privacyData as any)[locale] || (privacyData as any).en;
const contactHref = locale === 'en' ? '/contact-us' : `/${locale}/contact-us`;
const canonical = locale === 'en' ? 'https://bestrandomanimalgenerator.com/privacy-policy' : `https://bestrandomanimalgenerator.com/${locale}/privacy-policy`;
---

<Layout title={`${t.privacy_policy} | ${brandNames[locale]}`} description={c.meta_desc} canonical={canonical} locale={locale} pagePath="/privacy-policy" imageAlt={defaultImageAlts[locale]}>
  <Navbar locale={locale} pagePath="/privacy-policy" />

  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-[#ededed]">{c.title}</h1>
      <p class="mx-auto mt-3 max-w-lg text-sm text-body sm:text-base dark:text-[#a1a1a1]">
        {c.last_updated}
      </p>
    </div>

    <div class="space-y-8">
      {c.sections.map((section: any) => (
        <section class="rounded-2xl border border-hairline bg-canvas-elevated p-6 dark:border-[#333] dark:bg-[#1a1a1a]">
          <h2 class="mb-3 text-lg font-semibold text-ink dark:text-[#ededed]">{section.title}</h2>
          {section.text && <p class="text-sm text-body leading-relaxed dark:text-[#a1a1a1]">{section.text}</p>}
          {section.list && (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-body dark:text-[#a1a1a1]">
              {section.list.map((item: string) => <li>{item}</li>)}
            </ul>
          )}
          {section.extra && <p class="mt-3 text-sm text-body leading-relaxed dark:text-[#a1a1a1]">{section.extra}</p>}
          {section.hasContactLink && (
            <p class="text-sm text-body leading-relaxed dark:text-[#a1a1a1]">
              {section.contactPre} <a href={contactHref} class="text-link underline underline-offset-2 transition-colors hover:text-link-deep">{section.contactLink}</a>.
            </p>
          )}
        </section>
      ))}
    </div>
  </main>

  <Footer locale={locale} />
</Layout>
