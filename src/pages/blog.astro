---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import animals from '../data/animals.json';

const totalAnimals = animals.length;
const categories = [...new Set(animals.map(a => a.category))];
const conservationStatuses = [...new Set(animals.map(a => a.conservation))];

const consCounts = {};
conservationStatuses.forEach(s => { consCounts[s] = animals.filter(a => a.conservation === s).length; });

const catCounts = {};
categories.forEach(c => { catCounts[c] = animals.filter(a => a.category === c).length; });
---

<Layout
  title="Random Animal Generator Blog | Wildlife Facts, Conservation & Education"
  description="Explore wildlife articles with infographics, conservation data tables, animal classification charts, and educational guides. Learn about endangered species, habitats, and how random animal generators aid education."
  canonical="https://bestrandomanimalgenerator.com/blog"
>
  <Navbar />

  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">

    <!-- Blog Header -->
    <header class="mb-12 text-center">
      <div class="mb-3 inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-3 py-1 text-xs text-muted dark:border-[#333] dark:bg-[#1a1a1a] dark:text-[#888]">
        <span class="h-1.5 w-1.5 rounded-full bg-link animate-pulse"></span>
        Wildlife Knowledge Hub
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-[#ededed]">
        Random Animal Generator Blog
      </h1>
      <p class="mx-auto mt-3 max-w-2xl text-sm text-body sm:text-base dark:text-[#a1a1a1]">
        Explore wildlife through infographics, data tables, and educational guides. Learn about conservation, animal classification, and the incredible diversity of life on Earth.
      </p>
    </header>

    <!-- Table of Contents -->
    <nav class="mb-12 rounded-2xl border border-hairline bg-canvas-elevated p-5 dark:border-[#333] dark:bg-[#1a1a1a]">
      <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-muted">Table of Contents</h2>
      <ul class="space-y-1.5 text-sm">
        <li><a href="#conservation-guide" class="text-link hover:underline">1. Complete Guide to Animal Conservation Status</a></li>
        <li><a href="#classification-chart" class="text-link hover:underline">2. Animal Kingdom Classification Chart</a></li>
        <li><a href="#category-breakdown" class="text-link hover:underline">3. Animal Categories Breakdown with Data</a></li>
        <li><a href="#habitat-map" class="text-link hover:underline">4. Global Animal Habitat Distribution</a></li>
        <li><a href="#endangered-flowchart" class="text-link hover:underline">5. Endangered Species Decision Flowchart</a></li>
        <li><a href="#record-holders" class="text-link hover:underline">6. Animal Record Holders Table</a></li>
        <li><a href="#generator-workflow" class="text-link hover:underline">7. How the Random Animal Generator Works</a></li>
        <li><a href="#fun-facts-grid" class="text-link hover:underline">8. Mind-Blowing Animal Facts Grid</a></li>
        <li><a href="#education-guide" class="text-link hover:underline">9. Using Random Animal Generators in Education</a></li>
        <li><a href="#extinction-timeline" class="text-link hover:underline">10. Extinct Animals Timeline</a></li>
      </ul>
    </nav>

    <!-- Section 1: Conservation Status Guide -->
    <section id="conservation-guide" class="mb-14">
      <h2 class="mb-4 text-2xl font-bold text-ink dark:text-[#ededed]">Complete Guide to Animal Conservation Status</h2>
      <p class="mb-4 text-sm leading-relaxed text-body dark:text-[#a1a1a1]">
        The International Union for Conservation of Nature (IUCN) Red List is the world's most comprehensive inventory of species' conservation status. Our random animal generator includes animals across all IUCN categories, helping users learn about wildlife preservation while discovering new species.
      </p>

      <!-- Conservation Status Table -->
      <div class="mb-6 overflow-x-auto rounded-2xl border border-hairline dark:border-[#333]">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-hairline bg-canvas-elevated dark:border-[#333] dark:bg-[#1a1a1a]">
              <th class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">Status Code</th>
              <th class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">Full Name</th>
              <th class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">Definition</th>
              <th class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">Animals in DB</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3"><span class="inline-flex items-center gap-1 rounded-full bg-conservation-lc/15 px-2 py-0.5 text-[10px] font-bold text-conservation-lc border border-conservation-lc/30">LC</span></td>
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">Least Concern</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Widespread and abundant species with stable populations</td>
              <td class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">{consCounts['LC'] || 0}</td>
            </tr>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3"><span class="inline-flex items-center gap-1 rounded-full bg-conservation-nt/15 px-2 py-0.5 text-[10px] font-bold text-conservation-nt border border-conservation-nt/30">NT</span></td>
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">Near Threatened</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Species likely to become threatened in the near future</td>
              <td class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">{consCounts['NT'] || 0}</td>
            </tr>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3"><span class="inline-flex items-center gap-1 rounded-full bg-conservation-vu/15 px-2 py-0.5 text-[10px] font-bold text-conservation-vu border border-conservation-vu/30">VU</span></td>
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">Vulnerable</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Species facing a high risk of extinction in the wild</td>
              <td class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">{consCounts['VU'] || 0}</td>
            </tr>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3"><span class="inline-flex items-center gap-1 rounded-full bg-conservation-en/15 px-2 py-0.5 text-[10px] font-bold text-conservation-en border border-conservation-en/30">EN</span></td>
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">Endangered</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Species facing a very high risk of extinction in the wild</td>
              <td class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">{consCounts['EN'] || 0}</td>
            </tr>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3"><span class="inline-flex items-center gap-1 rounded-full bg-conservation-cr/15 px-2 py-0.5 text-[10px] font-bold text-conservation-cr border border-conservation-cr/30">CR</span></td>
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">Critically Endangered</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Species facing an extremely high risk of extinction</td>
              <td class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">{consCounts['CR'] || 0}</td>
            </tr>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3"><span class="inline-flex items-center gap-1 rounded-full bg-gray-400/15 px-2 py-0.5 text-[10px] font-bold text-gray-400 border border-gray-400/30">EW</span></td>
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">Extinct in the Wild</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Known only to survive in captivity or cultivation</td>
              <td class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">{consCounts['EW'] || 0}</td>
            </tr>
            <tr>
              <td class="px-4 py-3"><span class="inline-flex items-center gap-1 rounded-full bg-gray-500/15 px-2 py-0.5 text-[10px] font-bold text-gray-500 border border-gray-500/30">EX</span></td>
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">Extinct</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">No reasonable doubt that the last individual has died</td>
              <td class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">{consCounts['EX'] || 0}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Conservation Bar Chart -->
      <div class="rounded-2xl border border-hairline bg-canvas-elevated p-5 dark:border-[#333] dark:bg-[#1a1a1a]">
        <h3 class="mb-4 text-sm font-bold text-ink dark:text-[#ededed]">Conservation Status Distribution</h3>
        <div class="space-y-3">
          {Object.entries(consCounts).filter(([k]) => k !== 'DD').map(([status, count]) => {
            const pct = Math.round((count / totalAnimals) * 100);
            const colors = {
              LC: 'bg-conservation-lc', NT: 'bg-conservation-nt', VU: 'bg-conservation-vu',
              EN: 'bg-conservation-en', CR: 'bg-conservation-cr', EW: 'bg-gray-400', EX: 'bg-gray-500'
            };
            return (
              <div class="flex items-center gap-3">
                <span class="w-8 text-right text-xs font-bold text-muted">{status}</span>
                <div class="flex-1 h-6 rounded-full bg-hairline/50 overflow-hidden dark:bg-[#333]">
                  <div class={`h-full rounded-full ${colors[status] || 'bg-muted'} transition-all`} style={`width: ${pct}%`} />
                </div>
                <span class="w-16 text-right text-xs font-medium text-ink dark:text-[#ededed]">{count} ({pct}%)</span>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Section 2: Animal Kingdom Classification -->
    <section id="classification-chart" class="mb-14">
      <h2 class="mb-4 text-2xl font-bold text-ink dark:text-[#ededed]">Animal Kingdom Classification Chart</h2>
      <p class="mb-4 text-sm leading-relaxed text-body dark:text-[#a1a1a1]">
        The biological classification system organizes all living organisms into a hierarchical structure. Our random animal generator uses this taxonomy to categorize species, providing class, order, and family information for each animal in the database.
      </p>

      <!-- Classification Flowchart -->
      <div class="rounded-2xl border border-hairline bg-canvas-elevated p-6 dark:border-[#333] dark:bg-[#1a1a1a]">
        <h3 class="mb-5 text-sm font-bold uppercase tracking-wider text-muted text-center">Taxonomic Classification of Animals</h3>

        <!-- CSS Flowchart -->
        <div class="flex flex-col items-center gap-3">
          <!-- Kingdom -->
          <div class="rounded-xl bg-link/15 border border-link/30 px-6 py-3 text-center">
            <p class="text-[10px] uppercase tracking-wider text-link font-bold">Kingdom</p>
            <p class="text-sm font-bold text-ink dark:text-[#ededed]">Animalia</p>
          </div>
          <svg class="h-5 w-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>

          <!-- Phylum -->
          <div class="rounded-xl bg-violet/15 border border-violet/30 px-6 py-3 text-center">
            <p class="text-[10px] uppercase tracking-wider text-violet font-bold">Phylum</p>
            <p class="text-sm font-bold text-ink dark:text-[#ededed]">Chordata, Arthropoda, Mollusca, etc.</p>
          </div>
          <svg class="h-5 w-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>

          <!-- Class (horizontal row) -->
          <div class="w-full">
            <p class="mb-2 text-center text-[10px] uppercase tracking-wider text-pink font-bold">Class</p>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
              <div class="rounded-lg border border-hairline bg-canvas p-3 text-center dark:border-[#333] dark:bg-[#111]">
                <span class="text-xl">🦁</span>
                <p class="text-xs font-bold text-ink dark:text-[#ededed]">Mammalia</p>
                <p class="text-[10px] text-muted">Mammals</p>
              </div>
              <div class="rounded-lg border border-hairline bg-canvas p-3 text-center dark:border-[#333] dark:bg-[#111]">
                <span class="text-xl">🦅</span>
                <p class="text-xs font-bold text-ink dark:text-[#ededed]">Aves</p>
                <p class="text-[10px] text-muted">Birds</p>
              </div>
              <div class="rounded-lg border border-hairline bg-canvas p-3 text-center dark:border-[#333] dark:bg-[#111]">
                <span class="text-xl">🐊</span>
                <p class="text-xs font-bold text-ink dark:text-[#ededed]">Reptilia</p>
                <p class="text-[10px] text-muted">Reptiles</p>
              </div>
              <div class="rounded-lg border border-hairline bg-canvas p-3 text-center dark:border-[#333] dark:bg-[#111]">
                <span class="text-xl">🐸</span>
                <p class="text-xs font-bold text-ink dark:text-[#ededed]">Amphibia</p>
                <p class="text-[10px] text-muted">Amphibians</p>
              </div>
              <div class="rounded-lg border border-hairline bg-canvas p-3 text-center dark:border-[#333] dark:bg-[#111]">
                <span class="text-xl">🐟</span>
                <p class="text-xs font-bold text-ink dark:text-[#ededed]">Actinopterygii</p>
                <p class="text-[10px] text-muted">Bony Fish</p>
              </div>
              <div class="rounded-lg border border-hairline bg-canvas p-3 text-center dark:border-[#333] dark:bg-[#111]">
                <span class="text-xl">🦈</span>
                <p class="text-xs font-bold text-ink dark:text-[#ededed]">Chondrichthyes</p>
                <p class="text-[10px] text-muted">Cartilaginous Fish</p>
              </div>
              <div class="rounded-lg border border-hairline bg-canvas p-3 text-center dark:border-[#333] dark:bg-[#111]">
                <span class="text-xl">🐙</span>
                <p class="text-xs font-bold text-ink dark:text-[#ededed]">Insecta</p>
                <p class="text-[10px] text-muted">Insects</p>
              </div>
              <div class="rounded-lg border border-hairline bg-canvas p-3 text-center dark:border-[#333] dark:bg-[#111]">
                <span class="text-xl">🐋</span>
                <p class="text-xs font-bold text-ink dark:text-[#ededed]">Mammalia</p>
                <p class="text-[10px] text-muted">Cetaceans</p>
              </div>
            </div>
          </div>
          <svg class="h-5 w-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>

          <!-- Order -->
          <div class="rounded-xl bg-pink/15 border border-pink/30 px-6 py-3 text-center">
            <p class="text-[10px] uppercase tracking-wider text-pink font-bold">Order</p>
            <p class="text-sm font-bold text-ink dark:text-[#ededed]">Carnivora, Primates, Rodentia, etc.</p>
          </div>
          <svg class="h-5 w-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>

          <!-- Family -->
          <div class="rounded-xl bg-conservation-lc/15 border border-conservation-lc/30 px-6 py-3 text-center">
            <p class="text-[10px] uppercase tracking-wider text-conservation-lc font-bold">Family</p>
            <p class="text-sm font-bold text-ink dark:text-[#ededed]">Felidae, Canidae, Ursidae, etc.</p>
          </div>
          <svg class="h-5 w-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>

          <!-- Genus & Species -->
          <div class="flex gap-3">
            <div class="rounded-xl bg-conservation-nt/15 border border-conservation-nt/30 px-5 py-3 text-center">
              <p class="text-[10px] uppercase tracking-wider text-conservation-nt font-bold">Genus</p>
              <p class="text-sm font-bold text-ink dark:text-[#ededed]">Panthera, Canis, etc.</p>
            </div>
            <div class="rounded-xl bg-conservation-vu/15 border border-conservation-vu/30 px-5 py-3 text-center">
              <p class="text-[10px] uppercase tracking-wider text-conservation-vu font-bold">Species</p>
              <p class="text-sm font-bold text-ink dark:text-[#ededed]">P. leo, C. lupus, etc.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Category Breakdown -->
    <section id="category-breakdown" class="mb-14">
      <h2 class="mb-4 text-2xl font-bold text-ink dark:text-[#ededed]">Animal Categories Breakdown</h2>
      <p class="mb-4 text-sm leading-relaxed text-body dark:text-[#a1a1a1]">
        Our random animal generator covers {totalAnimals}+ animals across {categories.length} major categories. Each category represents a distinct group of animals with unique characteristics, habitats, and adaptations. Here is a detailed breakdown of our database.
      </p>

      <!-- Category Cards Grid -->
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { name: 'Mammal', icon: '🦁', desc: 'Warm-blooded, hair/fur, milk-producing' },
          { name: 'Bird', icon: '🦅', desc: 'Feathered, warm-blooded, egg-laying' },
          { name: 'Fish', icon: '🐟', desc: 'Aquatic, gills, cold-blooded' },
          { name: 'Reptile', icon: '🐊', desc: 'Scaled, cold-blooded, egg-laying' },
          { name: 'Amphibian', icon: '🐸', desc: 'Moist skin, dual life, cold-blooded' },
          { name: 'Insect', icon: '🦋', desc: 'Exoskeleton, six legs, wings' },
          { name: 'Marine', icon: '🐙', desc: 'Ocean-dwelling, diverse species' },
          { name: 'Extinct', icon: '🦤', desc: 'No longer living, historical records' },
        ].map(cat => (
          <div class="rounded-xl border border-hairline bg-canvas-elevated p-4 text-center transition-colors hover:border-hairline-soft dark:border-[#333] dark:bg-[#1a1a1a] dark:hover:border-[#444]">
            <div class="text-3xl mb-2">{cat.icon}</div>
            <h3 class="text-sm font-bold text-ink dark:text-[#ededed]">{cat.name}</h3>
            <p class="text-[10px] text-muted mt-1">{cat.desc}</p>
            <p class="mt-2 text-lg font-bold text-link">{catCounts[cat.name.toLowerCase()] || 0}</p>
            <p class="text-[10px] text-muted">animals</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 4: Habitat Distribution -->
    <section id="habitat-map" class="mb-14">
      <h2 class="mb-4 text-2xl font-bold text-ink dark:text-[#ededed]">Global Animal Habitat Distribution</h2>
      <p class="mb-4 text-sm leading-relaxed text-body dark:text-[#a1a1a1]">
        Animals have adapted to virtually every environment on Earth. Our random animal generator database includes species from diverse habitats, each presenting unique challenges and evolutionary adaptations.
      </p>

      <!-- Habitat Table -->
      <div class="overflow-x-auto rounded-2xl border border-hairline dark:border-[#333]">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-hairline bg-canvas-elevated dark:border-[#333] dark:bg-[#1a1a1a]">
              <th class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">Habitat Type</th>
              <th class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">Climate</th>
              <th class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">Key Adaptations</th>
              <th class="px-4 py-3 font-bold text-ink dark:text-[#ededed]">Example Species</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">🌲 Tropical Forest</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Hot, humid, rainy</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Camouflage, canopy climbing, bright colors</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Toucan, Jaguar, Poison Dart Frog</td>
            </tr>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">🏔️ Mountain</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Cold, low oxygen</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Thick fur, large lungs, strong claws</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Snow Leopard, Mountain Goat, Golden Eagle</td>
            </tr>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">🌊 Ocean</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Saltwater, deep pressure</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Streamlined body, sonar, bioluminescence</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Blue Whale, Octopus, Great White Shark</td>
            </tr>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">🏜️ Desert</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Extreme heat, arid</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Water conservation, burrowing, nocturnal</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Camel, Fennec Fox, Thorny Devil</td>
            </tr>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">🧊 Arctic</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Freezing, seasonal darkness</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Blubber, white camouflage, hibernation</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Polar Bear, Arctic Fox, Snowy Owl</td>
            </tr>
            <tr class="border-b border-hairline dark:border-[#333]">
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">🌿 Grassland</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Moderate rain, open plains</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Speed, herding, camouflage</td>
              <td class="px-4 py-3 text-body dark:text-[#a1a1a1]">Zebra, Cheetah, African Elephant</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-ink dark:text-[#ededed]">🌿 Freshwater</td>
