---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getTranslations, type Locale, brandNames, defaultImageAlts } from '../utils/i18n';
import aboutData from '../i18n/data/about-content.json';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale);
const c = (aboutData as any)[locale] || (aboutData as any).en;
const contactHref = locale === 'en' ? '/contact-us' : `/${locale}/contact-us`;
const canonical = locale === 'en' ? 'https://bestrandomanimalgenerator.com/about-us' : `https://bestrandomanimalgenerator.com/${locale}/about-us`;
---

<Layout title={`${t.about_us} | ${brandNames[locale]}`} description={c.meta_desc} canonical={canonical} locale={locale} pagePath="/about-us" imageAlt={defaultImageAlts[locale]}>
  <Navbar locale={locale} pagePath="/about-us" />

  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl dark:text-[#ededed]">{c.title}</h1>
      <p class="mx-auto mt-3 max-w-lg text-sm text-body sm:text-base dark:text-[#a1a1a1]">
        {c.subtitle}
      </p>
    </div>

    <div class="space-y-8">
      <section class="rounded-2xl border border-hairline bg-canvas-elevated p-6 dark:border-[#333] dark:bg-[#1a1a1a]">
        <h2 class="mb-3 text-lg font-semibold text-ink dark:text-[#ededed]">{c.story_title}</h2>
        <p class="text-sm text-body leading-relaxed dark:text-[#a1a1a1]">
          {c.story_desc}
        </p>
      </section>

      <section class="rounded-2xl border border-hairline bg-canvas-elevated p-6 dark:border-[#333] dark:bg-[#1a1a1a]">
        <h2 class="mb-3 text-lg font-semibold text-ink dark:text-[#ededed]">{c.mission_title}</h2>
        <p class="text-sm text-body leading-relaxed dark:text-[#a1a1a1]">
          {c.mission_desc}
        </p>
      </section>

      <section class="rounded-2xl border border-hairline bg-canvas-elevated p-6 dark:border-[#333] dark:bg-[#1a1a1a]">
        <h2 class="mb-3 text-lg font-semibold text-ink dark:text-[#ededed]">{c.offer_title}</h2>
        <ul class="space-y-3 text-sm text-body dark:text-[#a1a1a1]">
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-conservation-lc">&#10003;</span>
            <span><strong class="text-ink dark:text-[#ededed]">{c.offer_gen_title}</strong> &mdash; {c.offer_gen_desc}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-conservation-lc">&#10003;</span>
            <span><strong class="text-ink dark:text-[#ededed]">{c.offer_spinner_title}</strong> &mdash; {c.offer_spinner_desc}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-conservation-lc">&#10003;</span>
            <span><strong class="text-ink dark:text-[#ededed]">{c.offer_quiz_title}</strong> &mdash; {c.offer_quiz_desc}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-conservation-lc">&#10003;</span>
            <span><strong class="text-ink dark:text-[#ededed]">{c.offer_compare_title}</strong> &mdash; {c.offer_compare_desc}</span>
          </li>
        </ul>
      </section>

      <section class="rounded-2xl border border-hairline bg-canvas-elevated p-6 dark:border-[#333] dark:bg-[#1a1a1a]">
        <h2 class="mb-3 text-lg font-semibold text-ink dark:text-[#ededed]">{c.contact_title}</h2>
        <p class="text-sm text-body leading-relaxed dark:text-[#a1a1a1]">
          {c.contact_text_pre} <a href={contactHref} class="text-link underline underline-offset-2 transition-colors hover:text-link-deep">{c.contact_link}</a> {c.contact_text_post}
        </p>
      </section>
    </div>
  </main>

  <Footer locale={locale} />
</Layout>
