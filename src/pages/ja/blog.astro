---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import BlogContent from '../../components/BlogContent.astro';
import blogContent from '../../data/blog-content.json';
import { getTranslations } from '../../utils/i18n';

const locale = 'ja';
const t = getTranslations(locale);
const content = (blogContent as any)[locale] || (blogContent as any).en;

const SITE_URL = 'https://bestrandomanimalgenerator.com';
const canonical = `${SITE_URL}/${locale}/blog`;
---

<Layout title={`${content.title} | Random Animal Generator`} description={content.description} canonical={canonical} locale={locale} pagePath="/blog">
  <Navbar locale={locale} pagePath="/blog" />
  <BlogContent locale={locale} />
  <Footer locale={locale} />
</Layout>
