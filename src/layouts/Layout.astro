---
import { getTranslations, type Locale } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  locale?: string;
  dir?: string;
  pagePath?: string;
  noindex?: boolean;
}

const SITE_URL = 'https://bestrandomanimalgenerator.com';
const SITE_NAME = 'Best Random Animal Generator';

const {
  title = "Random Animal Generator – Free Online Tool with Pictures",
  description = "Free random animal generator with pictures, fun facts, habitat & conservation status. 1,000+ animals for drawing, kids, teachers & creative writing.",
  canonical,
  image = `${SITE_URL}/og-image.png`,
  imageAlt = "Random Animal Generator – free online tool showing a random animal with pictures, fun facts and conservation status",
  type = 'website',
  locale = 'en',
  dir = locale === 'ar' ? 'rtl' : 'ltr',
  pagePath = '',
  noindex = false,
} = Astro.props;

const baseTitle = title
  .replace(/\s*\|\s*Best Random Animal Generator/gi, '')
  .replace(/\s*\|\s*Random Animal Generator/gi, '')
  .trim();
const pageTitle = baseTitle
  ? (baseTitle.includes(SITE_NAME) ? baseTitle : `${baseTitle} | ${SITE_NAME}`)
  : SITE_NAME;
const allLocales = ['en', 'es', 'ja', 'fr', 'de', 'pt', 'ko', 'it', 'zh-CN', 'zh-TW', 'ar'];

// Normalize path with leading & trailing slash for 100% sitemap and server consistency
const cleanPath = pagePath && pagePath !== '/'
  ? `/${pagePath.replace(/^\/+|\/+$/g, '')}/`
  : '/';

function getUrlForLocale(loc: string) {
  if (loc === 'en') {
    return cleanPath === '/' ? `${SITE_URL}/` : `${SITE_URL}${cleanPath}`;
  }
  return cleanPath === '/' ? `${SITE_URL}/${loc}/` : `${SITE_URL}/${loc}${cleanPath}`;
}

const pageCanonical = canonical
  ? (canonical.endsWith('/') ? canonical : `${canonical}/`)
  : getUrlForLocale(locale);

const t = getTranslations(locale as Locale);
const isHomePage = cleanPath === '/';
const isBlogPage = cleanPath === '/blog/';
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0LV77ZZX3E" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0LV77ZZX3E');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <link rel="canonical" href={pageCanonical} />

    <!-- Hreflang Tags -->
    {allLocales.map(loc => (
      <link rel="alternate" hreflang={loc} href={getUrlForLocale(loc)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getUrlForLocale('en')} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageCanonical} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Additional SEO -->
    <meta name="author" content="Best Random Animal Generator" />
    <meta name="keywords" content="random animal generator, random animal generator for drawing, best random animal generator, random animal generator with pictures, name a random animal generator, random animal generator draw, a random animal generator, random animal generator for kids, random animal generator name, random animal generator art, unique random animal generator, random prehistoric animal generator, random aquatic animal generator, random extinct animal generator, random cute animal generator, random mythical animal generator, random fantasy animal generator, random farm animal generator" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="application-name" content={SITE_NAME} />

    <!-- Geo -->
    <meta name="geo.region" content="US" />
    <meta name="geo.placename" content="United States" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Random Animal Generator" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": SITE_NAME,
      "url": SITE_URL,
      "description": description,
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${SITE_URL}/?search={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    <!-- JSON-LD Structured Data: SoftwareApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": SITE_NAME,
      "operatingSystem": "Web Browser",
      "applicationCategory": "EducationalApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Free online random animal generator with pictures, fun facts, conservation status, spinner wheel, and quiz. Over 1,000 animals.",
      "url": SITE_URL,
      "screenshot": image,
      "featureList": [
        "Random animal generator with pictures and fun facts",
        "Random animal generator wheel (spinner)",
        "Random animal generator for drawing and art prompts",
        "Random animal generator for kids and classrooms",
        "Animal name generator with scientific names",
        "Category filters: mammals, birds, fish, reptiles, amphibians, insects, marine, farm, cute, prehistoric, mythical, fantasy",
        "Conservation status filters based on the IUCN Red List categories",
        "Animal quiz and side-by-side compare mode",
        "No-repeat mode for unique discoveries"
      ]
    })} />

    <!-- JSON-LD Structured Data: BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": isHomePage ? [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t.nav_home || "Home",
          "item": locale === 'en' ? `${SITE_URL}/` : `${SITE_URL}/${locale}/`
        }
      ] : [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t.nav_home || "Home",
          "item": locale === 'en' ? `${SITE_URL}/` : `${SITE_URL}/${locale}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": baseTitle || title,
          "item": pageCanonical
        }
      ]
    })} />

    <!-- JSON-LD Structured Data: Article (Rendered for Blog page) -->
    {isBlogPage && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": baseTitle || title,
        "description": description,
        "image": image,
        "inLanguage": locale,
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": pageCanonical
        },
        "publisher": {
          "@type": "Organization",
          "name": SITE_NAME,
          "url": SITE_URL,
          "logo": {
            "@type": "ImageObject",
            "url": `${SITE_URL}/favicon-96x96.png`
          }
        }
      })} />
    )}

    <!-- JSON-LD Structured Data: FAQPage (Rendered only on Homepage where FAQ is actually present, matching page locale) -->
    {isHomePage && t.faq_q1 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": t.faq_q1,
            "acceptedAnswer": { "@type": "Answer", "text": t.faq_a1 }
          },
          {
            "@type": "Question",
            "name": t.faq_q2,
            "acceptedAnswer": { "@type": "Answer", "text": t.faq_a2 }
          },
          {
            "@type": "Question",
            "name": t.faq_q3,
            "acceptedAnswer": { "@type": "Answer", "text": t.faq_a3 }
          },
          {
            "@type": "Question",
            "name": t.faq_q4,
            "acceptedAnswer": { "@type": "Answer", "text": t.faq_a4 }
          },
          {
            "@type": "Question",
            "name": t.faq_q5,
            "acceptedAnswer": { "@type": "Answer", "text": t.faq_a5 }
          },
          {
            "@type": "Question",
            "name": t.faq_q6,
            "acceptedAnswer": { "@type": "Answer", "text": t.faq_a6 }
          },
          {
            "@type": "Question",
            "name": t.faq_q7,
            "acceptedAnswer": { "@type": "Answer", "text": t.faq_a7 }
          }
        ]
      })} />
    )}

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (theme === 'dark' || (!theme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden bg-canvas text-ink antialiased dark:bg-[#0a0a0a] dark:text-[#ededed]">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
